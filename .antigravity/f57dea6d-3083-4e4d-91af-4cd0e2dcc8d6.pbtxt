    content: "import React, { useState } from \'react\';\nimport { AdminSubTab, SensorItem, ToolMappingItem, CategoryItem, IndustryTypeItem, ProtocolItem, PlantItem } from \'../../types\';\nimport { SensorTable } from \'./SensorTable\';\nimport { ToolMappingTable } from \'./ToolMappingTable\';\nimport { CategoryView } from \'./CategoryView\';\nimport { IndustryTypeView, ProtocolView, PlantView } from \'./OtherAdminViews\';\n\ninterface AdminManagementProps {\n  sensors: SensorItem[];\n  toolMappings: ToolMappingItem[];\n  categories: CategoryItem[];\n  industryTypes: IndustryTypeItem[];\n  protocols: ProtocolItem[];\n  plants: PlantItem[];\n  totalEquipmentCount: number;\n  onAddSensor: (sensor: SensorItem) => void;\n  onAddToolMapping: (mapping: ToolMappingItem) => void;\n  onAddCategory: (category: CategoryItem) => void;\n  onUpdateCategory: (category: CategoryItem) => void;\n  onDeleteCategory: (id: string) => void;\n  onAddPlant?: (plant: PlantItem) => void;\n}\n\nexport const AdminManagement: React.FC<AdminManagementProps> = ({\n  sensors,\n  toolMappings,\n  categories,\n  industryTypes,\n  protocols,\n  plants,\n  totalEquipmentCount,\n  onAddSensor,\n  onAddToolMapping,\n  onAddCategory,\n  onUpdateCategory,\n  onDeleteCategory,\n  onAddPlant,\n}) => {\n  const [activeSubTab, setActiveSubTab] = useState<AdminSubTab>(\'sensor\');\n\n  const subTabs: { id: AdminSubTab; label: string; count?: number }[] = [\n    { id: \'industry\', label: \'Industry Type\', count: industryTypes.length },\n    { id: \'sensor\', label: \'Sensor\', count: sensors.length },\n    { id: \'protocol\', label: \'Protocol\', count: protocols.length },\n    { id: \'category\', label: \'Category\', count: categories.length },\n    { id: \'plant\', label: \'Plant\', count: plants.length },\n    { id: \'tool-mapping\', label: \'Tool Mapping\', count: toolMappings.length },\n  ];\n\n  return (\n    <div id=\"admin-module\" className=\"space-y-6\">\n      \n      {/* Admin Navigation Sub-Tabs matching Image 1 & Image 7 */}\n      <div className=\"flex items-center gap-2 border-b border-[#121212]/15 dark:border-white/15 pb-0 overflow-x-auto\">\n        {subTabs.map((tab) => {\n          const isActive = activeSubTab === tab.id;\n          return (\n            <button\n              key={tab.id}\n              id={`admin-subtab-${tab.id}`}"
    raw_content: "import React, { useState } from \'react\';\nimport { AdminSubTab, SensorItem, ToolMappingItem, CategoryItem, IndustryTypeItem, ProtocolItem, PlantItem } from \'../../types\';\nimport { SensorTable } from \'./SensorTable\';\nimport { ToolMappingTable } from \'./ToolMappingTable\';\nimport { CategoryView } from \'./CategoryView\';\nimport { IndustryTypeView, ProtocolView, PlantView } from \'./OtherAdminViews\';\n\ninterface AdminManagementProps {\n  sensors: SensorItem[];\n  toolMappings: ToolMappingItem[];\n  categories: CategoryItem[];\n  industryTypes: IndustryTypeItem[];\n  protocols: ProtocolItem[];\n  plants: PlantItem[];\n  totalEquipmentCount: number;\n  onAddSensor: (sensor: SensorItem) => void;\n  onAddToolMapping: (mapping: ToolMappingItem) => void;\n  onAddCategory: (category: CategoryItem) => void;\n  onUpdateCategory: (category: CategoryItem) => void;\n  onDeleteCategory: (id: string) => void;\n  onAddPlant?: (plant: PlantItem) => void;\n}\n\nexport const AdminManagement: React.FC<AdminManagementProps> = ({\n  sensors,\n  toolMappings,\n  categories,\n  industryTypes,\n  protocols,\n  plants,\n  totalEquipmentCount,\n  onAddSensor,\n  onAddToolMapping,\n  onAddCategory,\n  onUpdateCategory,\n  onDeleteCategory,\n  onAddPlant,\n}) => {\n  const [activeSubTab, setActiveSubTab] = useState<AdminSubTab>(\'sensor\');\n\n  const subTabs: { id: AdminSubTab; label: string; count?: number }[] = [\n    { id: \'industry\', label: \'Industry Type\', count: industryTypes.length },\n    { id: \'sensor\', label: \'Sensor\', count: sensors.length },\n    { id: \'protocol\', label: \'Protocol\', count: protocols.length },\n    { id: \'category\', label: \'Category\', count: categories.length },\n    { id: \'plant\', label: \'Plant\', count: plants.length },\n    { id: \'tool-mapping\', label: \'Tool Mapping\', count: toolMappings.length },\n  ];\n\n  return (\n    <div id=\"admin-module\" className=\"space-y-6\">\n      \n      {/* Admin Navigation Sub-Tabs matching Image 1 & Image 7 */}\n      <div className=\"flex items-center gap-2 border-b border-[#121212]/15 dark:border-white/15 pb-0 overflow-x-auto\">\n        {subTabs.map((tab) => {\n          const isActive = activeSubTab === tab.id;\n          return (\n            <button\n              key={tab.id}\n              id={`admin-subtab-${tab.id}`}\n              onClick={() => setActiveSubTab(tab.id)}\n              className={`px-4 py-3 text-xs uppercase tracking-[0.14em] font-semibold whitespace-nowrap transition-all border-b-2 flex items-center gap-2 ${\n                isActive\n                  ? \'border-[#FF4D00] text-[#121212] dark:text-[#FDFCF5] font-bold\'\n                  : \'border-transparent text-[#121212]/50 hover:text-[#121212] dark:text-[#FDFCF5]/50 dark:hover:text-[#FDFCF5]\'\n              }`}\n            >\n              <span>{tab.label}</span>\n              {tab.count !== undefined && (\n                <span className={`px-1.5 py-0.5 text-[10px] font-mono font-bold ${\n                  isActive \n                    ? \'bg-[#FF4D00] text-white\' \n                    : \'bg-[#F4F2EA] dark:bg-stone-800 text-[#121212]/60 dark:text-[#FDFCF5]/60 border border-[#121212]/10 dark:border-white/10\'\n                }`}>\n                  {tab.count}\n                </span>\n              )}\n            </button>\n          );\n        })}\n      </div>\n\n      {/* Sub-tab Views */}\n      <div className=\"pt-1\">\n        {activeSubTab === \'sensor\' && (\n          <SensorTable \n            sensors={sensors}\n            onAddSensor={onAddSensor}\n          />\n        )}\n\n        {activeSubTab === \'tool-mapping\' && (\n          <ToolMappingTable \n            mappings={toolMappings}\n            onAddMapping={onAddToolMapping}\n            availableSensors={sensors}\n          />\n        )}\n\n        {activeSubTab === \'category\' && (\n          <CategoryView \n            categories={categories}\n            totalEquipmentCount={totalEquipmentCount}\n            onAddCategory={onAddCategory}\n            onUpdateCategory={onUpdateCategory}\n            onDeleteCategory={onDeleteCategory}\n            plants={plants}\n          />\n        )}\n\n        {activeSubTab === \'industry\' && (\n          <IndustryTypeView items={industryTypes} />\n        )}\n\n        {activeSubTab === \'protocol\' && (\n          <ProtocolView items={protocols} />\n        )}\n\n        {activeSubTab === \'plant\' && (\n          <PlantView items={plants} onAddPlant={onAddPlant} />\n        )}\n      </div>\n\n    </div>\n  );\n};\n"
    num_lines: 127
    num_bytes: 4390
  }
}
