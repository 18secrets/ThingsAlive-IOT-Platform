t INITIAL_PLANTS: PlantItem[] = [\n  { id: \'plt-1\', name: \'Lucknow Infrastructure Plant\', location: \'Lucknow, UP\', code: \'CCL-LKO\', equipmentCount: 9, activeLines: 4 },\n  { id: \'plt-2\', name: \'Pune Automotive Plant\', location: \'Pune, MH\', code: \'CCL-PUN\', equipmentCount: 6, activeLines: 3 },\n  { id: \'plt-3\', name: \'CBM Central Works\', location: \'Chanderiya, RJ\', code: \'CCL-CBM\', equipmentCount: 8, activeLines: 5 }\n];\n"
