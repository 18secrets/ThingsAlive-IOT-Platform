      original_chunk {
        target_content: "import React from \'react\';\nimport { \n  Home, \n  AlertTriangle, \n  Bell, \n  UserCheck, \n  Cpu, \n  Globe, \n  Users, \n  Wrench, \n  ShieldCheck, \n  ClipboardList, \n  Settings \n} from \'lucide-react\';\nimport { NavigationTab } from \'../types\';\n\ninterface SidebarProps {\n  currentTab: NavigationTab;\n  onSelectTab: (tab: NavigationTab) => void;\n}\n\nexport const Sidebar: React.FC<SidebarProps> = ({ currentTab, onSelectTab }) => {\n  const navItems: { id: NavigationTab; label: string; icon: React.FC<{ className?: string }> }[] = [\n    { id: \'dashboard\', label: \'Dashboard\', icon: Home },\n    { id: \'alert-rules\', label: \'Alert Rules\', icon: AlertTriangle },\n    { id: \'alert-agent\', label: \'Alert Agent\', icon: Bell },\n    { id: \'admin\', label: \'Admin\', icon: UserCheck },\n    { id: \'devices\', label: \'Devices\', icon: Cpu },\n    { id: \'vendors\', label: \'Vendors\', icon: Globe },\n    { id: \'users\', label: \'Users\', icon: Users },\n    { id: \'equipment\', label: \'Equipment\', icon: Wrench },\n    { id: \'administrator\', label: \'Administrator\', icon: ShieldCheck },\n    { id: \'diagnostics\', label: \'Diagnostics\', icon: ClipboardList },\n    { id: \'settings\', label: \'Settings\', icon: Settings },\n  ];\n\n  return (\n    <aside \n      id=\"main-navigation-sidebar\"\n      className=\"w-64 bg-[#FDFCF5] dark:bg-[#151514] border-r border-[#121212]/15 dark:border-white/15 flex flex-col justify-between shrink-0 select-none z-20 transition-colors\"\n      data-purpose=\"main-navigation-sidebar\"\n    >\n      <div>\n        {/* Brand Logo Header */}\n        <div className=\"h-20 flex items-center px-6 gap-3 border-b border-[#121212]/15 dark:border-white/15\">\n          {/* ThingsAlive Editorial Atom Emblem */}\n          <div className=\"relative flex items-center justify-center w-9 h-9 border border-[#121212] dark:border-white/40 bg-white dark:bg-[#1c1c1a] shrink-0\">\n            <div className=\"w-2 h-2 rounded-full bg-[#FF4D00]\"></div>\n            <div className=\"absolute top-1 left-1 w-1 h-1 bg-[#121212] dark:bg-white\"></div>\n            <div className=\"absolute bottom-1 right-1 w-1 h-1 bg-[#121212] dark:bg-white\"></div>\n            <div className=\"absolute top-1 right-1 w-1 h-1 bg-[#121212] dark:bg-white\"></div>\n            <div className=\"absolute bottom-1 left-1 w-1 h-1 bg-[#121212] dark:bg-white\"></div>\n          </div>\n          <div className=\"flex flex-col\">\n            <span className=\"font-serif text-xl font-bold tracking-tight text-[#121212] dark:text-[#FDFCF5] leading-none\">\n              Things<span className=\"italic text-[#FF4D00]\">Alive</span>\n            </span>\n            <span className=\"font-sans text-[9px] uppercase tracking-[0.25em] text-[#121212]/60 dark:text-[#FDFCF5]/60 font-bold mt-1\">\n              Telematics OS / 2026\n            </span>\n          </div>\n        </div>\n\n        {/* Navigation Links */}\n        <nav className=\"p-3 space-y-1.5 font-sans\">\n          {navItems.map((item, idx) => {\n            const Icon = item.icon;\n            const isActive = currentTab === item.id;\n            return (\n              <button\n                key={item.id}\n                id={`nav-${item.id}`}\n                onClick={() => onSelectTab(item.id)}\n                className={`w-full flex items-center justify-between px-3.5 py-2.5 text-xs uppercase tracking-[0.14em] font-semibold transition-all text-left border ${\n                  isActive\n                    ? \'bg-[#121212] text-[#FDFCF5] dark:bg-[#FDFCF5] dark:text-[#121212] border-[#121212] dark:border-white shadow-xs\'\n                    : \'border-transparent text-[#121212]/70 dark:text-[#FDFCF5]/70 hover:bg-[#EAE7E0] dark:hover:bg-stone-800 hover:text-[#121212] dark:hover:text-[#FDFCF5]\'\n                }`}\n              >\n                <div className=\"flex items-center gap-2.5\">\n                  <Icon \n                    className={`w-4 h-4 shrink-0 ${\n                      isActive ? \'text-[#FF4D00]\' : \'text-[#121212]/50 dark:text-[#FDFCF5]/50\'\n                    }`} \n                  />\n                  <span>{item.label}</span>\n                </div>\n                <span className={`text-[10px] font-mono ${isActive ? \'text-[#FF4D00]\' : \'opacity-30\'}`}>\n                  0{idx + 1}\n                </span>\n              </button>\n            );\n          })}\n        </nav>\n      </div>\n\n      {/* Version Footer */}\n      <div className=\"px-6 py-4 border-t border-[#121212]/15 dark:border-white/15 text-[10px] font-sans uppercase tracking-[0.2em] font-bold text-[#121212]/60 dark:text-[#FDFCF5]/60 flex items-center justify-between\">\n        <span>Vol. 1.0.5</span>\n        <div className=\"flex items-center gap-1.5\">\n          <span className=\"w-2 h-2 rounded-full bg-[#FF4D00] animate-pulse\"></span>\n          <span className=\"text-[9px] text-[#121212]/70 dark:text-[#FDFCF5]/70\">Live Bus</span>\n        </div>\n      </div>\n    </aside>\n  );\n};"
        replacement_content: "import React from \'react\';\nimport { \n  Home, \n  AlertTriangle, \n  Bell, \n  UserCheck, \n  Cpu, \n  Globe, \n  Users, \n  Wrench, \n  ShieldCheck, \n  ClipboardList, \n  Settings,\n  Network\n} from \'lucide-react\';\nimport { NavigationTab } from \'../types\';\n\ninterface SidebarProps {\n  currentTab: NavigationTab;\n  onSelectTab: (tab: NavigationTab) => void;\n}\n\nexport const Sidebar: React.FC<SidebarProps> = ({ currentTab, onSelectTab }) => {\n  const navItems: { id: NavigationTab; label: string; icon: React.FC<{ className?: string }> }[] = [\n    { id: \'dashboard\', label: \'Dashboard\', icon: Home },\n    { id: \'alert-rules\', label: \'Alert Rules\', icon: AlertTriangle },\n    { id: \'alert-agent\', label: \'Alert Agent\', icon: Bell },\n    { id: \'admin\', label: \'Admin\', icon: UserCheck },\n    { id: \'devices\', label: \'Devices\', icon: Cpu },\n    { id: \'vendors\', label: \'Vendors\', icon: Globe },\n    { id: \'users\', label: \'Users\', icon: Users },\n    { id: \'equipment\', label: \'Equipment\', icon: Wrench },\n    { id: \'administrator\', label: \'Administrator\', icon: ShieldCheck },\n    { id: \'diagnostics\', label: \'Diagnostics\', icon: ClipboardList },\n    { id: \'settings\', label: \'Settings\', icon: Settings },\n  ];\n\n  return (\n    <aside \n      id=\"main-navigation-sidebar\"\n      className=\"w-60 bg-white dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 flex flex-col justify-between shrink-0 select-none z-20 transition-colors\"\n      data-purpose=\"main-navigation-sidebar\"\n    >\n      <div>\n        {/* ThingsAlive Logo Header matching screenshot */}\n        <div className=\"h-16 flex items-center px-5 gap-2.5 border-b border-slate-100 dark:border-slate-800\">\n          <div className=\"relative flex items-center justify-center w-8 h-8 text-[#00A4BD]\">\n            <Network className=\"w-7 h-7 stroke-[2.2]\" />\n          </div>\n          <div className=\"flex items-center\">\n            <span className=\"text-lg font-semibold tracking-tight text-slate-800 dark:text-slate-100\">\n              Things<span className=\"font-normal text-slate-700 dark:text-slate-200\">Alive</span>\n            </span>\n          </div>\n        </div>\n\n        {/* Navigation Links matching screenshot */}\n        <nav className=\"p-3 space-y-1\">\n          {navItems.map((item) => {\n            const Icon = item.icon;\n            const isActive = currentTab === item.id;\n            return (\n              <button\n                key={item.id}\n                id={`nav-${item.id}`}\n                onClick={() => onSelectTab(item.id)}\n                className={`w-full flex items-center gap-3 px-3.5 py-2 text-sm rounded-lg font-medium transition-all text-left cursor-pointer ${\n                  isActive\n                    ? \'bg-sky-50 text-sky-600 dark:bg-sky-950/50 dark:text-sky-400 font-semibold\'\n                    : \'text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-slate-100\'\n                }`}\n              >\n                <Icon \n                  className={`w-4 h-4 shrink-0 ${\n                    isActive ? \'text-sky-600 dark:text-sky-400\' : \'text-slate-500 dark:text-slate-400\'\n                  }`} \n                />\n                <span>{item.label}</span>\n              </button>\n            );\n          })}\n        </nav>\n      </div>\n\n      {/* Version Footer matching screenshot */}\n      <div className=\"px-5 py-3 border-t border-slate-100 dark:border-slate-800 text-[11px] text-slate-400 dark:text-slate-500\">\n        <span>Version: 1.0.5</span>\n      </div>\n    </aside>\n  );\n};\n"
