Mode={isDarkMode}\\n          onToggleDarkMode={() => setIsDarkMode(!isDarkMode)}\\n        />\\n\\n        {/* Dynamic Page Views Container */}\\n        <main className=\\\"flex-1 overflow-y-auto p-6 md:p-8 bg-[#FDFCF5] dark:bg-[#121212]\\\">\",\"TargetFile\":\"/src/App.tsx\",\"toolAction\":\"Updating App.tsx background and selection styling\",\"toolSummary\":\"Update global theme colors in App.tsx\"}"
