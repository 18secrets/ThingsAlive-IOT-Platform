  file_change {
    absolute_path_uri: "file:///src/components/admin/SensorTable.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useMemo } from \'react\';\nimport { Search, Plus, Eye, Edit2, ChevronLeft, ChevronRight, Filter } from \'lucide-react\';\nimport { SensorItem } from \'../../types\';\nimport { AddSensorModal } from \'./AddSensorModal\';\nimport { SensorDetailModal } from \'./SensorDetailModal\';\n\ninterface SensorTableProps {\n  sensors: SensorItem[];\n  onAddSensor: (sensor: SensorItem) => void;\n  onUpdateSensor?: (sensor: SensorItem) => void;\n}\n\nexport const SensorTable: React.FC<SensorTableProps> = ({\n  sensors,\n  onAddSensor,\n  onUpdateSensor,\n}) => {\n  const [searchTerm, setSearchTerm] = useState(\'\');\n  const [selectedIndustry, setSelectedIndustry] = useState(\'All\');\n  const [currentPage, setCurrentPage] = useState(1);\n  const [rowsPerPage, setRowsPerPage] = useState(10);\n  const [isAddModalOpen, setIsAddModalOpen] = useState(false);\n  const [viewingSensor, setViewingSensor] = useState<SensorItem | null>(null);\n\n  // Industry options for filter\n  const industryOptions = useMemo(() => {\n    const list = Array.from(new Set(sensors.map((s) => s.industryType)));\n    return [\'All\', ...list];\n  }, [sensors]);\n\n  // Filtered sensors\n  const filteredSensors = useMemo(() => {\n    return sensors.filter((s) => {\n      const matchesSearch = \n        s.sensorName.toLowerCase().includes(searchTerm.toLowerCase()) ||\n        s.industryType.toLowerCase().includes(searchTerm.toLowerCase());\n      const matchesIndustry = selectedIndustry === \'All\' || s.industryType === selectedIndustry;\n      return matchesSearch && matchesIndustry;\n    });\n  }, [sensors, searchTerm, selectedIndustry]);\n\n  // Pagination calculation\n  const totalRows = filteredSensors.length;\n  const totalPages = Math.ceil(totalRows / rowsPerPage) || 1;\n  const startIndex = (currentPage - 1) * rowsPerPage;\n  const paginatedSensors = filteredSensors.slice(startIndex, startIndex + rowsPerPage);\n\n  return (\n    <div id=\"sensor-management-view\" className=\"space-y-4\">\n      {/* Top Filter & Action Bar */}\n      <div className=\"bg-white dark:bg-slate-800 rounded-xl p-4 border border-slate-200 dark:border-slate-700 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-3\">\n        \n        <div className=\"flex flex-1 items-center gap-3\">\n          {/* Search Input */}\n          <div className=\"relative flex-1 max-w-md\">\n            <Search className=\"w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2\" />\n            <input \n              type=\"text\" \n              value={searchTerm}\n              onChange={(e) => {\n                setSearchTerm(e.target.value);\n                setCurrentPage(1);\n              }}\n              placeholder=\"Search Sensor Names...\" \n              className=\"w-full pl-9 pr-4 py-2 bg-slate-50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 rounded-lg text-xs text-slate-800 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600\"\n            />\n          </div>\n\n          {/* Industry Type Filter */}\n          <div className=\"relative min-w-[200px]\">\n            <select\n              value={selectedIndustry}\n              onChange={(e) => {\n                setSelectedIndustry(e.target.value);\n                setCurrentPage(1);\n              }}\n              className=\"w-full py-2 px-3 text-xs bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded-lg text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 cursor-pointer\"\n            >\n              <option value=\"All\">Filter by Industry Type (All)</option>\n              {industryOptions.filter(i => i !== \'All\').map((ind) => (\n                <option key={ind} value={ind}>{ind}</option>\n              ))}\n            </select>\n          </div>\n        </div>\n\n        {/* Add Sensor Button */}\n        <button \n          id=\"add-sensor-btn\"\n          onClick={() => setIsAddModalOpen(true)}\n          className=\"px-4 py-2 bg-[#0077b6] hover:bg-[#023e8a] active:bg-[#03045e] text-white rounded-lg text-xs font-semibold shadow-xs flex items-center justify-center gap-1.5 transition-colors shrink-0\"\n        >\n          <Plus className=\"w-4 h-4\" />\n          <span>Add Sensor</span>\n        </button>\n      </div>\n\n      {/* Main Data Table */}\n      <div className=\"bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 shadow-xs overflow-hidden\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs\">\n            <thead className=\"bg-slate-50 dark:bg-slate-700/50 border-b border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 font-semibold uppercase tracking-wider\">\n              <tr>\n                <th className=\"py-3 px-4\">Industry Type</th>\n                <th className=\"py-3 px-4\">Sensor Name</th>\n                <th className=\"py-3 px-4\">Created At</th>\n                <th className=\"py-3 px-4\">Updated At</th>\n                <th className=\"py-3 px-4 text-center\">Action</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100 dark:divide-slate-700/60 font-medium\">\n              {paginatedSensors.length > 0 ? (\n                paginatedSensors.map((sensor) => (\n                  <tr \n                    key={sensor.id} \n                    className=\"hover:bg-sky-50/40 dark:hover:bg-slate-700/40 transition-colors\"\n                  >\n                    <td className=\"py-3.5 px-4 text-slate-800 dark:text-slate-200 font-semibold\">\n                      {sensor.industryType}\n                    </td>\n                    <td className=\"py-3.5 px-4\">\n                      <div className=\"flex items-center gap-2\">\n                        <span className=\"font-mono text-sky-700 dark:text-sky-300 bg-sky-50 dark:bg-sky-950/60 px-2 py-0.5 rounded border border-sky-100 dark:border-sky-900/60\">\n                          {sensor.sensorName}\n                        </span>\n                      </div>\n                    </td>\n                    <td className=\"py-3.5 px-4 text-slate-500 dark:text-slate-400\">\n                      {sensor.createdAt}\n                    </td>\n                    <td className=\"py-3.5 px-4 text-slate-500 dark:text-slate-400\">\n                      {sensor.updatedAt}\n                    </td>\n                    <td className=\"py-3.5 px-4\">\n                      <div className=\"flex items-center justify-center gap-2\">\n                        {/* View Eye */}\n                        <button\n                          onClick={() => setViewingSensor(sensor)}\n                          className=\"p-1.5 text-slate-500 hover:text-sky-600 hover:bg-sky-50 dark:hover:bg-slate-700 rounded-lg transition-colors\"\n                          title=\"View Sensor Details\"\n                        >\n                          <Eye className=\"w-4 h-4\" />\n                        </button>\n                        {/* Edit Pencil */}\n                        <button\n                          onClick={() => setViewingSensor(sensor)}\n                          className=\"p-1.5 text-slate-500 hover:text-amber-600 hover:bg-amber-50 dark:hover:bg-slate-700 rounded-lg transition-colors\"\n                          title=\"Edit Sensor Configuration\"\n                        >\n                          <Edit2 className=\"w-3.5 h-3.5\" />\n                        </button>\n                      </div>\n                    </td>\n                  </tr>\n                ))\n              ) : (\n                <tr>\n                  <td colSpan={5} className=\"py-8 text-center text-slate-400 dark:text-slate-500\">\n                    No sensors match your search filter.\n                  </td>\n                </tr>\n              )}\n            </tbody>\n          </table>\n        </div>\n\n        {/* Table Pagination Footer matching Image 1 */}\n        <div className=\"px-6 py-3.5 border-t border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/60 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500 dark:text-slate-400\">\n          <div>\n            Total Rows: <span className=\"font-semibold text-slate-700 dark:text-slate-200\">{totalRows}</span>\n          </div>\n\n          <div className=\"flex items-center gap-4\">\n            <div className=\"flex items-center gap-2\">\n              <span>Rows per page:</span>\n              <select\n                value={rowsPerPage}\n                onChange={(e) => {\n                  setRowsPerPage(Number(e.target.value));\n                  setCurrentPage(1);\n                }}\n                className=\"bg-white dark:bg-slate-700 border border-slate-200 dark:border-slate-600 rounded px-2 py-1 text-slate-700 dark:text-slate-200 text-xs focus:outline-none\"\n              >\n                <option value={10}>10</option>\n                <option value={20}>20</option>\n                <option value={50}>50</option>\n              </select>\n            </div>\n\n            <div className=\"flex items-center gap-1\">\n              <button\n                disabled={currentPage <= 1}\n                onClick={() => setCurrentPage((p) => Math.max(1, p - 1))}\n                className=\"p-1 rounded hover:bg-slate-200 dark:hover:bg-slate-700 disabled:opacity-40 disabled:cursor-not-allowed\"\n              >\n                <ChevronLeft className=\"w-4 h-4\" />\n              </button>\n\n              {Array.from({ length: totalPages }).map((_, i) => (\n                <button\n                  key={i}\n                  onClick={() => setCurrentPage(i + 1)}\n                  className={`w-6 h-6 rounded flex items-center justify-center font-medium ${\n                    currentPage === i + 1\n                      ? \'bg-[#0077b6] text-white\'\n                      : \'hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300\'\n                  }`}\n                >\n                  {i + 1}\n                </button>\n              ))}\n\n              <button\n                disabled={currentPage >= totalPages}\n                onClick={() => setCurrentPage((p) => Math.min(totalPages, p + 1))}\n                className=\"p-1 rounded hover:bg-slate-200 dark:hover:bg-slate-700 disabled:opacity-40 disabled:cursor-not-allowed\"\n              >\n                <ChevronRight className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Add Sensor Modal */}\n      <AddSensorModal \n        isOpen={isAddModalOpen}\n        onClose={() => setIsAddModalOpen(false)}\n        onSave={onAddSensor}\n        industryTypes={industryOptions.filter(i => i !== \'All\')}\n      />\n\n      {/* Sensor Detail Modal */}\n      <SensorDetailModal \n        sensor={viewingSensor}\n        onClose={() => setViewingSensor(null)}\n      />\n    </div>\n  );\n};\n"
    }
