    instruction: "Restyle AddEquipmentModal with ThingsAlive color theme and explicit pre-fill badges on Category, Engine Type and Fuel Tank"
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div \n      id=\"addEquipmentModalOverlay\"\n      className=\"fixed inset-0 bg-[#121212]/60 backdrop-blur-xs flex items-center justify-center p-4 z-50 animate-in fade-in duration-150\"\n    >\n      <div className=\"bg-[#FFFFFF] dark:bg-[#1A1918] shadow-2xl border border-[#121212]/20 dark:border-white/20 w-full max-w-3xl overflow-hidden flex flex-col max-h-[90vh] animate-in zoom-in-95 duration-150\">\n        \n        {/* Modal Header */}\n        <div className=\"px-6 py-4 border-b border-[#121212]/10 dark:border-white/10 flex items-center justify-between bg-[#FAF9F2] dark:bg-[#151514]\">\n          <div>\n            <div className=\"flex items-center gap-2.5\">\n              <h3 className=\"font-serif font-bold text-lg text-[#121212] dark:text-[#FDFCF5]\">\n                Add New Equipment Setup\n              </h3>\n              <span className=\"px-2 py-0.5 bg-[#FF4D00]/10 text-[#FF4D00] text-[10px] font-mono font-bold uppercase border border-[#FF4D00]/30\">\n                Admin Master Linked\n              </span>\n            </div>\n            <p className=\"text-[11px] text-[#121212]/60 dark:text-[#FDFCF5]/60 mt-0.5 font-sans\">\n              Category, Maintenance Plant, Tool Mapping, and Sensors are dynamically loaded from Admin.\n            </p>\n          </div>\n          <button \n            id=\"close-equipment-modal\"\n            onClick={onClose}\n            className=\"text-[#121212]/50 hover:text-[#FF4D00] dark:text-[#FDFCF5]/50 dark:hover:text-[#FF4D00] p-1.5 transition-colors cursor-pointer\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Modal Form */}\n        <form onSubmit={handleSubmit} className=\"p-6 overflow-y-auto space-y-5 text-xs font-sans\">\n          \n          {/* Admin Master Values Notice Banner */}\n          <div className=\"p-3 bg-[#FAF9F2] dark:bg-[#151514] border border-[#121212]/15 dark:border-white/15 flex items-center justify-between flex-wrap gap-2 text-[11px] font-mono text-[#121212]/80 dark:text-[#FDFCF5]/80\">\n            <div className=\"flex items-center gap-2\">\n              <Layers className=\"w-4 h-4 text-[#FF4D00]\" />\n              <span>Synced with Admin: <strong>{categories.length} Categories</strong> \342\200\242 <strong>{plants.length} Plants</strong> \342\200\242 <strong>{toolMappings.length} Tool Mappings</strong> \342\200\242 <strong>{sensors.length} Sensors</strong></span>\n            </div>\n            <span className=\"text-[10px] text-[#FF4D00] uppercase font-bold tracking-wider\">Live Bound</span>\n          </div>\n\n          {/* Row 1: Name & Description */}\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70 mb-1.5\">\n                Equipment Name <span className=\"text-[#FF4D00]\">*</span>\n              </label>\n              <input \n                type=\"text\" \n                required\n                value={name}\n                onChange={(e) => setName(e.target.value)}\n                placeholder=\"e.g. Komatsu PC210LC\" \n                className=\"w-full px-3 py-2 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] placeholder-[#121212]/40 dark:placeholder-[#FDFCF5]/40 focus:outline-none focus:border-[#FF4D00] transition-colors\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70 mb-1.5\">\n                Description <span className=\"text-[#FF4D00]\">*</span>\n              </label>\n              <input \n                type=\"text\" \n                required\n                value={description}\n                onChange={(e) => setDescription(e.target.value)}\n                placeholder=\"Equipment role & function\" \n                className=\"w-full px-3 py-2 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] placeholder-[#121212]/40 dark:placeholder-[#FDFCF5]/40 focus:outline-none focus:border-[#FF4D00] transition-colors\"\n              />\n            </div>\n          </div>\n\n          {/* Row 2: Category & Maintenance Plant (Strictly from Admin) */}\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div>\n              <div className=\"flex items-center justify-between mb-1.5\">\n                <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70\">\n                  Category (from Admin) <span className=\"text-[#FF4D00]\">*</span>\n                </label>\n                {currentSelectedCategory && (\n                  <span className=\"text-[10px] font-mono text-[#FF4D00] flex items-center gap-1\">\n                    <Sparkles className=\"w-3 h-3 text-[#FF4D00]\" />\n                    <span>Auto-fills: {currentSelectedCategory.engineType} \342\200\242 {currentSelectedCategory.fuelTankCapacityLiters}L</span>\n                  </span>\n                )}\n              </div>\n              <select \n                value={category}\n                onChange={(e) => handleCategoryChange(e.target.value)}\n                required\n                className=\"w-full px-3 py-2 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] font-serif focus:outline-none focus:border-[#FF4D00] cursor-pointer\"\n              >\n                {categoryItems.length === 0 ? (\n                  <option value=\"\">No categories defined in Admin</option>\n                ) : (\n                  categoryItems.map((cat) => (\n                    <option key={cat.id || cat.name} value={cat.name}>\n                      {cat.name} {cat.engineType ? `(${cat.engineType} \342\200\242 ${cat.fuelTankCapacityLiters}L Tank)` : \'\'}\n                    </option>\n                  ))\n                )}\n              </select>\n            </div>\n\n            <div>\n              <div className=\"flex items-center justify-between mb-1.5\">\n                <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70\">\n                  Maintenance Plant (from Admin) <span className=\"text-[#FF4D00]\">*</span>\n                </label>\n                <span className=\"text-[10px] font-mono text-[#FF4D00]\">Admin Only</span>\n              </div>\n              <select \n                value={maintPlant}\n                onChange={(e) => setMaintPlant(e.target.value)}\n                required\n                className=\"w-full px-3 py-2 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] font-serif focus:outline-none focus:border-[#FF4D00] cursor-pointer\"\n              >\n                {plants.length === 0 ? (\n                  <option value=\"\">No plants defined in Admin</option>\n                ) : (\n                  plants.map((p) => (\n                    <option key={p} value={p}>{p}</option>\n                  ))\n                )}\n              </select>\n            </div>\n          </div>\n\n          {/* Row 3: Tool Mapping & Protocol (Strictly from Admin Tool Mappings) */}\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div>\n              <div className=\"flex items-center justify-between mb-1.5\">\n                <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70\">\n                  Tool Mapping Profile (from Admin) <span className=\"text-[#FF4D00]\">*</span>\n                </label>\n                <span className=\"text-[10px] font-mono text-[#FF4D00]\">Admin Only</span>\n              </div>\n              <select \n                value={selectedToolMapping}\n                onChange={(e) => setSelectedToolMapping(e.target.value)}\n                className=\"w-full px-3 py-2 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] font-serif focus:outline-none focus:border-[#FF4D00] cursor-pointer\"\n              >\n                <option value=\"\">None / Custom Sensor Config</option>\n                {toolMappings.map((tm) => (\n                  <option key={tm.id} value={tm.toolName}>\n                    {tm.toolName} ({tm.identifier}) [{tm.protocol}]\n                  </option>\n                ))}\n              </select>\n            </div>\n\n            <div>\n              <div className=\"flex items-center justify-between mb-1.5\">\n                <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70\">\n                  Engine Type\n                </label>\n                {currentSelectedCategory?.engineType && (\n                  <span className=\"text-[9px] font-mono text-[#121212]/70 dark:text-[#FDFCF5]/70 bg-[#F4F2EA] dark:bg-[#151514] px-1.5 py-0.5 border border-[#121212]/15 dark:border-white/15\">\n                    Pre-filled from Category\n                  </span>\n                )}\n              </div>\n              <input \n                type=\"text\" \n                value={engineType}\n                onChange={(e) => setEngineType(e.target.value)}\n                placeholder=\"e.g. Diesel, Electric Drive\" \n                className=\"w-full px-3 py-2 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] placeholder-[#121212]/40 dark:placeholder-[#FDFCF5]/40 focus:outline-none focus:border-[#FF4D00] transition-colors\"\n              />\n            </div>\n          </div>\n\n          {/* Row 4: Telemetry Sensors (Strictly from Admin Sensors) */}\n          <div className=\"p-4 bg-[#FAF9F2] dark:bg-[#151514] border border-[#121212]/15 dark:border-white/15 space-y-3\">\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-2 text-xs font-serif font-bold text-[#121212] dark:text-[#FDFCF5]\">\n                <Activity className=\"w-4 h-4 text-[#FF4D00]\" />\n                <span>Assigned Telemetry Sensors (from Admin Sensors)</span>\n              </div>\n              <span className=\"px-2 py-0.5 text-[10px] font-mono bg-[#F4F2EA] dark:bg-stone-800 text-[#121212] dark:text-[#FDFCF5] border border-[#121212]/15 dark:border-white/15\">\n                {selectedSensors.length} of {sensors.length} Active\n              </span>\n            </div>\n            \n            <p className=\"text-[11px] text-[#121212]/60 dark:text-[#FDFCF5]/60 font-mono\">\n              Only sensors registered in the Admin Master Catalog are available here. Click any sensor chip to toggle:\n            </p>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2 pt-1 max-h-40 overflow-y-auto pr-1\">\n              {sensors.map((sensor) => {\n                const isSelected = selectedSensors.includes(sensor.sensorName);\n                return (\n                  <button\n                    key={sensor.id}\n                    type=\"button\"\n                    onClick={() => handleToggleSensor(sensor.sensorName)}\n                    className={`p-2 text-left border flex items-center justify-between transition-colors cursor-pointer ${\n                      isSelected\n                        ? \'bg-[#121212] text-white dark:bg-[#FDFCF5] dark:text-[#121212] border-[#121212] dark:border-white\'\n                        : \'bg-[#FFFFFF] dark:bg-[#1A1918] text-[#121212]/80 dark:text-[#FDFCF5]/80 border-[#121212]/15 dark:border-white/15 hover:border-[#FF4D00]\'\n                    }`}\n                  >\n                    <div className=\"min-w-0 pr-2\">\n                      <div className=\"font-serif font-bold text-xs truncate\" title={sensor.sensorName}>\n                        {sensor.sensorName}\n                      </div>\n                      <div className=\"text-[9px] font-mono opacity-70 truncate\">\n                        {sensor.industryType}\n                      </div>\n                    </div>\n                    {isSelected ? (\n                      <Check className=\"w-3.5 h-3.5 text-[#FF4D00] shrink-0\" />\n                    ) : (\n                      <span className=\"w-3.5 h-3.5 border border-current opacity-30 shrink-0 inline-block\" />\n                    )}\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Row 5: CCL Number, License Plate, Manufacturer, Model */}\n          <div className=\"grid grid-cols-1 md:grid-cols-4 gap-3\">\n            <div>\n              <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70 mb-1.5\">\n                CCL Number <span className=\"text-[#FF4D00]\">*</span>\n              </label>\n              <input \n                type=\"text\" \n                required\n                value={cclNumber}\n                onChange={(e) => setCclNumber(e.target.value)}\n                placeholder=\"e.g. CCL-LKO-009\" \n                className=\"w-full px-3 py-2 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] font-mono focus:outline-none focus:border-[#FF4D00]\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70 mb-1.5\">\n                License Plate\n              </label>\n              <input \n                type=\"text\" \n                value={licensePlate}\n                onChange={(e) => setLicensePlate(e.target.value)}\n                placeholder=\"e.g. UP32CE9136\" \n                className=\"w-full px-3 py-2 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] font-mono focus:outline-none focus:border-[#FF4D00]\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70 mb-1.5\">\n                Manufacturer\n              </label>\n              <input \n                type=\"text\" \n                value={manufacturer}\n                onChange={(e) => setManufacturer(e.target.value)}\n                placeholder=\"e.g. Komatsu, Volvo\" \n                className=\"w-full px-3 py-2 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] focus:outline-none focus:border-[#FF4D00]\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70 mb-1.5\">\n                Model Number\n              </label>\n              <input \n                type=\"text\" \n                value={modelNumber}\n                onChange={(e) => setModelNumber(e.target.value)}\n                placeholder=\"e.g. EC210\" \n                className=\"w-full px-3 py-2 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] focus:outline-none focus:border-[#FF4D00]\"\n              />\n            </div>\n          </div>\n\n          {/* Row 6: Part No, Serial No, Benchmark, Fuel Capacity */}\n          <div className=\"grid grid-cols-1 md:grid-cols-4 gap-3\">\n            <div>\n              <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70 mb-1.5\">\n                Manufacturer Part No\n              </label>\n              <input \n                type=\"text\" \n                value={partNo}\n                onChange={(e) => setPartNo(e.target.value)}\n                placeholder=\"e.g. PN-9948\" \n                className=\"w-full px-3 py-2 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] focus:outline-none focus:border-[#FF4D00]\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70 mb-1.5\">\n                Serial No\n              </label>\n              <input \n                type=\"text\" \n                value={serialNo}\n                onChange={(e) => setSerialNo(e.target.value)}\n                placeholder=\"e.g. SER-4920\" \n                className=\"w-full px-3 py-2 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] font-mono focus:outline-none focus:border-[#FF4D00]\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70 mb-1.5\">\n                Engine Power\n              </label>\n              <input \n                type=\"text\" \n                value={enginePower}\n                onChange={(e) => setEnginePower(e.target.value)}\n                placeholder=\"e.g. 150 kW\" \n                className=\"w-full px-3 py-2 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] focus:outline-none focus:border-[#FF4D00]\"\n              />\n            </div>\n\n            <div>\n              <div className=\"flex items-center justify-between mb-1.5\">\n                <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70\">\n                  Fuel Tank (L)\n                </label>\n                {currentSelectedCategory?.fuelTankCapacityLiters !== undefined && (\n                  <span className=\"text-[9px] font-mono text-[#121212]/70 dark:text-[#FDFCF5]/70 bg-[#F4F2EA] dark:bg-[#151514] px-1.5 py-0.5 border border-[#121212]/15 dark:border-white/15\">\n                    Pre-filled ({currentSelectedCategory.fuelTankCapacityLiters}L)\n                  </span>\n                )}\n              </div>\n              <input \n                type=\"number\" \n                value={fuelCapacity}\n                onChange={(e) => setFuelCapacity(e.target.value)}\n                placeholder=\"e.g. 400\" \n                className=\"w-full px-3 py-2 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] focus:outline-none focus:border-[#FF4D00]\"\n              />\n            </div>\n          </div>\n\n          {/* Action Buttons in Artistic Flair */}\n          <div className=\"pt-4 border-t border-[#121212]/10 dark:border-white/10 flex items-center justify-end gap-3\">\n            <button \n              type=\"button\"\n              onClick={onClose}\n              className=\"px-5 py-2.5 border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] text-xs font-sans uppercase tracking-[0.14em] font-bold hover:bg-[#F4F2EA] dark:hover:bg-stone-800 transition-colors cursor-pointer\"\n            >\n              Cancel\n            </button>\n            <button \n              type=\"submit\"\n              className=\"px-6 py-2.5 bg-[#121212] text-[#FDFCF5] hover:bg-[#FF4D00] hover:text-white dark:bg-[#FDFCF5] dark:text-[#121212] dark:hover:bg-[#FF4D00] dark:hover:text-white border border-[#121212] dark:border-white text-xs font-sans uppercase tracking-[0.14em] font-bold shadow-xs transition-colors cursor-pointer\"\n            >\n              Confirm Setup\n            </button>\n          </div>\n\n        </form>\n\n      </div>\n    </div>\n  );"
        replacement_content: "  return (\n    <div \n      id=\"addEquipmentModalOverlay\"\n      className=\"fixed inset-0 bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-4 z-50 animate-in fade-in duration-150\"\n    >\n      <div className=\"bg-white dark:bg-slate-900 rounded-xl shadow-2xl border border-slate-200 dark:border-slate-800 w-full max-w-3xl overflow-hidden flex flex-col max-h-[90vh] animate-in zoom-in-95 duration-150\">\n        \n        {/* Modal Header */}\n        <div className=\"px-6 py-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between bg-slate-50/60 dark:bg-slate-800/40\">\n          <div>\n            <div className=\"flex items-center gap-2.5\">\n              <h3 className=\"font-semibold text-base text-slate-800 dark:text-slate-100\">\n                Add New Equipment Setup\n              </h3>\n              <span className=\"px-2.5 py-0.5 bg-sky-50 text-sky-700 dark:bg-sky-950/60 dark:text-sky-300 text-xs font-medium rounded border border-sky-200 dark:border-sky-800\">\n                Admin Master Linked\n              </span>\n            </div>\n            <p className=\"text-xs text-slate-500 dark:text-slate-400 mt-0.5 font-sans\">\n              Selecting a Category automatically pre-fills the Engine Type and Fuel Tank Capacity configured in Admin.\n            </p>\n          </div>\n          <button \n            id=\"close-equipment-modal\"\n            onClick={onClose}\n            className=\"text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors cursor-pointer\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Modal Form */}\n        <form onSubmit={handleSubmit} className=\"p-6 overflow-y-auto space-y-5 text-sm font-sans\">\n          \n          {/* Admin Master Values Notice Banner */}\n          <div className=\"p-3 bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-800 rounded-lg flex items-center justify-between flex-wrap gap-2 text-xs text-slate-600 dark:text-slate-400\">\n            <div className=\"flex items-center gap-2\">\n              <Layers className=\"w-4 h-4 text-sky-600\" />\n              <span>Synced with Admin: <strong className=\"text-slate-800 dark:text-slate-200\">{categories.length} Categories</strong> \342\200\242 <strong className=\"text-slate-800 dark:text-slate-200\">{plants.length} Plants</strong> \342\200\242 <strong className=\"text-slate-800 dark:text-slate-200\">{toolMappings.length} Tool Mappings</strong></span>\n            </div>\n            <span className=\"text-xs text-sky-600 dark:text-sky-400 font-medium\">Live Bound</span>\n          </div>\n\n          {/* Row 1: Name & Description */}\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5\">\n                Equipment Name <span className=\"text-rose-500\">*</span>\n              </label>\n              <input \n                type=\"text\" \n                required\n                value={name}\n                onChange={(e) => setName(e.target.value)}\n                placeholder=\"e.g. Komatsu PC210LC\" \n                className=\"w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-colors\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5\">\n                Description <span className=\"text-rose-500\">*</span>\n              </label>\n              <input \n                type=\"text\" \n                required\n                value={description}\n                onChange={(e) => setDescription(e.target.value)}\n                placeholder=\"Equipment role & function\" \n                className=\"w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-colors\"\n              />\n            </div>\n          </div>\n\n          {/* Row 2: Category & Maintenance Plant (Strictly from Admin) */}\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div>\n              <div className=\"flex items-center justify-between mb-1.5\">\n                <label className=\"block text-xs font-medium text-slate-700 dark:text-slate-300\">\n                  Category (from Admin) <span className=\"text-rose-500\">*</span>\n                </label>\n                {currentSelectedCategory && (\n                  <span className=\"text-xs text-sky-600 dark:text-sky-400 flex items-center gap-1 font-medium\">\n                    <Sparkles className=\"w-3 h-3 text-sky-500\" />\n                    <span>Auto-fills Engine & Tank</span>\n                  </span>\n                )}\n              </div>\n              <select \n                value={category}\n                onChange={(e) => handleCategoryChange(e.target.value)}\n                required\n                className=\"w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-100 focus:outline-none focus:border-sky-500 cursor-pointer\"\n              >\n                {categoryItems.length === 0 ? (\n                  <option value=\"\">No categories defined in Admin</option>\n                ) : (\n                  categoryItems.map((cat) => (\n                    <option key={cat.id || cat.name} value={cat.name}>\n                      {cat.name} {cat.engineType ? `(${cat.engineType} \342\200\242 ${cat.fuelTankCapacityLiters}L)` : \'\'}\n                    </option>\n                  ))\n                )}\n              </select>\n              {currentSelectedCategory && (\n                <div className=\"mt-1.5 flex items-center gap-1.5 text-[11px] text-slate-500 dark:text-slate-400\">\n                  <span className=\"inline-block w-1.5 h-1.5 rounded-full bg-emerald-500\"></span>\n                  <span>Configured in Admin: <strong>{currentSelectedCategory.engineType || \'Standard\'}</strong>, <strong>{currentSelectedCategory.fuelTankCapacityLiters}L</strong> tank</span>\n                </div>\n              )}\n            </div>\n\n            <div>\n              <div className=\"flex items-center justify-between mb-1.5\">\n                <label className=\"block text-xs font-medium text-slate-700 dark:text-slate-300\">\n                  Maintenance Plant (from Admin) <span className=\"text-rose-500\">*</span>\n                </label>\n                <span className=\"text-[11px] text-sky-600 font-medium\">Admin Only</span>\n              </div>\n              <select \n                value={maintPlant}\n                onChange={(e) => setMaintPlant(e.target.value)}\n                required\n                className=\"w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-100 focus:outline-none focus:border-sky-500 cursor-pointer\"\n              >\n                {plants.length === 0 ? (\n                  <option value=\"\">No plants defined in Admin</option>\n                ) : (\n                  plants.map((p) => (\n                    <option key={p} value={p}>{p}</option>\n                  ))\n                )}\n              </select>\n            </div>\n          </div>\n\n          {/* Row 3: Tool Mapping & Engine Type (Auto-filled from Category) */}\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div>\n              <div className=\"flex items-center justify-between mb-1.5\">\n                <label className=\"block text-xs font-medium text-slate-700 dark:text-slate-300\">\n                  Tool Mapping Profile (from Admin) <span className=\"text-rose-500\">*</span>\n                </label>\n                <span className=\"text-[11px] text-sky-600 font-medium\">Admin Only</span>\n              </div>\n              <select \n                value={selectedToolMapping}\n                onChange={(e) => setSelectedToolMapping(e.target.value)}\n                className=\"w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-100 focus:outline-none focus:border-sky-500 cursor-pointer\"\n              >\n                <option value=\"\">None / Custom Sensor Config</option>\n                {toolMappings.map((tm) => (\n                  <option key={tm.id} value={tm.toolName}>\n                    {tm.toolName} ({tm.identifier}) [{tm.protocol}]\n                  </option>\n                ))}\n              </select>\n            </div>\n\n            {/* Engine Type: Pre-filled from selected Category */}\n            <div>\n              <div className=\"flex items-center justify-between mb-1.5\">\n                <label className=\"block text-xs font-medium text-slate-700 dark:text-slate-300\">\n                  Engine Type\n                </label>\n                <span className=\"text-[11px] font-medium text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/50 px-2 py-0.5 rounded border border-emerald-200 dark:border-emerald-800 flex items-center gap-1\">\n                  <Check className=\"w-3 h-3 text-emerald-600\" />\n                  <span>Pre-filled from Category</span>\n                </span>\n              </div>\n              <input \n                type=\"text\" \n                value={engineType}\n                onChange={(e) => setEngineType(e.target.value)}\n                placeholder=\"e.g. Diesel, Electric Drive\" \n                className={`w-full px-3 py-2 rounded-lg border text-slate-800 dark:text-slate-100 placeholder-slate-400 focus:outline-none transition-all ${\n                  justAutoFilled \n                    ? \'bg-emerald-50/60 dark:bg-emerald-950/30 border-emerald-400 ring-2 ring-emerald-400/30\' \n                    : \'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-700 focus:border-sky-500 focus:ring-1 focus:ring-sky-500\'\n                }`}\n              />\n            </div>\n          </div>\n\n          {/* Row 4: Telemetry Sensors (Strictly from Admin Sensors) */}\n          <div className=\"p-4 bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-800 rounded-lg space-y-3\">\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-2 text-xs font-semibold text-slate-800 dark:text-slate-200\">\n                <Activity className=\"w-4 h-4 text-sky-600\" />\n                <span>Assigned Telemetry Sensors (from Admin Sensors)</span>\n              </div>\n              <span className=\"px-2.5 py-0.5 text-xs bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 rounded border border-slate-200 dark:border-slate-700 font-medium\">\n                {selectedSensors.length} of {sensors.length} Active\n              </span>\n            </div>\n            \n            <p className=\"text-xs text-slate-500 dark:text-slate-400\">\n              Only sensors registered in the Admin Master Catalog are available here. Click any sensor chip to toggle:\n            </p>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2 pt-1 max-h-40 overflow-y-auto pr-1\">\n              {sensors.map((sensor) => {\n                const isSelected = selectedSensors.includes(sensor.sensorName);\n                return (\n                  <button\n                    key={sensor.id}\n                    type=\"button\"\n                    onClick={() => handleToggleSensor(sensor.sensorName)}\n                    className={`p-2.5 rounded-lg text-left border flex items-center justify-between transition-colors cursor-pointer ${\n                      isSelected\n                        ? \'bg-sky-50 dark:bg-sky-950/40 text-sky-800 dark:text-sky-200 border-sky-300 dark:border-sky-700 font-medium\'\n                        : \'bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-slate-800 hover:border-slate-300\'\n                    }`}\n                  >\n                    <div className=\"min-w-0 pr-2\">\n                      <div className=\"text-xs truncate font-medium\" title={sensor.sensorName}>\n                        {sensor.sensorName}\n                      </div>\n                      <div className=\"text-[10px] text-slate-400 truncate\">\n                        {sensor.industryType}\n                      </div>\n                    </div>\n                    {isSelected ? (\n                      <Check className=\"w-4 h-4 text-sky-600 shrink-0\" />\n                    ) : (\n                      <span className=\"w-4 h-4 rounded border border-slate-300 dark:border-slate-600 shrink-0 inline-block\" />\n                    )}\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Row 5: CCL Number, License Plate, Manufacturer, Model */}\n          <div className=\"grid grid-cols-1 md:grid-cols-4 gap-3\">\n            <div>\n              <label className=\"block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5\">\n                CCL Number <span className=\"text-rose-500\">*</span>\n              </label>\n              <input \n                type=\"text\" \n                required\n                value={cclNumber}\n                onChange={(e) => setCclNumber(e.target.value)}\n                placeholder=\"e.g. CCL-LKO-009\" \n                className=\"w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-100 font-mono text-xs focus:outline-none focus:border-sky-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5\">\n                License Plate\n              </label>\n              <input \n                type=\"text\" \n                value={licensePlate}\n                onChange={(e) => setLicensePlate(e.target.value)}\n                placeholder=\"e.g. UP32CE9136\" \n                className=\"w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-100 font-mono text-xs focus:outline-none focus:border-sky-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5\">\n                Manufacturer\n              </label>\n              <input \n                type=\"text\" \n                value={manufacturer}\n                onChange={(e) => setManufacturer(e.target.value)}\n                placeholder=\"e.g. Komatsu, Volvo\" \n                className=\"w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-100 text-xs focus:outline-none focus:border-sky-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5\">\n                Model Number\n              </label>\n              <input \n                type=\"text\" \n                value={modelNumber}\n                onChange={(e) => setModelNumber(e.target.value)}\n                placeholder=\"e.g. EC210\" \n                className=\"w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-100 text-xs focus:outline-none focus:border-sky-500\"\n              />\n            </div>\n          </div>\n\n          {/* Row 6: Part No, Serial No, Engine Power, Fuel Tank (L) */}\n          <div className=\"grid grid-cols-1 md:grid-cols-4 gap-3\">\n            <div>\n              <label className=\"block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5\">\n                Manufacturer Part No\n              </label>\n              <input \n                type=\"text\" \n                value={partNo}\n                onChange={(e) => setPartNo(e.target.value)}\n                placeholder=\"e.g. PN-9948\" \n                className=\"w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-100 text-xs focus:outline-none focus:border-sky-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5\">\n                Serial No\n              </label>\n              <input \n                type=\"text\" \n                value={serialNo}\n                onChange={(e) => setSerialNo(e.target.value)}\n                placeholder=\"e.g. SER-4920\" \n                className=\"w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-100 font-mono text-xs focus:outline-none focus:border-sky-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1.5\">\n                Engine Power\n              </label>\n              <input \n                type=\"text\" \n                value={enginePower}\n                onChange={(e) => setEnginePower(e.target.value)}\n                placeholder=\"e.g. 150 kW\" \n                className=\"w-full px-3 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-800 dark:text-slate-100 text-xs focus:outline-none focus:border-sky-500\"\n              />\n            </div>\n\n            {/* Fuel Tank Capacity: Pre-filled from selected Category */}\n            <div>\n              <div className=\"flex items-center justify-between mb-1.5\">\n                <label className=\"block text-xs font-medium text-slate-700 dark:text-slate-300\">\n                  Fuel Tank (L)\n                </label>\n                <span className=\"text-[11px] font-medium text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/50 px-1.5 py-0.5 rounded border border-emerald-200 dark:border-emerald-800 flex items-center gap-1\">\n                  <Check className=\"w-3 h-3 text-emerald-600\" />\n                  <span>Pre-filled</span>\n                </span>\n              </div>\n              <input \n                type=\"number\" \n                value={fuelCapacity}\n                onChange={(e) => setFuelCapacity(e.target.value)}\n                placeholder=\"e.g. 400\" \n                className={`w-full px-3 py-2 rounded-lg border text-slate-800 dark:text-slate-100 text-xs focus:outline-none transition-all ${\n                  justAutoFilled \n                    ? \'bg-emerald-50/60 dark:bg-emerald-950/30 border-emerald-400 ring-2 ring-emerald-400/30\' \n                    : \'bg-white dark:bg-slate-900 border-slate-200 dark:border-slate-700 focus:border-sky-500 focus:ring-1 focus:ring-sky-500\'\n                }`}\n              />\n            </div>\n          </div>\n\n          {/* Action Buttons in ThingsAlive Theme */}\n          <div className=\"pt-4 border-t border-slate-200 dark:border-slate-800 flex items-center justify-end gap-3\">\n            <button \n              type=\"button\"\n              onClick={onClose}\n              className=\"px-4 py-2 border border-slate-200 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 text-sm font-medium hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors cursor-pointer\"\n            >\n              Cancel\n            </button>\n            <button \n              type=\"submit\"\n              className=\"px-5 py-2 bg-[#0B7285] hover:bg-[#095C6B] text-white rounded-lg text-sm font-medium shadow-xs transition-colors cursor-pointer\"\n            >\n              Confirm Setup\n            </button>\n          </div>\n\n        </form>\n\n      </div>\n    </div>\n  );"
      }
      num_matches: 1
    }
  }
}
