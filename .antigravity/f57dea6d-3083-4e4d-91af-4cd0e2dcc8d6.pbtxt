  <div className=\"text-2xl font-bold text-slate-900 dark:text-white mt-1\">\n              {inactiveEquipmentCount}\n            </div>\n          </div>\n          <div className=\"w-11 h-11 rounded-xl bg-rose-50 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 flex items-center justify-center\">\n            <AlertCircle className=\"w-6 h-6\" />\n          </div>\n        </div>\n      </div>\n\n      {/* Search & Add Action Bar */}\n      <div className=\"bg-white dark:bg-slate-800 rounded-xl p-4 border border-slate-200 dark:border-slate-700 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-3\">\n        <div className=\"relative flex-1 w-full sm:max-w-md\">\n          <Search className=\"w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2\" />\n          <input \n            type=\"text\" \n            value={searchTerm}\n            onChange={(e) => setSearchTerm(e.target.value)}\n            placeholder=\"Search Category Names, Codes, or Specs...\" \n            className=\"w-full pl-9 pr-4 py-2 bg-slate-50 dark:bg-slate-700/50 border border-slate-200 dark:border-slate-600 rounded-lg text-xs text-slate-800 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600\"\n          />\n        </div>\n\n        <button \n          id=\"add-category-btn\"\n          onClick={() => {\n            setEditingCategory(null);\n            setIsModalOpen(true);\n          }}\n          className=\"w-full sm:w-auto px-5 py-2.5 bg-[#0077b6] hover:bg-[#023e8a] active:bg-[#03045e] text-white rounded-xl text-xs font-semibold shadow-xs flex items-center justify-center gap-1.5 transition-colors shrink-0\"\n        >\n          <Plus className=\"w-4 h-4\" />\n          <span>Add Category</span>\n        </button>\n      </div>\n\n      {/* Category Cards Grid matching Image 7 */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n        {filteredCategories.map((cat) => (\n          <div \n            key={cat.id}\n            className=\"bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-5 shadow-xs flex flex-col justify-between hover:border-sky-300 dark:hover:border-sky-700 transition-all space-y-4\"\n          >\n            {/* Card Header */}\n            <div>\n              <div className=\"flex items-center justify-between mb-2\">\n                <span className=\"font-mono text-xs font-semibold text-[#0077b6] dark:text-sky-400 bg-sky-50 dark:bg-sky-950/80 px-2 py-0.5 rounded border border-sky-100 dark:border-sky-900/60\">\n                  #{cat.code}\n                </span>\n\n                <div className=\"flex items-center gap-1.5\">\n                  {/* Status Toggle Switch */}\n                  <button\n                    onClick={() => handleToggleActive(cat)}\n                    className={`relative inline-flex h-5 w-9 items-center rounded-full transition-colors focus:outline-none ${\n                      cat.active ? \'bg-sky-600\' : \'bg-slate-300 dark:bg-slate-600\'\n                    }`}\n                    title={cat.active ? \'Active\' : \'Inactive\'}\n                  >\n                    <span\n                      className={`inline-block h-3.5 w-3.5 transform rounded-full bg-white transition-transform ${\n                        cat.active ? \'translate-x-4.5\' : \'translate-x-1\'\n                      }`}\n                    />\n                  </button>\n\n                  {/* Edit Button */}\n                  <button\n                    onClick={() => {\n                      setEditingCategory(cat);\n                      setIsModalOpen(true);\n                    }}\n                    className=\"p-1.5 text-slate-400 hover:text-sky-600 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg transition-colors\"\n                    title=\"Edit Category\"\n                  >\n                    <Edit2 className=\"w-3.5 h-3.5\" />\n                  </button>\n\n                  {/* Delete Button */}\n                  <button\n                    onClick={() => onDeleteCategory(cat.id)}\n                    className=\"p-1.5 text-slate-400 hover:text-rose-600 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg transition-colors\"\n                    title=\"Delete Category\"\n                  >\n                    <Trash2 className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n              </div>\n\n              <h4 className=\"font-bold text-slate-900 dark:text-white text-base leading-snug\">\n                {cat.name}\n              </h4>\n              <p className=\"text-[11px] text-slate-400 mt-0.5\">\n                Created: {cat.createdAt}\n              </p>\n            </div>\n\n            {/* Spec tags */}\n            <div className=\"space-y-2 text-xs\">\n              <p className=\"text-slate-600 dark:text-slate-300 line-clamp-2 text-xs leading-relaxed\">\n                {cat.description}\n              </p>\n\n              <div className=\"flex flex-wrap gap-2 pt-1\">\n                {/* Equipment count */}\n                <div className=\"flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-700/60 text-slate-700 dark:text-slate-300 font-semibold text-[11px]\">\n                  <Wrench className=\"w-3 h-3 text-slate-500\" />\n                  <span>{cat.equipmentCount} Equipment</span>\n                </div>\n\n                {/* Maintenance Interval */}\n                <div className=\"flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-300 text-[11px] font-medium border border-amber-100 dark:border-amber-900/40\">\n                  <Clock className=\"w-3 h-3\" />\n                  <span>{cat.maintenanceIntervalHrs} hrs service</span>\n                </div>\n\n                {/* Powertrain spec */}\n                {cat.fuelTankCapacityLiters > 0 && (\n                  <div className=\"flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-300 text-[11px] font-medium border border-sky-100 dark:border-sky-900/40\">\n                    <Fuel className=\"w-3 h-3\" />\n                    <span>{cat.fuelTankCapacityLiters}L</span>\n                  </div>\n                )}\n              </div>\n            </div>\n\n            {/* Plant info footer */}\n            <div className=\"pt-3 border-t border-slate-100 dark:border-slate-700/60 flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400\">\n              <span className=\"flex items-center gap-1\">\n                <Building2 className=\"w-3.5 h-3.5 text-slate-400\" />\n                {cat.plant}\n              </span>\n              <span className={`font-semibold ${cat.active ? \'text-emerald-600 dark:text-emerald-400\' : \'text-slate-400\'}`}>\n                {cat.active ? \'Active\' : \'Disabled\'}\n              </span>\n            </div>\n\n          </div>\n        ))}\n      </div>"
