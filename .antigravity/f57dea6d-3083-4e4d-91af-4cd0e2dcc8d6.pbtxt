      replacement_content: "import React from \'react\';\nimport { IndustryTypeItem, ProtocolItem, PlantItem } from \'../../types\';\nimport { Building, Radio, MapPin, CheckCircle2, ChevronRight, Activity } from \'lucide-react\';\n\ninterface IndustryTypeViewProps {\n  items: IndustryTypeItem[];\n}\n\nexport const IndustryTypeView: React.FC<IndustryTypeViewProps> = ({ items }) => {\n  return (\n    <div className=\"space-y-4\">\n      <div className=\"bg-white dark:bg-slate-800 rounded-xl p-5 border border-slate-200 dark:border-slate-700 shadow-xs\">\n        <div className=\"flex items-center justify-between mb-4\">\n          <div>\n            <h3 className=\"font-bold text-slate-800 dark:text-white text-base\">Industry Classifications</h3>\n            <p className=\"text-xs text-slate-500 dark:text-slate-400\">Manage high-level industrial sectors, telemetry schemas, and equipment allocations</p>\n          </div>\n          <span className=\"text-xs font-semibold px-3 py-1 rounded-full bg-sky-50 dark:bg-sky-950 text-sky-700 dark:text-sky-300\">\n            {items.length} Active Domains\n          </span>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n          {items.map((item) => (\n            <div key={item.id} className=\"p-4 rounded-xl border border-slate-200 dark:border-slate-700 hover:border-sky-300 transition-all space-y-3 bg-slate-50/40 dark:bg-slate-700/30\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"font-mono text-xs font-bold text-sky-600 dark:text-sky-400\">#{item.code}</span>\n                <span className=\"text-[10px] px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-semibold border border-emerald-200\">\n                  {item.status}\n                </span>\n              </div>\n              <h4 className=\"font-semibold text-slate-800 dark:text-white text-sm\">{item.name}</h4>\n              <div className=\"flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 pt-2 border-t border-slate-200/60 dark:border-slate-600\">\n                <span>{item.totalSensors} Sensors Configured</span>\n                <span>{item.totalEquipment} Equipment</span>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n\ninterface ProtocolViewProps {\n  items: ProtocolItem[];\n}\n\nexport const ProtocolView: React.FC<ProtocolViewProps> = ({ items }) => {\n  return (\n    <div className=\"space-y-4\">\n      <div className=\"bg-white dark:bg-slate-800 rounded-xl p-5 border border-slate-200 dark:border-slate-700 shadow-xs\">\n        <div className=\"flex items-center justify-between mb-4\">\n          <div>\n            <h3 className=\"font-bold text-slate-800 dark:text-white text-base\">Industrial Telematics Protocols</h3>\n            <p className=\"text-xs text-slate-500 dark:text-slate-400\">Fieldbus standards, port specifications, and device network layers</p>\n          </div>\n          <span className=\"text-xs font-semibold px-3 py-1 rounded-full bg-teal-50 dark:bg-teal-950 text-teal-700 dark:text-teal-300\">\n            {items.length} Protocols Standardized\n          </span>\n        </div>\n\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs\">\n            <thead className=\"bg-slate-50 dark:bg-slate-700/50 border-b border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 uppercase tracking-wider font-semibold\">\n              <tr>\n                <th className=\"py-3 px-4\">Protocol Standard</th>\n                <th className=\"py-3 px-4\">Bus Type</th>\n                <th className=\"py-3 px-4\">Default Port / Baud Rate</th>\n                <th className=\"py-3 px-4\">Active Devices</th>\n                <th className=\"py-3 px-4\">Network Status</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100 dark:divide-slate-700 font-medium\">\n              {items.map((p) => (\n                <tr key={p.id} className=\"hover:bg-slate-50 dark:hover:bg-slate-700/40\">\n                  <td className=\"py-3.5 px-4 font-bold text-slate-800 dark:text-white flex items-center gap-2\">\n                    <Radio className=\"w-4 h-4 text-sky-600\" />\n                    <span>{p.name}</span>\n                  </td>\n                  <td className=\"py-3.5 px-4 text-slate-600 dark:text-slate-300\">{p.type}</td>\n                  <td className=\"py-3.5 px-4 font-mono text-slate-600 dark:text-slate-400\">\n                    Port {p.portDefault} {p.baudRate ? `\342\200\242 ${p.baudRate}` : \'\'}\n                  </td>\n                  <td className=\"py-3.5 px-4 font-semibold text-slate-800 dark:text-slate-200\">{p.devicesCount} Units</td>\n                  <td className=\"py-3.5 px-4\">\n                    <span className=\"px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-semibold text-[11px] border border-emerald-200\">\n                      {p.status}\n                    </span>\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  );\n};\n\ninterface PlantViewProps {\n  items: PlantItem[];\n}\n\nexport const PlantView: React.FC<PlantViewProps> = ({ items }) => {\n  return (\n    <div className=\"space-y-4\">\n      <div className=\"bg-white dark:bg-slate-800 rounded-xl p-5 border border-slate-200 dark:border-slate-700 shadow-xs\">\n        <div className=\"flex items-center justify-between mb-4\">\n          <div>\n            <h3 className=\"font-bold text-slate-800 dark:text-white text-base\">Manufacturing & Infrastructure Plants</h3>\n            <p className=\"text-xs text-slate-500 dark:text-slate-400\">Regional production facilities, maintenance depots, and assembly sites</p>\n          </div>\n          <span className=\"text-xs font-semibold px-3 py-1 rounded-full bg-amber-50 dark:bg-amber-950 text-amber-700 dark:text-amber-300\">\n            {items.length} Registered Plants\n          </span>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n          {items.map((plant) => (\n            <div key={plant.id} className=\"p-5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/40 dark:bg-slate-700/30 space-y-3\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"font-mono text-xs font-bold text-slate-500\">#{plant.code}</span>\n                <span className=\"flex items-center gap-1 text-[11px] text-slate-400\">\n                  <MapPin className=\"w-3.5 h-3.5 text-rose-500\" />\n                  {plant.location}\n                </span>\n              </div>\n              <h4 className=\"font-bold text-slate-800 dark:text-white text-sm\">{plant.name}</h4>\n              <div className=\"pt-2 border-t border-slate-200 dark:border-slate-600 flex justify-between text-xs text-slate-600 dark:text-slate-300\">\n                <span>{plant.equipmentCount} Equipment Active</span>\n                <span>{plant.activeLines} Lines</span>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
