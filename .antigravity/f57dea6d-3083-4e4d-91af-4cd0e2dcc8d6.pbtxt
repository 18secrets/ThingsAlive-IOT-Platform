    content: "              >\n                {equipmentList.map((eq) => (\n                  <option key={eq.id} value={eq.name}>\n                    {eq.name} ({eq.cclNumber}) - {eq.maintPlant}\n                  </option>\n                ))}\n              </select>\n            </div>\n\n            {/* Vendor / Manufacturer */}\n            <div>\n              <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70 mb-1.5\">\n                Hardware Vendor\n              </label>\n              <select \n                value={vendor}\n                onChange={(e) => setVendor(e.target.value)}\n                className=\"w-full px-3.5 py-2.5 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] focus:outline-none focus:border-[#FF4D00] cursor-pointer\"\n              >\n                <option value=\"Eicher Motors\">Eicher Motors</option>\n                <option value=\"Tata Motors\">Tata Motors</option>\n                <option value=\"Bosch IoT\">Bosch IoT</option>\n                <option value=\"Cummins Telematics\">Cummins Telematics</option>\n              </select>\n            </div>\n          </div>\n\n          {/* Tool Name Input & Dynamic Matching Section */}\n          <div className=\"pt-4 border-t border-[#121212]/10 dark:border-white/10 space-y-3\">\n            <div className=\"flex items-center justify-between flex-wrap gap-2\">\n              <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70\">\n                Tool Name (from Admin Tool Mapping)\n              </label>\n              \n              {matchedTool ? (\n                <span className=\"text-[10px] font-mono text-emerald-600 dark:text-emerald-400 font-bold flex items-center gap-1 bg-emerald-500/10 px-2 py-0.5 border border-emerald-500/30\">\n                  <CheckCircle2 className=\"w-3 h-3 text-emerald-500\" />\n                  <span>Matched with Admin Tool Mapping</span>\n                </span>\n              ) : (\n                <span className=\"text-[10px] font-mono text-[#FF4D00] font-bold flex items-center gap-1 bg-[#FF4D00]/10 px-2 py-0.5 border border-[#FF4D00]/30\">\n                  <AlertTriangle className=\"w-3 h-3 text-[#FF4D00]\" />\n                  <span>Unmatched Tool Name (Manual Selection Mode)</span>\n                </span>\n              )}\n            </div>\n\n            {/* Input with autocomplete datalist */}\n            <div className=\"relative\">\n              <input \n                type=\"text\"\n                list=\"admin-tool-mapping-options\"\n                value={toolName}\n                onChange={(e) => handleToolNameChange(e.target.value)}\n                placeholder=\"Type or select a Tool Name (e.g. Heavy Excavation Monitoring Kit (HE-400))...\"\n                className=\"w-full px-3.5 py-2.5 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] font-serif focus:outline-none focus:border-[#FF4D00] focus:ring-1 focus:ring-[#FF4D00] placeholder-[#121212]/40 dark:placeholder-[#FDFCF5]/40\"\n              />\n              <datalist id=\"admin-tool-mapping-options\">\n                {toolMappings.map((tool) => (\n                  <option key={tool.id} value={tool.toolName}>\n                    {tool.toolName} ({tool.identifier}) - {tool.protocol}\n                  </option>\n                ))}\n              </datalist>\n            </div>\n\n            {/* Quick-select chips from existing Admin Tool Mappings */}\n            <div className=\"space-y-1.5\">\n              <div className=\"flex items-center justify-between text-[10px] font-mono text-[#121212]/60 dark:text-[#FDFCF5]/60\">\n                <span>Quick Select from Admin Tool Mappings:</span>\n                {toolName && (\n                  <button\n                    type=\"button\"\n                    onClick={() => handleToolNameChange(\'\')}\n                    className=\"text-[#FF4D00] hover:underline font-bold text-[10px] flex items-center gap-1 cursor-pointer\"\n                  >\n                    <XCircle className=\"w-3 h-3\" />\n                    <span>Clear / Manual Mode</span>\n                  </button>\n                )}\n              </div>\n              <div className=\"flex flex-wrap gap-1.5\">\n                {toolMappings.map((tool) => {\n                  const isCurrent = toolName.trim().toLowerCase() === tool.toolName.trim().toLowerCase();\n                  return (\n                    <button\n                      key={tool.id}\n                      type=\"button\"\n                      onClick={() => handleToolNameChange(tool.toolName)}\n                      className={`px-2.5 py-1 text-[11px] font-mono border transition-all cursor-pointer flex items-center gap-1.5 ${\n                        isCurrent\n                          ? \'bg-[#121212] text-white dark:bg-[#FDFCF5] dark:text-[#121212] border-[#121212] dark:border-white font-bold shadow-xs\'\n                          : \'bg-[#FDFCF5] dark:bg-[#121212] text-[#121212]/80 dark:text-[#FDFCF5]/80 border-[#121212]/15 dark:border-white/15 hover:border-[#FF4D00]\'\n                      }`}\n                    >\n                      {isCurrent && <Check className=\"w-3 h-3 text-[#FF4D00]\" />}\n                      <span>{tool.toolName}</span>\n                      <span className=\"text-[9px] opacity-60\">({tool.mappedSensors.length} sensors)</span>\n                    </button>\n                  );\n                })}\n              </div>\n            </div>\n\n            {/* MATCHED CASE: Show the tool mapping sensors and parameters info */}\n            {matchedTool ? (\n              <div className=\"p-4 bg-emerald-500/5 dark:bg-emerald-950/10 border border-emerald-500/30 dark:border-emerald-500/20 space-y-3\">\n                <div className=\"flex items-center justify-between flex-wrap gap-2\">\n                  <div className=\"flex items-center gap-2\">\n                    <Sparkles className=\"w-4 h-4 text-emerald-600 dark:text-emerald-400\" />\n                    <span className=\"font-serif font-bold text-sm text-[#121212] dark:text-[#FDFCF5]\">\n                      Matched Tool Profile: {matchedTool.toolName}\n                    </span>\n                  </div>\n                  <div className=\"flex items-center gap-2 text-[10px] font-mono\">\n                    <span className=\"px-2 py-0.5 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30\">\n                      ID: {matchedTool.identifier}\n                    </span>\n                    <span className=\"px-2 py-0.5 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30\">\n                      Protocol: {matchedTool.protocol}\n                    </span>\n                  </div>\n                </div>\n\n                <p className=\"text-[11px] text-[#121212]/70 dark:text-[#FDFCF5]/70 font-sans\">\n                  The entered Tool Name matches an Admin Tool Mapping. The mapped sensors and telemetry parameters have been auto-populated below:\n                </p>\n\n                {/* Breakdown of mapped sensors & parameters info */}\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5 pt-1\">\n                  {matchedTool.mappedSensors.map((s) => (\n                    <div \n                      key={s.id}\n                      className=\"p-3 bg-white dark:bg-[#1A1918] border border-[#121212]/15 dark:border-white/15 flex flex-col justify-between\"\n                    >\n                      <div className=\"flex items-center justify-between mb-1.5\">\n                        <span className=\"font-serif font-bold text-xs text-[#121212] dark:text-[#FDFCF5]\">\n                          {s.name}\n                        </span>\n                        <span className=\"text-[9px] font-mono text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-1.5 py-0.5 border border-emerald-500/20\">\n                          {s.parameters.length} Channels\n                        </span>\n                      </div>\n\n                      <div className=\"mt-1 flex flex-wrap gap-1\">\n                        {s.parameters.map((param) => (\n                          <span \n                            key={param}\n                            className=\"px-1.5 py-0.5 text-[9px] font-mono bg-[#F4F2EA] dark:bg-stone-800 text-[#121212] dark:text-[#FDFCF5] border border-[#121212]/10 dark:border-white/10\"\n                          >\n                            {param}\n                          </span>\n                        ))}\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            ) : (\n              /* UNMATCHED CASE: Show empty notice, user selects manually */\n              <div className=\"p-4 bg-[#FAF9F2] dark:bg-[#151514] border border-[#121212]/15 dark:border-white/15 flex items-start gap-3\">\n                <Info className=\"w-4 h-4 text-[#FF4D00] shrink-0 mt-0.5\" />\n                <div className=\"text-xs\">\n                  <div className=\"font-serif font-bold text-[#121212] dark:text-[#FDFCF5]\">\n                    {toolName.trim() \n                      ? `No Tool Mapping found for \"${toolName}\"` \n                      : \'Tool Name is Empty (Manual Configuration Mode)\'}\n                  </div>\n                  <p className=\"text-[11px] text-[#121212]/70 dark:text-[#FDFCF5]/70 mt-1\">\n                    Sensors and parameters are currently empty. Please select sensors and configure telemetry channels manually from the catalog below."
    raw_content: "import React, { useState, useEffect, useMemo } from \'react\';\nimport { \n  ArrowLeft, \n  Cpu, \n  Check, \n  Activity, \n  Radio, \n  CheckCircle2, \n  AlertTriangle, \n  Layers, \n  Info,\n  ArrowRight,\n  Sparkles,\n  SlidersHorizontal,\n  XCircle,\n  Plus\n} from \'lucide-react\';\nimport { DeviceItem, ToolMappingItem, SensorItem, CategoryItem, PlantItem, EquipmentItem } from \'../../types\';\n\ninterface DeviceSetupProps {\n  onBack: () => void;\n  onSaveDevice: (device: DeviceItem) => void;\n  toolMappings: ToolMappingItem[];\n  sensors: SensorItem[];\n  categories: CategoryItem[];\n  plants: PlantItem[];\n  equipmentList: EquipmentItem[];\n}\n\nexport const DeviceSetup: React.FC<DeviceSetupProps> = ({\n  onBack,\n  onSaveDevice,\n  toolMappings,\n  sensors,\n  categories,\n  plants,\n  equipmentList,\n}) => {\n  const [deviceName, setDeviceName] = useState(\'PowerCommand Cloud Edge Node\');\n  const [imei, setImei] = useState(\'356789104590731\');\n  const [vendor, setVendor] = useState(\'Eicher Motors\');\n  const [selectedPlant, setSelectedPlant] = useState(plants[0]?.name || \'\');\n  const [selectedCategory, setSelectedCategory] = useState(categories[0]?.name || \'\');\n  const [selectedEquipment, setSelectedEquipment] = useState(\'\');\n  \n  // Tool Name state for matching with Admin Tool Mappings\n  const [toolName, setToolName] = useState(\'\');\n  const [manualProtocol, setManualProtocol] = useState(\'MODBUS TCP\');\n  const [activeSensorNames, setActiveSensorNames] = useState<string[]>([]);\n  const [activeParametersMap, setActiveParametersMap] = useState<Record<string, string[]>>({});\n\n  // Sync initial plant & category if state was empty\n  useEffect(() => {\n    if (!selectedPlant && plants.length > 0) {\n      setSelectedPlant(plants[0].name);\n    }\n  }, [plants, selectedPlant]);\n\n  useEffect(() => {\n    if (!selectedCategory && categories.length > 0) {\n      setSelectedCategory(categories[0].name);\n    }\n  }, [categories, selectedCategory]);\n\n  // Check if entered toolName matches any tool mapping in toolMappings\n  const matchedTool = useMemo(() => {\n    if (!toolName.trim()) return null;\n    return toolMappings.find(\n      (t) => t.toolName.trim().toLowerCase() === toolName.trim().toLowerCase()\n    ) || null;\n  }, [toolName, toolMappings]);\n\n  // Handle Tool Name change and sync matching tool mapping data\n  const handleToolNameChange = (newToolName: string) => {\n    setToolName(newToolName);\n\n    const matched = toolMappings.find(\n      (t) => t.toolName.trim().toLowerCase() === newToolName.trim().toLowerCase()\n    );\n\n    if (matched) {\n      // Matching found: Auto-populate sensors and parameters info from tool mapping\n      const sensorNames = matched.mappedSensors.map((s) => s.name);\n      setActiveSensorNames(sensorNames);\n\n      const paramsMap: Record<string, string[]> = {};\n      matched.mappedSensors.forEach((s) => {\n        paramsMap[s.name] = [...s.parameters];\n      });\n      setActiveParametersMap(paramsMap);\n    } else {\n      // Not matching: Empty sensors and parameters, user selects manually\n      setActiveSensorNames([]);\n      setActiveParametersMap({});\n    }\n  };\n\n  // Filter equipment based on chosen Plant and/or Category\n  const relevantEquipment = equipmentList.filter((eq) => {\n    const matchesPlant = !selectedPlant || eq.maintPlant === selectedPlant;\n    const matchesCat = !selectedCategory || eq.category === selectedCategory;\n    return matchesPlant || matchesCat;\n  });\n\n  // Default equipment selection when list updates\n  useEffect(() => {\n    if (!selectedEquipment) {\n      if (relevantEquipment.length > 0) {\n        setSelectedEquipment(relevantEquipment[0].name);\n      } else if (equipmentList.length > 0) {\n        setSelectedEquipment(equipmentList[0].name);\n      }\n    }\n  }, [relevantEquipment, equipmentList, selectedEquipment]);\n\n  // Handle manual or custom toggle of a sensor\n  const handleToggleSensor = (sensor: SensorItem) => {\n    const sName = sensor.sensorName;\n    const isCurrentlyActive = activeSensorNames.includes(sName);\n\n    if (isCurrentlyActive) {\n      // Remove sensor and its parameters\n      setActiveSensorNames((prev) => prev.filter((s) => s !== sName));\n      setActiveParametersMap((prev) => {\n        const next = { ...prev };\n        delete next[sName];\n        return next;\n      });\n    } else {\n      // Add sensor and include its default parameters from sensor catalog\n      setActiveSensorNames((prev) => [...prev, sName]);\n      setActiveParametersMap((prev) => ({\n        ...prev,\n        [sName]: sensor.parameters ? [...sensor.parameters] : [],\n      }));\n    }\n  };\n\n  // Handle manual toggle of a parameter channel for an active sensor\n  const handleToggleParameter = (sensorName: string, paramName: string) => {\n    setActiveParametersMap((prev) => {\n      const currentParams = prev[sensorName] || [];\n      const updated = currentParams.includes(paramName)\n        ? currentParams.filter((p) => p !== paramName)\n        : [...currentParams, paramName];\n      return {\n        ...prev,\n        [sensorName]: updated,\n      };\n    });\n  };\n\n  // Select all sensors manually\n  const handleSelectAllSensors = () => {\n    const allNames = sensors.map((s) => s.sensorName);\n    setActiveSensorNames(allNames);\n    const pMap: Record<string, string[]> = {};\n    sensors.forEach((s) => {\n      pMap[s.sensorName] = s.parameters ? [...s.parameters] : [];\n    });\n    setActiveParametersMap(pMap);\n  };\n\n  // Clear all sensors manually\n  const handleClearAllSensors = () => {\n    setActiveSensorNames([]);\n    setActiveParametersMap({});\n  };\n\n  // Compute total active parameter channels\n  const totalActiveParameters = useMemo(() => {\n    return Object.keys(activeParametersMap).reduce((acc, key) => {\n      const p = activeParametersMap[key];\n      return acc + (Array.isArray(p) ? p.length : 0);\n    }, 0);\n  }, [activeParametersMap]);\n\n  const effectiveProtocol = matchedTool ? matchedTool.protocol : manualProtocol;\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!deviceName || !imei) return;\n\n    const newDevice: DeviceItem = {\n      id: Math.floor(132 + Math.random() * 50),\n      name: deviceName.trim(),\n      imei: imei.trim(),\n      equipmentName: selectedEquipment || \'Unassigned Equipment\',\n      vendor: vendor,\n      status: \'Online\',\n      toolProfile: toolName.trim() || (matchedTool ? matchedTool.toolName : \'Custom Tool Configuration\'),\n      category: selectedCategory,\n      plant: selectedPlant,\n      selectedSensors: activeSensorNames,\n      mappedSensorsCount: activeSensorNames.length,\n      lastPing: \'Just now\'\n    };\n\n    onSaveDevice(newDevice);\n  };\n\n  return (\n    <div id=\"device-setup-view\" className=\"space-y-6 max-w-4xl mx-auto\" data-purpose=\"device-setup-page\">\n      \n      {/* Top Breadcrumb & Action */}\n      <div className=\"flex items-center justify-between\">\n        <button\n          onClick={onBack}\n          className=\"flex items-center gap-2 text-xs font-sans uppercase tracking-[0.14em] font-bold text-[#121212] hover:text-[#FF4D00] dark:text-[#FDFCF5] dark:hover:text-[#FF4D00] transition-colors cursor-pointer\"\n        >\n          <ArrowLeft className=\"w-4 h-4\" />\n          <span>Back to Device Management</span>\n        </button>\n\n        <div className=\"flex items-center gap-2\">\n          <span className=\"px-2 py-0.5 bg-[#FF4D00]/10 text-[#FF4D00] text-[10px] font-mono font-bold uppercase border border-[#FF4D00]/30\">\n            Admin Master Data Bound\n          </span>\n          <span className=\"text-[11px] font-mono text-[#121212]/50 dark:text-[#FDFCF5]/50 uppercase\">Step 1 of 1 \342\200\242 Onboarding</span>\n        </div>\n      </div>\n\n      {/* Main Setup Card matching Image 9 */}\n      <div className=\"bg-[#FFFFFF] dark:bg-[#1A1918] border border-[#121212]/15 dark:border-white/15 shadow-xs overflow-hidden\">\n        \n        {/* Card Header with Simplified Setup Badge */}\n        <div className=\"px-8 py-6 border-b border-[#121212]/10 dark:border-white/10 bg-[#FAF9F2] dark:bg-[#151514] flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div>\n            <div className=\"flex items-center gap-3\">\n              <h2 className=\"text-xl font-serif font-bold text-[#121212] dark:text-[#FDFCF5]\">\n                Device Onboarding & Admin Configuration\n              </h2>\n              <span className=\"px-2.5 py-0.5 bg-[#121212] text-white dark:bg-[#FDFCF5] dark:text-[#121212] font-mono font-bold text-[10px] uppercase border border-[#121212] dark:border-white\">\n                Strict Schema\n              </span>\n            </div>\n            <p className=\"text-xs text-[#121212]/60 dark:text-[#FDFCF5]/60 mt-1 font-sans\">\n              Plants, Categories, Tool Mappings, and Sensors in this form are drawn strictly from the Admin configuration.\n            </p>\n          </div>\n\n          <div className=\"w-10 h-10 border border-[#121212]/15 dark:border-white/15 bg-[#F4F2EA] dark:bg-stone-800 text-[#121212] dark:text-[#FDFCF5] flex items-center justify-center shrink-0\">\n            <Cpu className=\"w-5 h-5\" />\n          </div>\n        </div>\n\n        {/* Master Catalog Indicators */}\n        <div className=\"px-8 py-3 bg-[#F4F2EA] dark:bg-[#151514] border-b border-[#121212]/10 dark:border-white/10 flex items-center justify-between flex-wrap gap-2 text-xs font-mono text-[#121212]/75 dark:text-[#FDFCF5]/75\">\n          <div className=\"flex items-center gap-2\">\n            <Layers className=\"w-3.5 h-3.5 text-[#FF4D00]\" />\n            <span>Admin Data Source: <strong>{plants.length} Plants</strong> \342\200\242 <strong>{categories.length} Categories</strong> \342\200\242 <strong>{toolMappings.length} Tool Mappings</strong> \342\200\242 <strong>{sensors.length} Sensors</strong></span>\n          </div>\n          <span className=\"text-[10px] text-[#FF4D00] uppercase font-bold tracking-wider\">Live Synchronized</span>\n        </div>\n\n        {/* Form Body */}\n        <form onSubmit={handleSubmit} className=\"p-8 space-y-6\">\n          \n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-5 text-xs font-sans\">\n            {/* Device Name */}\n            <div>\n              <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70 mb-1.5\">\n                Device Name <span className=\"text-[#FF4D00]\">*</span>\n              </label>\n              <input \n                type=\"text\" \n                required\n                value={deviceName}\n                onChange={(e) => setDeviceName(e.target.value)}\n                placeholder=\"e.g. PowerCommand Cloud Edge 2\" \n                className=\"w-full px-3.5 py-2.5 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] placeholder-[#121212]/40 dark:placeholder-[#FDFCF5]/40 focus:outline-none focus:border-[#FF4D00] focus:ring-1 focus:ring-[#FF4D00] transition-colors font-sans\"\n              />\n            </div>\n\n            {/* IMEI / Hardware Serial */}\n            <div>\n              <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70 mb-1.5\">\n                IMEI / Hardware Serial Number <span className=\"text-[#FF4D00]\">*</span>\n              </label>\n              <input \n                type=\"text\" \n                required\n                value={imei}\n                onChange={(e) => setImei(e.target.value)}\n                placeholder=\"15-digit unique cellular hardware IMEI\" \n                className=\"w-full px-3.5 py-2.5 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] placeholder-[#121212]/40 dark:placeholder-[#FDFCF5]/40 focus:outline-none focus:border-[#FF4D00] focus:ring-1 focus:ring-[#FF4D00] transition-colors font-mono\"\n              />\n            </div>\n\n            {/* Plant Dropdown (Strictly from Admin Plants) */}\n            <div>\n              <div className=\"flex items-center justify-between mb-1.5\">\n                <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70\">\n                  Plant (from Admin) <span className=\"text-[#FF4D00]\">*</span>\n                </label>\n                <span className=\"text-[10px] font-mono text-[#FF4D00]\">Admin Only</span>\n              </div>\n              <select \n                value={selectedPlant}\n                onChange={(e) => setSelectedPlant(e.target.value)}\n                required\n                className=\"w-full px-3.5 py-2.5 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] font-serif focus:outline-none focus:border-[#FF4D00] cursor-pointer\"\n              >\n                {plants.length === 0 ? (\n                  <option value=\"\">No plants configured in Admin</option>\n                ) : (\n                  plants.map((p) => (\n                    <option key={p.id} value={p.name}>\n                      {p.name} ({p.location})\n                    </option>\n                  ))\n                )}\n              </select>\n            </div>\n\n            {/* Category Dropdown (Strictly from Admin Categories) */}\n            <div>\n              <div className=\"flex items-center justify-between mb-1.5\">\n                <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70\">\n                  Category (from Admin) <span className=\"text-[#FF4D00]\">*</span>\n                </label>\n                <span className=\"text-[10px] font-mono text-[#FF4D00]\">Admin Only</span>\n              </div>\n              <select \n                value={selectedCategory}\n                onChange={(e) => setSelectedCategory(e.target.value)}\n                required\n                className=\"w-full px-3.5 py-2.5 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] font-serif focus:outline-none focus:border-[#FF4D00] cursor-pointer\"\n              >\n                {categories.length === 0 ? (\n                  <option value=\"\">No categories configured in Admin</option>\n                ) : (\n                  categories.map((c) => (\n                    <option key={c.id} value={c.name}>\n                      {c.name} ({c.code})\n                    </option>\n                  ))\n                )}\n              </select>\n            </div>\n\n            {/* Equipment Assignment */}\n            <div>\n              <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70 mb-1.5\">\n                Equipment Assignment\n              </label>\n              <select \n                value={selectedEquipment}\n                onChange={(e) => setSelectedEquipment(e.target.value)}\n                className=\"w-full px-3.5 py-2.5 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] font-serif focus:outline-none focus:border-[#FF4D00] cursor-pointer\"\n              >\n                {equipmentList.map((eq) => (\n                  <option key={eq.id} value={eq.name}>\n                    {eq.name} ({eq.cclNumber}) - {eq.maintPlant}\n                  </option>\n                ))}\n              </select>\n            </div>\n\n            {/* Vendor / Manufacturer */}\n            <div>\n              <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70 mb-1.5\">\n                Hardware Vendor\n              </label>\n              <select \n                value={vendor}\n                onChange={(e) => setVendor(e.target.value)}\n                className=\"w-full px-3.5 py-2.5 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] focus:outline-none focus:border-[#FF4D00] cursor-pointer\"\n              >\n                <option value=\"Eicher Motors\">Eicher Motors</option>\n                <option value=\"Tata Motors\">Tata Motors</option>\n                <option value=\"Bosch IoT\">Bosch IoT</option>\n                <option value=\"Cummins Telematics\">Cummins Telematics</option>\n              </select>\n            </div>\n          </div>\n\n          {/* Tool Name Input & Dynamic Matching Section */}\n          <div className=\"pt-4 border-t border-[#121212]/10 dark:border-white/10 space-y-3\">\n            <div className=\"flex items-center justify-between flex-wrap gap-2\">\n              <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70\">\n                Tool Name (from Admin Tool Mapping)\n              </label>\n              \n              {matchedTool ? (\n                <span className=\"text-[10px] font-mono text-emerald-600 dark:text-emerald-400 font-bold flex items-center gap-1 bg-emerald-500/10 px-2 py-0.5 border border-emerald-500/30\">\n                  <CheckCircle2 className=\"w-3 h-3 text-emerald-500\" />\n                  <span>Matched with Admin Tool Mapping</span>\n                </span>\n              ) : (\n                <span className=\"text-[10px] font-mono text-[#FF4D00] font-bold flex items-center gap-1 bg-[#FF4D00]/10 px-2 py-0.5 border border-[#FF4D00]/30\">\n                  <AlertTriangle className=\"w-3 h-3 text-[#FF4D00]\" />\n                  <span>Unmatched Tool Name (Manual Selection Mode)</span>\n                </span>\n              )}\n            </div>\n\n            {/* Input with autocomplete datalist */}\n            <div className=\"relative\">\n              <input \n                type=\"text\"\n                list=\"admin-tool-mapping-options\"\n                value={toolName}\n                onChange={(e) => handleToolNameChange(e.target.value)}\n                placeholder=\"Type or select a Tool Name (e.g. Heavy Excavation Monitoring Kit (HE-400))...\"\n                className=\"w-full px-3.5 py-2.5 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] font-serif focus:outline-none focus:border-[#FF4D00] focus:ring-1 focus:ring-[#FF4D00] placeholder-[#121212]/40 dark:placeholder-[#FDFCF5]/40\"\n              />\n              <datalist id=\"admin-tool-mapping-options\">\n                {toolMappings.map((tool) => (\n                  <option key={tool.id} value={tool.toolName}>\n                    {tool.toolName} ({tool.identifier}) - {tool.protocol}\n                  </option>\n                ))}\n              </datalist>\n            </div>\n\n            {/* Quick-select chips from existing Admin Tool Mappings */}\n            <div className=\"space-y-1.5\">\n              <div className=\"flex items-center justify-between text-[10px] font-mono text-[#121212]/60 dark:text-[#FDFCF5]/60\">\n                <span>Quick Select from Admin Tool Mappings:</span>\n                {toolName && (\n                  <button\n                    type=\"button\"\n                    onClick={() => handleToolNameChange(\'\')}\n                    className=\"text-[#FF4D00] hover:underline font-bold text-[10px] flex items-center gap-1 cursor-pointer\"\n                  >\n                    <XCircle className=\"w-3 h-3\" />\n                    <span>Clear / Manual Mode</span>\n                  </button>\n                )}\n              </div>\n              <div className=\"flex flex-wrap gap-1.5\">\n                {toolMappings.map((tool) => {\n                  const isCurrent = toolName.trim().toLowerCase() === tool.toolName.trim().toLowerCase();\n                  return (\n                    <button\n                      key={tool.id}\n                      type=\"button\"\n                      onClick={() => handleToolNameChange(tool.toolName)}\n                      className={`px-2.5 py-1 text-[11px] font-mono border transition-all cursor-pointer flex items-center gap-1.5 ${\n                        isCurrent\n                          ? \'bg-[#121212] text-white dark:bg-[#FDFCF5] dark:text-[#121212] border-[#121212] dark:border-white font-bold shadow-xs\'\n                          : \'bg-[#FDFCF5] dark:bg-[#121212] text-[#121212]/80 dark:text-[#FDFCF5]/80 border-[#121212]/15 dark:border-white/15 hover:border-[#FF4D00]\'\n                      }`}\n                    >\n                      {isCurrent && <Check className=\"w-3 h-3 text-[#FF4D00]\" />}\n                      <span>{tool.toolName}</span>\n                      <span className=\"text-[9px] opacity-60\">({tool.mappedSensors.length} sensors)</span>\n                    </button>\n                  );\n                })}\n              </div>\n            </div>\n\n            {/* MATCHED CASE: Show the tool mapping sensors and parameters info */}\n            {matchedTool ? (\n              <div className=\"p-4 bg-emerald-500/5 dark:bg-emerald-950/10 border border-emerald-500/30 dark:border-emerald-500/20 space-y-3\">\n                <div className=\"flex items-center justify-between flex-wrap gap-2\">\n                  <div className=\"flex items-center gap-2\">\n                    <Sparkles className=\"w-4 h-4 text-emerald-600 dark:text-emerald-400\" />\n                    <span className=\"font-serif font-bold text-sm text-[#121212] dark:text-[#FDFCF5]\">\n                      Matched Tool Profile: {matchedTool.toolName}\n                    </span>\n                  </div>\n                  <div className=\"flex items-center gap-2 text-[10px] font-mono\">\n                    <span className=\"px-2 py-0.5 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30\">\n                      ID: {matchedTool.identifier}\n                    </span>\n                    <span className=\"px-2 py-0.5 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30\">\n                      Protocol: {matchedTool.protocol}\n                    </span>\n                  </div>\n                </div>\n\n                <p className=\"text-[11px] text-[#121212]/70 dark:text-[#FDFCF5]/70 font-sans\">\n                  The entered Tool Name matches an Admin Tool Mapping. The mapped sensors and telemetry parameters have been auto-populated below:\n                </p>\n\n                {/* Breakdown of mapped sensors & parameters info */}\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5 pt-1\">\n                  {matchedTool.mappedSensors.map((s) => (\n                    <div \n                      key={s.id}\n                      className=\"p-3 bg-white dark:bg-[#1A1918] border border-[#121212]/15 dark:border-white/15 flex flex-col justify-between\"\n                    >\n                      <div className=\"flex items-center justify-between mb-1.5\">\n                        <span className=\"font-serif font-bold text-xs text-[#121212] dark:text-[#FDFCF5]\">\n                          {s.name}\n                        </span>\n                        <span className=\"text-[9px] font-mono text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-1.5 py-0.5 border border-emerald-500/20\">\n                          {s.parameters.length} Channels\n                        </span>\n                      </div>\n\n                      <div className=\"mt-1 flex flex-wrap gap-1\">\n                        {s.parameters.map((param) => (\n                          <span \n                            key={param}\n                            className=\"px-1.5 py-0.5 text-[9px] font-mono bg-[#F4F2EA] dark:bg-stone-800 text-[#121212] dark:text-[#FDFCF5] border border-[#121212]/10 dark:border-white/10\"\n                          >\n                            {param}\n                          </span>\n                        ))}\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            ) : (\n              /* UNMATCHED CASE: Show empty notice, user selects manually */\n              <div className=\"p-4 bg-[#FAF9F2] dark:bg-[#151514] border border-[#121212]/15 dark:border-white/15 flex items-start gap-3\">\n                <Info className=\"w-4 h-4 text-[#FF4D00] shrink-0 mt-0.5\" />\n                <div className=\"text-xs\">\n                  <div className=\"font-serif font-bold text-[#121212] dark:text-[#FDFCF5]\">\n                    {toolName.trim() \n                      ? `No Tool Mapping found for \"${toolName}\"` \n                      : \'Tool Name is Empty (Manual Configuration Mode)\'}\n                  </div>\n                  <p className=\"text-[11px] text-[#121212]/70 dark:text-[#FDFCF5]/70 mt-1\">\n                    Sensors and parameters are currently empty. Please select sensors and configure telemetry channels manually from the catalog below.\n                  </p>\n                </div>\n              </div>\n            )}\n          </div>\n\n          {/* Active Sensors & Parameters Catalog (Manual or Auto-selected) */}\n          <div className=\"p-5 bg-[#FAF9F2] dark:bg-[#151514] border border-[#121212]/15 dark:border-white/15 space-y-4\">\n            <div className=\"flex items-center justify-between flex-wrap gap-2\">\n              <div className=\"flex items-center gap-2 text-[#121212] dark:text-[#FDFCF5] font-serif font-bold text-sm\">\n                <Activity className=\"w-4 h-4 text-[#FF4D00]\" />\n                <span>Assigned Sensors & Parameter Channels</span>\n              </div>\n              <div className=\"flex items-center gap-2\">\n                <span className=\"px-2.5 py-0.5 bg-[#F4F2EA] dark:bg-stone-800 text-[#121212] dark:text-[#FDFCF5] text-[10px] font-mono uppercase font-bold border border-[#121212]/20 dark:border-white/20\">\n                  {activeSensorNames.length} of {sensors.length} Connected \342\200\242 {totalActiveParameters} Parameters\n                </span>\n                {!matchedTool && (\n                  <div className=\"flex items-center gap-1 text-[10px] font-mono\">\n                    <button\n                      type=\"button\"\n                      onClick={handleSelectAllSensors}\n                      className=\"px-2 py-0.5 border border-[#121212]/20 dark:border-white/20 hover:border-[#FF4D00] cursor-pointer text-[#121212] dark:text-[#FDFCF5]\"\n                    >\n                      Select All\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={handleClearAllSensors}\n                      className=\"px-2 py-0.5 border border-[#121212]/20 dark:border-white/20 hover:border-[#FF4D00] cursor-pointer text-[#121212] dark:text-[#FDFCF5]\"\n                    >\n                      Clear\n                    </button>\n                  </div>\n                )}\n              </div>\n            </div>\n\n            {/* Empty state notice if zero sensors are selected */}\n            {activeSensorNames.length === 0 ? (\n              <div className=\"py-8 text-center border border-dashed border-[#121212]/20 dark:border-white/20 bg-[#FFFFFF] dark:bg-[#1A1918]\">\n                <Activity className=\"w-6 h-6 text-[#121212]/30 dark:text-[#FDFCF5]/30 mx-auto mb-2\" />\n                <div className=\"font-serif text-sm font-bold text-[#121212] dark:text-[#FDFCF5]\">\n                  No Sensors or Parameters Selected\n                </div>\n                <p className=\"text-xs text-[#121212]/60 dark:text-[#FDFCF5]/60 mt-1 max-w-sm mx-auto\">\n                  Sensors are empty because the Tool Name does not match an Admin Tool Mapping. Click any sensor below to manually assign it and its parameters.\n                </p>\n              </div>\n            ) : (\n              <p className=\"text-[11px] text-[#121212]/60 dark:text-[#FDFCF5]/60 font-mono\">\n                {matchedTool \n                  ? `Showing sensors and parameters loaded from ${matchedTool.toolName}. Click any sensor to toggle or fine-tune channels:`\n                  : \'Sensors selected manually. Click any sensor to toggle or customize parameter channels:\'}\n              </p>\n            )}\n\n            {/* Grid of Admin Sensors with Interactive Parameter Badges */}\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 max-h-72 overflow-y-auto pr-1\">\n              {sensors.map((sensor) => {\n                const isActive = activeSensorNames.includes(sensor.sensorName);\n                const activeParamsForSensor = activeParametersMap[sensor.sensorName] || [];\n\n                return (\n                  <div \n                    key={sensor.id}\n                    className={`p-3 text-left border transition-all flex flex-col justify-between ${\n                      isActive \n                        ? \'bg-[#FFFFFF] dark:bg-[#1A1918] border-[#121212] dark:border-white shadow-xs\' \n                        : \'bg-[#FFFFFF]/60 dark:bg-[#1A1918]/60 text-[#121212] dark:text-[#FDFCF5] border-[#121212]/15 dark:border-white/15 hover:border-[#FF4D00]\'\n                    }`}\n                  >\n                    <div>\n                      {/* Sensor Header Button */}\n                      <button\n                        type=\"button\"\n                        onClick={() => handleToggleSensor(sensor)}\n                        className=\"w-full text-left flex items-center justify-between mb-1.5 cursor-pointer\"\n                      >\n                        <span className=\"font-serif font-bold text-xs truncate max-w-[170px]\" title={sensor.sensorName}>\n                          {sensor.sensorName}\n                        </span>\n                        {isActive ? (\n                          <div className=\"w-4 h-4 bg-[#FF4D00] text-white flex items-center justify-center text-xs shrink-0\">\n                            <Check className=\"w-3 h-3\" />\n                          </div>\n                        ) : (\n                          <span className=\"w-4 h-4 border border-[#121212]/30 dark:border-white/30 shrink-0 inline-block\" />\n                        )}\n                      </button>\n\n                      <div className=\"text-[9px] font-mono opacity-70 truncate mb-2\">\n                        {sensor.industryType} \342\200\242 {sensor.protocol || \'MODBUS\'}\n                      </div>\n                    </div>\n\n                    {/* Sensor Parameters Chips */}\n                    {sensor.parameters && sensor.parameters.length > 0 && (\n                      <div className=\"mt-2 pt-2 border-t border-[#121212]/10 dark:border-white/10 space-y-1\">\n                        <div className=\"text-[9px] font-mono opacity-60 uppercase flex items-center justify-between\">\n                          <span>Parameters</span>\n                          {isActive && (\n                            <span>{activeParamsForSensor.length}/{sensor.parameters.length} Active</span>\n                          )}\n                        </div>\n                        <div className=\"flex flex-wrap gap-1\">\n                          {sensor.parameters.map((param) => {\n                            const isParamActive = activeParamsForSensor.includes(param);\n                            return (\n                              <button\n                                key={param}\n                                type=\"button\"\n                                onClick={() => {\n                                  if (!isActive) {\n                                    handleToggleSensor(sensor);\n                                  } else {\n                                    handleToggleParameter(sensor.sensorName, param);\n                                  }\n                                }}\n                                className={`px-1.5 py-0.5 text-[9px] font-mono border transition-colors cursor-pointer ${\n                                  isActive && isParamActive\n                                    ? \'bg-[#121212] text-white dark:bg-[#FDFCF5] dark:text-[#121212] border-[#121212] dark:border-white\'\n                                    : \'bg-[#F4F2EA] dark:bg-stone-800 text-[#121212]/60 dark:text-[#FDFCF5]/60 border-[#121212]/15 dark:border-white/15 hover:border-[#FF4D00]\'\n                                }`}\n                              >\n                                {param}\n                              </button>\n                            );\n                          })}\n                        </div>\n                      </div>\n                    )}\n                  </div>\n                );\n              })}\n            </div>\n\n            {/* Protocol & Communication Info */}\n            <div className=\"p-3 bg-[#F4F2EA] dark:bg-stone-800 border border-[#121212]/15 dark:border-white/15 flex items-center justify-between flex-wrap gap-2 text-xs text-[#121212] dark:text-[#FDFCF5] font-mono text-[11px]\">\n              <div className=\"flex items-center gap-2\">\n                <Radio className=\"w-3.5 h-3.5 text-[#FF4D00]\" />\n                <span>\n                  Communication Protocol: <strong className=\"font-bold\">{effectiveProtocol}</strong>\n                </span>\n                {!matchedTool && (\n                  <select\n                    value={manualProtocol}\n                    onChange={(e) => setManualProtocol(e.target.value)}\n                    className=\"ml-2 px-2 py-0.5 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-xs cursor-pointer\"\n                  >\n                    <option value=\"MODBUS TCP\">MODBUS TCP</option>\n                    <option value=\"CAN Bus (J1939)\">CAN Bus (J1939)</option>\n                    <option value=\"MQTT / TLS\">MQTT / TLS</option>\n                    <option value=\"RS-485 Modbus RTU\">RS-485 Modbus RTU</option>\n                  </select>\n                )}\n              </div>\n              <span>Sampling: 1 Hz Real-time Continuous</span>\n            </div>\n          </div>\n\n          {/* Action Buttons */}\n          <div className=\"pt-4 border-t border-[#121212]/10 dark:border-white/10 flex items-center justify-end gap-3\">\n            <button\n              type=\"button\"\n              onClick={onBack}\n              className=\"px-5 py-2.5 border border-[#121212]/20 dark:border-white/20 bg-transparent text-[#121212] dark:text-[#FDFCF5] text-xs font-sans uppercase tracking-[0.14em] font-bold hover:bg-[#F4F2EA] dark:hover:bg-stone-800 transition-colors cursor-pointer\"\n            >\n              Cancel\n            </button>\n            <button\n              type=\"submit\"\n              className=\"px-6 py-2.5 bg-[#121212] text-[#FDFCF5] hover:bg-[#FF4D00] hover:text-white dark:bg-[#FDFCF5] dark:text-[#121212] dark:hover:bg-[#FF4D00] dark:hover:text-white border border-[#121212] dark:border-white text-xs font-sans uppercase tracking-[0.14em] font-bold shadow-xs flex items-center gap-2 transition-colors cursor-pointer\"\n            >\n              <span>Create Device</span>\n              <ArrowRight className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n\n        </form>\n\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 706
    num_bytes: 34868
  }
}
