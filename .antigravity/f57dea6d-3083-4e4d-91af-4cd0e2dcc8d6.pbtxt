  file_change {
    absolute_path_uri: "file:///src/components/admin/MapSensorsModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { X, Check, Radio, Activity, Layers } from \'lucide-react\';\nimport { ToolMappingItem, SensorItem } from \'../../types\';\n\ninterface MapSensorsModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onSave: (mapping: ToolMappingItem) => void;\n  existingMapping?: ToolMappingItem | null;\n  availableSensors?: SensorItem[];\n}\n\nexport const MapSensorsModal: React.FC<MapSensorsModalProps> = ({\n  isOpen,\n  onClose,\n  onSave,\n  existingMapping,\n  availableSensors = [],\n}) => {\n  const [toolName, setToolName] = useState(existingMapping?.toolName || \'Heavy Excavation Monitoring Kit (HE-400)\');\n  const [industryType, setIndustryType] = useState(existingMapping?.industryType || \'Cement & Building Materials\');\n  const [protocol, setProtocol] = useState(existingMapping?.protocol || \'MODBUS TCP\');\n\n  // Track which sensor IDs are active and their active parameter lists\n  const [activeSensorMap, setActiveSensorMap] = useState<Record<string, boolean>>({});\n  const [activeParamsMap, setActiveParamsMap] = useState<Record<string, string[]>>({});\n\n  useEffect(() => {\n    if (existingMapping) {\n      setToolName(existingMapping.toolName);\n      setIndustryType(existingMapping.industryType);\n      setProtocol(existingMapping.protocol);\n\n      const sMap: Record<string, boolean> = {};\n      const pMap: Record<string, string[]> = {};\n      existingMapping.mappedSensors.forEach(s => {\n        sMap[s.name] = true;\n        pMap[s.name] = [...s.parameters];\n      });\n      setActiveSensorMap(sMap);\n      setActiveParamsMap(pMap);\n    } else if (availableSensors.length > 0) {\n      // Default: activate first 2 sensors from Admin\n      const sMap: Record<string, boolean> = {};\n      const pMap: Record<string, string[]> = {};\n      availableSensors.slice(0, 2).forEach(s => {\n        sMap[s.sensorName] = true;\n        pMap[s.sensorName] = s.parameters ? [...s.parameters] : [\'Telemetry Channel 1\'];\n      });\n      setActiveSensorMap(sMap);\n      setActiveParamsMap(pMap);\n    }\n  }, [existingMapping, availableSensors, isOpen]);\n\n  if (!isOpen) return null;\n\n  const toggleSensor = (sensorName: string, defaultParams: string[] = []) => {\n    setActiveSensorMap(prev => {\n      const nextActive = !prev[sensorName];\n      if (nextActive && !activeParamsMap[sensorName]) {\n        setActiveParamsMap(p => ({\n          ...p,\n          [sensorName]: defaultParams.length > 0 ? [...defaultParams] : [\'Telemetry Channel 1\']\n        }));\n      }\n      return { ...prev, [sensorName]: nextActive };\n    });\n  };\n\n  const toggleParam = (sensorName: string, param: string) => {\n    setActiveParamsMap(prev => {\n      const currentList = prev[sensorName] || [];\n      const updated = currentList.includes(param)\n        ? currentList.filter(p => p !== param)\n        : [...currentList, param];\n      return { ...prev, [sensorName]: updated };\n    });\n  };\n\n  // Compute totals\n  const totalActiveSensors = Object.keys(activeSensorMap).filter(k => activeSensorMap[k]).length;\n  const totalActiveParams = Object.keys(activeSensorMap)\n    .filter(k => activeSensorMap[k])\n    .reduce((acc, k) => acc + (activeParamsMap[k]?.length || 0), 0);\n\n  const handleSave = () => {\n    const mappedList = availableSensors\n      .filter(s => activeSensorMap[s.sensorName])\n      .map((s, idx) => ({\n        id: s.id || `SN-ADM-${idx + 1}`,\n        name: s.sensorName,\n        tagColor: (idx % 3 === 0 ? \'teal\' : idx % 3 === 1 ? \'amber\' : \'purple\') as \'teal\' | \'amber\' | \'purple\',\n        parameters: activeParamsMap[s.sensorName] || s.parameters || [\'Real-time Metric\']\n      }));\n\n    const newMapping: ToolMappingItem = {\n      id: existingMapping?.id || `TM-${Date.now()}`,\n      identifier: existingMapping?.identifier || `TL-ADM-${Math.floor(1000 + Math.random() * 9000)}`,\n      toolName: toolName.trim() || \'Custom Telematics Suite\',\n      industryType: industryType,\n      mappedSensors: mappedList,\n      activeParametersCount: totalActiveParams,\n      protocol: protocol,\n      updatedAt: \'Just now\'\n    };\n\n    onSave(newMapping);\n    onClose();\n  };\n\n  return (\n    <div \n      id=\"mappingModal\"\n      className=\"fixed inset-0 bg-[#121212]/60 backdrop-blur-xs flex items-center justify-center z-50 p-4 animate-in fade-in duration-150\" \n      data-purpose=\"tool-sensor-mapping-modal\"\n    >\n      <div className=\"bg-[#FFFFFF] dark:bg-[#1A1918] shadow-2xl border border-[#121212]/20 dark:border-white/20 w-full max-w-2xl overflow-hidden flex flex-col max-h-[90vh] animate-in zoom-in-95 duration-150\">\n        \n        {/* Modal Header */}\n        <div className=\"px-6 py-4 border-b border-[#121212]/10 dark:border-white/10 flex items-center justify-between bg-[#FAF9F2] dark:bg-[#151514]\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-8 h-8 bg-[#121212] text-white dark:bg-[#FDFCF5] dark:text-[#121212] flex items-center justify-center\">\n              <Activity className=\"w-4 h-4 text-[#FF4D00]\" />\n            </div>\n            <div>\n              <h3 className=\"font-serif font-bold text-base text-[#121212] dark:text-[#FDFCF5]\">\n                {existingMapping ? \'Edit Tool Mapping Profile\' : \'Create Tool Mapping from Admin Sensors\'}\n              </h3>\n              <p className=\"text-[11px] text-[#121212]/60 dark:text-[#FDFCF5]/60 font-sans\">\n                Select from Master Admin Sensors to assemble a tool configuration profile\n              </p>\n            </div>\n          </div>\n\n          <button \n            onClick={onClose}\n            className=\"text-[#121212]/50 hover:text-[#FF4D00] dark:text-[#FDFCF5]/50 dark:hover:text-[#FF4D00] p-1.5 transition-colors cursor-pointer\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Modal Body */}\n        <div className=\"p-6 overflow-y-auto space-y-5 text-xs font-sans\">\n          \n          {/* Admin Sync Notice */}\n          <div className=\"p-3 bg-[#FAF9F2] dark:bg-[#151514] border border-[#121212]/15 dark:border-white/15 flex items-center justify-between text-[11px] font-mono text-[#121212]/80 dark:text-[#FDFCF5]/80\">\n            <div className=\"flex items-center gap-2\">\n              <Layers className=\"w-4 h-4 text-[#FF4D00]\" />\n              <span>Catalog Source: <strong>{availableSensors.length} Admin Sensors Available</strong></span>\n            </div>\n            <span className=\"text-[10px] text-[#FF4D00] uppercase font-bold tracking-wider\">Master Data</span>\n          </div>\n\n          {/* Profile Name & Protocol */}\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70 mb-1\">\n                Tool Profile Name <span className=\"text-[#FF4D00]\">*</span>\n              </label>\n              <input \n                type=\"text\" \n                value={toolName}\n                onChange={(e) => setToolName(e.target.value)}\n                placeholder=\"e.g. Crusher Rig Pro Telematics\" \n                className=\"w-full px-3 py-2 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] focus:outline-none focus:border-[#FF4D00]\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70 mb-1\">\n                Fieldbus Protocol <span className=\"text-[#FF4D00]\">*</span>\n              </label>\n              <select \n                value={protocol}\n                onChange={(e) => setProtocol(e.target.value)}\n                className=\"w-full px-3 py-2 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] focus:outline-none focus:border-[#FF4D00] cursor-pointer\"\n              >\n                <option value=\"MODBUS TCP\">MODBUS TCP</option>\n                <option value=\"MODBUS RTU\">MODBUS RTU</option>\n                <option value=\"CAN Bus (J1939)\">CAN Bus (J1939)</option>\n                <option value=\"MQTT Industrial\">MQTT Industrial</option>\n                <option value=\"OPC-UA Edge\">OPC-UA Edge</option>\n              </select>\n            </div>\n          </div>\n\n          {/* Industry Type */}\n          <div>\n            <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70 mb-1\">\n              Industrial Domain\n            </label>\n            <input \n              type=\"text\" \n              value={industryType}\n              onChange={(e) => setIndustryType(e.target.value)}\n              placeholder=\"e.g. Heavy Construction & Mining\" \n              className=\"w-full px-3 py-2 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] focus:outline-none focus:border-[#FF4D00]\"\n            />\n          </div>\n\n          {/* Sensors from Admin */}\n          <div className=\"space-y-3\">\n            <div className=\"flex items-center justify-between\">\n              <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70\">\n                Select Admin Sensors & Parameter Channels\n              </label>\n              <span className=\"text-[11px] font-mono text-[#FF4D00] font-bold\">\n                {totalActiveSensors} Sensors \342\200\242 {totalActiveParams} Parameters Active\n              </span>\n            </div>\n\n            <div className=\"space-y-3 max-h-64 overflow-y-auto pr-1\">\n              {availableSensors.map((sensor) => {\n                const isSensorActive = !!activeSensorMap[sensor.sensorName];\n                const activeParams = activeParamsMap[sensor.sensorName] || [];\n                const sensorParams = sensor.parameters && sensor.parameters.length > 0 \n                  ? sensor.parameters \n                  : [\'Differential Pressure\', \'Telemetry Metric\', \'Temperature Channel\'];\n\n                return (\n                  <div \n                    key={sensor.id}\n                    className={`p-3.5 border transition-all ${\n                      isSensorActive\n                        ? \'border-[#121212] dark:border-white bg-[#FAF9F2] dark:bg-[#151514]\'\n                        : \'border-[#121212]/15 dark:border-white/15 bg-[#FFFFFF] dark:bg-[#1A1918] opacity-75\'\n                    }`}\n                  >\n                    <div className=\"flex items-center justify-between mb-2\">\n                      <button\n                        type=\"button\"\n                        onClick={() => toggleSensor(sensor.sensorName, sensorParams)}\n                        className=\"flex items-center gap-2.5 text-left cursor-pointer\"\n                      >\n                        <div className={`w-4 h-4 border flex items-center justify-center ${\n                          isSensorActive\n                            ? \'bg-[#FF4D00] border-[#FF4D00] text-white\'\n                            : \'border-[#121212]/30 dark:border-white/30\'\n                        }`}>\n                          {isSensorActive && <Check className=\"w-3 h-3\" />}\n                        </div>\n                        <div>\n                          <span className=\"font-serif font-bold text-sm text-[#121212] dark:text-[#FDFCF5]\">\n                            {sensor.sensorName}\n                          </span>\n                          <span className=\"text-[10px] font-mono text-[#121212]/50 dark:text-[#FDFCF5]/50 ml-2\">\n                            ({sensor.industryType})\n                          </span>\n                        </div>\n                      </button>\n\n                      <span className=\"text-[10px] font-mono bg-[#F4F2EA] dark:bg-stone-800 px-2 py-0.5 border border-[#121212]/15 dark:border-white/15\">\n                        {isSensorActive ? `${activeParams.length} Active` : \'Excluded\'}\n                      </span>\n                    </div>\n\n                    {isSensorActive && (\n                      <div className=\"pl-6 pt-2 border-t border-[#121212]/10 dark:border-white/10 flex flex-wrap gap-2\">\n                        {sensorParams.map((param, pIdx) => {\n                          const isParamActive = activeParams.includes(param);\n                          return (\n                            <button\n                              key={pIdx}\n                              type=\"button\"\n                              onClick={() => toggleParam(sensor.sensorName, param)}\n                              className={`px-2 py-1 text-[10px] font-mono border transition-colors cursor-pointer flex items-center gap-1 ${\n                                isParamActive\n                                  ? \'bg-[#121212] text-white dark:bg-white dark:text-[#121212] border-[#121212] dark:border-white\'\n                                  : \'bg-[#FFFFFF] text-[#121212]/60 dark:bg-[#1A1918] dark:text-[#FDFCF5]/60 border-[#121212]/20 dark:border-white/20\'\n                              }`}\n                            >\n                              {isParamActive && <Check className=\"w-2.5 h-2.5 text-[#FF4D00]\" />}\n                              <span>{param}</span>\n                            </button>\n                          );\n                        })}\n                      </div>\n                    )}\n                  </div>\n                );\n              })}\n            </div>\n          </div>\n\n        </div>\n\n        {/* Modal Footer */}\n        <div className=\"px-6 py-4 border-t border-[#121212]/10 dark:border-white/10 bg-[#FAF9F2] dark:bg-[#151514] flex items-center justify-between\">\n          <div className=\"text-[11px] font-mono text-[#121212]/60 dark:text-[#FDFCF5]/60\">\n            Profile saves into master Admin Tool Mappings\n          </div>\n\n          <div className=\"flex items-center gap-2.5\">\n            <button\n              type=\"button\"\n              onClick={onClose}\n              className=\"px-4 py-2 border border-[#121212]/20 text-[#121212] dark:text-[#FDFCF5] text-xs font-sans uppercase font-bold hover:bg-[#F4F2EA] dark:hover:bg-stone-800 transition-colors cursor-pointer\"\n            >\n              Cancel\n            </button>\n            <button\n              type=\"button\"\n              onClick={handleSave}\n              className=\"px-5 py-2 bg-[#121212] text-[#FDFCF5] hover:bg-[#FF4D00] hover:text-white dark:bg-[#FDFCF5] dark:text-[#121212] dark:hover:bg-[#FF4D00] dark:hover:text-white border border-[#121212] dark:border-white text-xs font-sans uppercase font-bold shadow-xs transition-colors cursor-pointer\"\n            >\n              Save Tool Mapping\n            </button>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  );\n};\n"
    }
