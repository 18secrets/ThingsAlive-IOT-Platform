      target_content: "interface PlantViewProps {\n  items: PlantItem[];\n}\n\nexport const PlantView: React.FC<PlantViewProps> = ({ items }) => {\n  return (\n    <div className=\"space-y-4\">\n      <div className=\"bg-[#FFFFFF] dark:bg-[#1A1918] p-6 border border-[#121212]/15 dark:border-white/15 shadow-xs\">\n        <div className=\"flex items-center justify-between mb-6 pb-4 border-b border-[#121212]/10 dark:border-white/10\">\n          <div>\n            <h3 className=\"font-serif font-bold text-[#121212] dark:text-[#FDFCF5] text-xl\">Manufacturing & Infrastructure Plants</h3>\n            <p className=\"text-xs text-[#121212]/60 dark:text-[#FDFCF5]/60 mt-0.5 font-sans\">Regional production facilities, maintenance depots, and assembly sites</p>\n          </div>\n          <span className=\"text-[10px] font-sans font-bold uppercase tracking-[0.14em] px-3 py-1 bg-[#121212] text-white dark:bg-white dark:text-[#121212] border border-[#121212] dark:border-white\">\n            {items.length} Registered Plants\n          </span>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n          {items.map((plant) => (\n            <div key={plant.id} className=\"p-5 border border-[#121212]/15 dark:border-white/15 bg-[#FDFCF5] dark:bg-[#151514] hover:border-[#121212] dark:hover:border-white transition-all space-y-3\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"font-mono text-xs font-bold text-[#FF4D00]\">#{plant.code}</span>\n                <span className=\"flex items-center gap-1 text-[11px] text-[#121212]/50 dark:text-[#FDFCF5]/50 font-sans\">\n                  <MapPin className=\"w-3.5 h-3.5 text-[#FF4D00]\" />\n                  {plant.location}\n                </span>\n              </div>\n              <h4 className=\"font-serif font-bold text-[#121212] dark:text-[#FDFCF5] text-base\">{plant.name}</h4>\n              <div className=\"pt-3 border-t border-[#121212]/10 dark:border-white/10 flex justify-between text-xs text-[#121212]/60 dark:text-[#FDFCF5]/60 font-mono text-[11px]\">\n                <span>{plant.equipmentCount} Equipment Active</span>\n                <span>{plant.activeLines} Lines</span>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};"
      replacement_content: "interface PlantViewProps {\n  items: PlantItem[];\n  onAddPlant?: (plant: PlantItem) => void;\n}\n\nexport const PlantView: React.FC<PlantViewProps> = ({ items, onAddPlant }) => {\n  const [isModalOpen, setIsModalOpen] = React.useState(false);\n  const [name, setName] = React.useState(\'\');\n  const [location, setLocation] = React.useState(\'\');\n  const [code, setCode] = React.useState(\'\');\n  const [activeLines, setActiveLines] = React.useState(4);\n\n  const handleCreatePlant = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!name.trim()) return;\n\n    const newPlant: PlantItem = {\n      id: `PLANT-${Date.now().toString().slice(-4)}`,\n      name: name.trim(),\n      location: location.trim() || \'Industrial Complex\',\n      code: (code.trim() || name.slice(0, 3).toUpperCase()) + `-${Math.floor(10 + Math.random() * 90)}`,\n      equipmentCount: 0,\n      activeLines: Number(activeLines) || 2,\n    };\n\n    if (onAddPlant) {\n      onAddPlant(newPlant);\n    }\n    setName(\'\');\n    setLocation(\'\');\n    setCode(\'\');\n    setIsModalOpen(false);\n  };\n\n  return (\n    <div className=\"space-y-4\">\n      <div className=\"bg-[#FFFFFF] dark:bg-[#1A1918] p-6 border border-[#121212]/15 dark:border-white/15 shadow-xs\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between mb-6 pb-4 border-b border-[#121212]/10 dark:border-white/10 gap-3\">\n          <div>\n            <h3 className=\"font-serif font-bold text-[#121212] dark:text-[#FDFCF5] text-xl\">Manufacturing & Infrastructure Plants</h3>\n            <p className=\"text-xs text-[#121212]/60 dark:text-[#FDFCF5]/60 mt-0.5 font-sans\">Regional production facilities, maintenance depots, and assembly sites</p>\n          </div>\n          <div className=\"flex items-center gap-3\">\n            <span className=\"text-[10px] font-sans font-bold uppercase tracking-[0.14em] px-3 py-1 bg-[#F4F2EA] dark:bg-stone-800 text-[#121212] dark:text-[#FDFCF5] border border-[#121212]/20 dark:border-white/20\">\n              {items.length} Registered Plants\n            </span>\n            {onAddPlant && (\n              <button\n                onClick={() => setIsModalOpen(true)}\n                className=\"px-3.5 py-1.5 bg-[#121212] text-[#FDFCF5] hover:bg-[#FF4D00] hover:text-white dark:bg-[#FDFCF5] dark:text-[#121212] dark:hover:bg-[#FF4D00] dark:hover:text-white border border-[#121212] dark:border-white text-xs font-sans uppercase tracking-[0.14em] font-bold transition-colors cursor-pointer\"\n              >\n                + Add Plant\n              </button>\n            )}\n          </div>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n          {items.map((plant) => (\n            <div key={plant.id} className=\"p-5 border border-[#121212]/15 dark:border-white/15 bg-[#FDFCF5] dark:bg-[#151514] hover:border-[#121212] dark:hover:border-white transition-all space-y-3\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"font-mono text-xs font-bold text-[#FF4D00]\">#{plant.code}</span>\n                <span className=\"flex items-center gap-1 text-[11px] text-[#121212]/50 dark:text-[#FDFCF5]/50 font-sans\">\n                  <MapPin className=\"w-3.5 h-3.5 text-[#FF4D00]\" />\n                  {plant.location}\n                </span>\n              </div>\n              <h4 className=\"font-serif font-bold text-[#121212] dark:text-[#FDFCF5] text-base\">{plant.name}</h4>\n              <div className=\"pt-3 border-t border-[#121212]/10 dark:border-white/10 flex justify-between text-xs text-[#121212]/60 dark:text-[#FDFCF5]/60 font-mono text-[11px]\">\n                <span>{plant.equipmentCount} Equipment Active</span>\n                <span>{plant.activeLines} Lines</span>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* Add Plant Modal */}\n      {isModalOpen && (\n        <div className=\"fixed inset-0 bg-[#121212]/60 backdrop-blur-xs flex items-center justify-center p-4 z-50 animate-in fade-in duration-150\">\n          <div className=\"bg-[#FFFFFF] dark:bg-[#1A1918] border border-[#121212]/20 dark:border-white/20 w-full max-w-md shadow-2xl p-6 space-y-4\">\n            <div className=\"flex items-center justify-between pb-3 border-b border-[#121212]/10 dark:border-white/10\">\n              <h4 className=\"font-serif font-bold text-base text-[#121212] dark:text-[#FDFCF5]\">\n                Register New Plant / Depot\n              </h4>\n              <button \n                onClick={() => setIsModalOpen(false)}\n                className=\"text-[#121212]/40 hover:text-[#FF4D00] text-sm\"\n              >\n                \342\234\225\n              </button>\n            </div>\n\n            <form onSubmit={handleCreatePlant} className=\"space-y-3.5 text-xs font-sans\">\n              <div>\n                <label className=\"block text-[10px] uppercase font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70 mb-1\">\n                  Plant Name <span className=\"text-[#FF4D00]\">*</span>\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  value={name}\n                  onChange={(e) => setName(e.target.value)}\n                  placeholder=\"e.g. Hyderabad Central Works\"\n                  className=\"w-full px-3 py-2 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] focus:border-[#FF4D00] outline-none\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-[10px] uppercase font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70 mb-1\">\n                  Location (City, State)\n                </label>\n                <input\n                  type=\"text\"\n                  value={location}\n                  onChange={(e) => setLocation(e.target.value)}\n                  placeholder=\"e.g. Hyderabad, Telangana\"\n                  className=\"w-full px-3 py-2 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] focus:border-[#FF4D00] outline-none\"\n                />\n              </div>\n\n              <div className=\"grid grid-cols-2 gap-3\">\n                <div>\n                  <label className=\"block text-[10px] uppercase font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70 mb-1\">\n                    Plant Code\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={code}\n                    onChange={(e) => setCode(e.target.value)}\n                    placeholder=\"e.g. HYD-WKS\"\n                    className=\"w-full px-3 py-2 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] font-mono focus:border-[#FF4D00] outline-none\"\n                  />\n                </div>\n                <div>\n                  <label className=\"block text-[10px] uppercase font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70 mb-1\">\n                    Active Lines\n                  </label>\n                  <input\n                    type=\"number\"\n                    value={activeLines}\n                    onChange={(e) => setActiveLines(Number(e.target.value))}\n                    min={1}\n                    className=\"w-full px-3 py-2 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] font-mono focus:border-[#FF4D00] outline-none\"\n                  />\n                </div>\n              </div>\n\n              <div className=\"pt-3 border-t border-[#121212]/10 dark:border-white/10 flex items-center justify-end gap-2\">\n                <button\n                  type=\"button\"\n                  onClick={() => setIsModalOpen(false)}\n                  className=\"px-4 py-2 border border-[#121212]/20 text-[#121212] dark:text-[#FDFCF5] text-xs uppercase font-bold hover:bg-[#F4F2EA] dark:hover:bg-stone-800\"\n                >\n                  Cancel\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"px-5 py-2 bg-[#121212] text-white hover:bg-[#FF4D00] dark:bg-white dark:text-[#121212] dark:hover:bg-[#FF4D00] dark:hover:text-white text-xs uppercase font-bold transition-colors\"\n                >\n                  Register Plant\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};"
    }
