    content: "@import \"tailwindcss\";\n\n@layer base {\n  body {\n    font-family: \'Inter\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n    background-color: #FDFCF5;\n    color: #121212;\n  }\n}\n\n.font-serif {\n  font-family: \'Playfair Display\', Georgia, serif;\n}\n\n.font-sans {\n  font-family: \'Inter\', sans-serif;\n}\n\n.border-ink {\n  border-color: #121212;\n}\n\n.dark .border-ink {\n  border-color: rgba(253, 252, 245, 0.25);\n}\n\n.border-ink-subtle {\n  border-color: rgba(18, 18, 18, 0.12);\n}\n\n.dark .border-ink-subtle {\n  border-color: rgba(253, 252, 245, 0.12);\n}\n\n.bg-accent {\n  background-color: #FF4D00;\n}\n\n.text-accent {\n  color: #FF4D00;\n}\n\n.border-accent {\n  border-color: #FF4D00;\n}\n\n/* Crisp architectural scrollbars */\n::-webkit-scrollbar {\n  width: 5px;\n  height: 5px;\n}\n\n::-webkit-scrollbar-track {\n  background: #F4F2EA;\n}\n\n.dark ::-webkit-scrollbar-track {\n  background: #1A1918;\n}\n\n::-webkit-scrollbar-thumb {\n  background: #121212;\n}\n\n.dark ::-webkit-scrollbar-thumb {\n  background: #FDFCF5;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: #FF4D00;\n}\n\n.dark ::-webkit-scrollbar-thumb:hover {\n  background: #FF4D00;\n}\n\n.custom-shadow-panel {\n  box-shadow: 0 2px 0 0 #121212;\n}\n\n.dark .custom-shadow-panel {\n  box-shadow: 0 2px 0 0 rgba(253, 252, 245, 0.2);\n}\n\n"
    raw_content: "@import \"tailwindcss\";\n\n@layer base {\n  body {\n    font-family: \'Inter\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n    background-color: #FDFCF5;\n    color: #121212;\n  }\n}\n\n.font-serif {\n  font-family: \'Playfair Display\', Georgia, serif;\n}\n\n.font-sans {\n  font-family: \'Inter\', sans-serif;\n}\n\n.border-ink {\n  border-color: #121212;\n}\n\n.dark .border-ink {\n  border-color: rgba(253, 252, 245, 0.25);\n}\n\n.border-ink-subtle {\n  border-color: rgba(18, 18, 18, 0.12);\n}\n\n.dark .border-ink-subtle {\n  border-color: rgba(253, 252, 245, 0.12);\n}\n\n.bg-accent {\n  background-color: #FF4D00;\n}\n\n.text-accent {\n  color: #FF4D00;\n}\n\n.border-accent {\n  border-color: #FF4D00;\n}\n\n/* Crisp architectural scrollbars */\n::-webkit-scrollbar {\n  width: 5px;\n  height: 5px;\n}\n\n::-webkit-scrollbar-track {\n  background: #F4F2EA;\n}\n\n.dark ::-webkit-scrollbar-track {\n  background: #1A1918;\n}\n\n::-webkit-scrollbar-thumb {\n  background: #121212;\n}\n\n.dark ::-webkit-scrollbar-thumb {\n  background: #FDFCF5;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: #FF4D00;\n}\n\n.dark ::-webkit-scrollbar-thumb:hover {\n  background: #FF4D00;\n}\n\n.custom-shadow-panel {\n  box-shadow: 0 2px 0 0 #121212;\n}\n\n.dark .custom-shadow-panel {\n  box-shadow: 0 2px 0 0 rgba(253, 252, 245, 0.2);\n}\n\n"
