  file_change {
    absolute_path_uri: "file:///src/components/admin/MapSensorsModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { X, Check, Radio } from \'lucide-react\';\nimport { ToolMappingItem } from \'../../types\';\n\ninterface MapSensorsModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onSave: (mapping: ToolMappingItem) => void;\n  existingMapping?: ToolMappingItem | null;\n}\n\nexport const MapSensorsModal: React.FC<MapSensorsModalProps> = ({\n  isOpen,\n  onClose,\n  onSave,\n  existingMapping,\n}) => {\n  const [toolName, setToolName] = useState(existingMapping?.toolName || \'Kiln Drive Monitoring Kit (KM-400)\');\n  const [industryType, setIndustryType] = useState(existingMapping?.industryType || \'Cement & Building Materials\');\n  const [protocol, setProtocol] = useState(existingMapping?.protocol || \'MODBUS TCP / RTU\');\n\n  // Sensor selections\n  const [sensor1Active, setSensor1Active] = useState(true);\n  const [s1Param1, setS1Param1] = useState(true);\n  const [s1Param2, setS1Param2] = useState(true);\n  const [s1Param3, setS1Param3] = useState(true);\n\n  const [sensor2Active, setSensor2Active] = useState(true);\n  const [s2Param1, setS2Param1] = useState(true);\n  const [s2Param2, setS2Param2] = useState(true);\n  const [s2Param3, setS2Param3] = useState(true);\n\n  const [sensor3Active, setSensor3Active] = useState(false);\n  const [s3Param1, setS3Param1] = useState(false);\n  const [s3Param2, setS3Param2] = useState(false);\n\n  if (!isOpen) return null;\n\n  // Calculate selected counts\n  const totalSensors = (sensor1Active ? 1 : 0) + (sensor2Active ? 1 : 0) + (sensor3Active ? 1 : 0);\n  const totalParams = \n    (sensor1Active ? ((s1Param1 ? 1 : 0) + (s1Param2 ? 1 : 0) + (s1Param3 ? 1 : 0)) : 0) +\n    (sensor2Active ? ((s2Param1 ? 1 : 0) + (s2Param2 ? 1 : 0) + (s2Param3 ? 1 : 0)) : 0) +\n    (sensor3Active ? ((s3Param1 ? 1 : 0) + (s3Param2 ? 1 : 0)) : 0);\n\n  const handleSave = () => {\n    const mappedList = [];\n    if (sensor1Active) {\n      mappedList.push({\n        id: \'SN-CBM-001\',\n        name: \'Dust_Collector_Monitoring\',\n        tagColor: \'blue\' as const,\n        parameters: [\n          ...(s1Param1 ? [\'Differential Pressure\'] : []),\n          ...(s1Param2 ? [\'Opacity Percentage\'] : []),\n          ...(s1Param3 ? [\'Exhaust Flow Rate\'] : []),\n        ]\n      });\n    }\n    if (sensor2Active) {\n      mappedList.push({\n        id: \'SN-CBM-004\',\n        name: \'Cement_Mill_Monitoring\',\n        tagColor: \'teal\' as const,\n        parameters: [\n          ...(s2Param1 ? [\'Peak Velocity (mm/s)\'] : []),\n          ...(s2Param2 ? [\'RMS Acceleration (g)\'] : []),\n          ...(s2Param3 ? [\'Bearing Surface Temp\'] : []),\n        ]\n      });\n    }\n    if (sensor3Active) {\n      mappedList.push({\n        id: \'SN-CBM-002\',\n        name: \'Conveyor_Belt_Speed & Tension\',\n        tagColor: \'amber\' as const,\n        parameters: [\n          ...(s3Param1 ? [\'Belt Speed\'] : []),\n          ...(s3Param2 ? [\'Tension Transducer\'] : []),\n        ]\n      });\n    }\n\n    const newMapping: ToolMappingItem = {\n      id: existingMapping?.id || `TM-${Date.now()}`,\n      identifier: existingMapping?.identifier || `TL-GEN-${Math.floor(1000 + Math.random() * 9000)}`,\n      toolName: toolName || \'Custom Telematics Suite\',\n      industryType: industryType,\n      mappedSensors: mappedList,\n      activeParametersCount: totalParams,\n      protocol: protocol,\n      updatedAt: \'09-03-2026\'\n    };\n\n    onSave(newMapping);\n    onClose();\n  };\n\n  return (\n    <div \n      id=\"mappingModal\"\n      className=\"fixed inset-0 bg-slate-900/40 backdrop-blur-[2px] flex items-center justify-center z-50 transition-opacity duration-200 p-4\" \n      data-purpose=\"tool-sensor-mapping-modal\"\n    >\n      <div className=\"bg-white dark:bg-slate-800 rounded-xl shadow-2xl border border-slate-200 dark:border-slate-700 w-full max-w-2xl overflow-hidden flex flex-col max-h-[90vh] animate-in fade-in zoom-in-95 duration-150\">\n        \n        {/* Modal Header */}\n        <div className=\"px-6 py-4 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between bg-slate-50/75 dark:bg-slate-800/90\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"p-2 rounded-lg bg-sky-100 dark:bg-sky-950 text-[#0284c7] dark:text-sky-400\">\n              <svg className=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path d=\"M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z\" strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" />\n              </svg>\n            </div>\n            <div>\n              <h3 className=\"font-semibold text-slate-900 dark:text-white text-base\">\n                Map Sensors to Tool Configuration\n              </h3>\n              <p className=\"text-xs text-slate-500 dark:text-slate-400\">\n                Associate industrial telemetry sensors & parameters with specific tooling profiles\n              </p>\n            </div>\n          </div>\n          <button \n            id=\"closeModalBtn\"\n            onClick={onClose}\n            className=\"text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1.5 rounded-lg hover:bg-slate-200/60 dark:hover:bg-slate-700 transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Modal Body (Scrollable form) */}\n        <div className=\"p-6 overflow-y-auto space-y-5 text-sm\">\n          \n          {/* Form Row: Name & Industry */}\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5\">\n                Tool Name / Model\n              </label>\n              <input \n                type=\"text\" \n                value={toolName}\n                onChange={(e) => setToolName(e.target.value)}\n                placeholder=\"e.g. Crusher Rig v2\" \n                className=\"w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-white rounded-lg px-3 py-2 focus:ring-2 focus:ring-[#0284c7] focus:outline-none\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5\">\n                Target Industry Type\n              </label>\n              <select \n                value={industryType}\n                onChange={(e) => setIndustryType(e.target.value)}\n                className=\"w-full text-sm border border-slate-300 dark:border-slate-600 dark:bg-slate-700 dark:text-white rounded-lg px-3 py-2 bg-white focus:ring-2 focus:ring-[#0284c7] focus:outline-none\"\n              >\n                <option>Cement & Building Materials</option>\n                <option>Transport</option>\n                <option>Automotive</option>\n                <option>Power & Energy</option>\n                <option>Mining & Aggregates</option>\n              </select>\n            </div>\n          </div>\n\n          {/* Form Row: Communication Protocol */}\n          <div>\n            <label className=\"block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5\">\n              Default Telematics Protocol\n            </label>\n            <div className=\"grid grid-cols-1 md:grid-cols-3 gap-2 text-xs\">\n              <label \n                className={`border rounded-lg p-2.5 flex items-center gap-2 cursor-pointer font-medium transition-colors ${\n                  protocol === \'MODBUS TCP / RTU\' \n                    ? \'border-sky-400 bg-sky-50 dark:bg-sky-950/60 text-sky-800 dark:text-sky-300\' \n                    : \'border-slate-200 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-700/50 text-slate-700 dark:text-slate-300\'\n                }`}\n              >\n                <input \n                  type=\"radio\" \n                  name=\"protocol\" \n                  checked={protocol === \'MODBUS TCP / RTU\'} \n                  onChange={() => setProtocol(\'MODBUS TCP / RTU\')}\n                  className=\"text-[#0284c7] focus:ring-sky-500\" \n                />\n                MODBUS TCP / RTU\n              </label>\n\n              <label \n                className={`border rounded-lg p-2.5 flex items-center gap-2 cursor-pointer transition-colors ${\n                  protocol === \'CAN-bus / J1939\' \n                    ? \'border-sky-400 bg-sky-50 dark:bg-sky-950/60 text-sky-800 dark:text-sky-300 font-medium\' \n                    : \'border-slate-200 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-700/50 text-slate-700 dark:text-slate-300\'\n                }`}\n              >\n                <input \n                  type=\"radio\" \n                  name=\"protocol\" \n                  checked={protocol === \'CAN-bus / J1939\'} \n                  onChange={() => setProtocol(\'CAN-bus / J1939\')}\n                  className=\"text-[#0284c7] focus:ring-sky-500\" \n                />\n                CAN-bus / J1939\n              </label>\n\n              <label \n                className={`border rounded-lg p-2.5 flex items-center gap-2 cursor-pointer transition-colors ${\n                  protocol === \'EtherNet / IP (CIP)\' \n                    ? \'border-sky-400 bg-sky-50 dark:bg-sky-950/60 text-sky-800 dark:text-sky-300 font-medium\' \n                    : \'border-slate-200 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-700/50 text-slate-700 dark:text-slate-300\'\n                }`}\n              >\n                <input \n                  type=\"radio\" \n                  name=\"protocol\" \n                  checked={protocol === \'EtherNet / IP (CIP)\'} \n                  onChange={() => setProtocol(\'EtherNet / IP (CIP)\')}\n                  className=\"text-[#0284c7] focus:ring-sky-500\" \n                />\n                EtherNet / IP (CIP)\n              </label>\n            </div>\n          </div>\n\n          {/* Sensor Association & Parameter Mapping Section */}\n          <div>\n            <div className=\"flex items-center justify-between mb-2\">\n              <label className=\"text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider\">\n                Select Sensors & Map Active Telemetry Channels\n              </label>\n              <span className=\"text-xs text-sky-600 dark:text-sky-400 font-medium\">\n                {totalSensors} Sensors selected ({totalParams} Parameters)\n              </span>\n            </div>\n\n            <div className=\"border border-slate-200 dark:border-slate-700 rounded-lg divide-y divide-slate-200 dark:divide-slate-700 bg-white dark:bg-slate-800\">\n              \n              {/* Sensor 1 (Dust_Collector_Monitoring) */}\n              <div className={`p-3.5 space-y-2.5 ${sensor1Active ? \'bg-slate-50/70 dark:bg-slate-700/30\' : \'\'}`}>\n                <div className=\"flex items-center justify-between\">\n                  <label className=\"flex items-center gap-2.5 cursor-pointer font-medium text-slate-800 dark:text-slate-200 text-sm\">\n                    <input \n                      type=\"checkbox\" \n                      checked={sensor1Active} \n                      onChange={(e) => setSensor1Active(e.target.checked)}\n                      className=\"rounded text-[#0284c7] focus:ring-sky-500 h-4 w-4\" \n                    />\n                    <span>Dust_Collector_Monitoring (Optical & Particulate)</span>\n                  </label>\n                  <span className=\"text-xs text-slate-500 dark:text-slate-400 bg-white dark:bg-slate-700 px-2 py-0.5 rounded border border-slate-200 dark:border-slate-600\">\n                    ID: SN-CBM-001\n                  </span>\n                </div>\n\n                {sensor1Active && (\n                  <div className=\"pl-6 grid grid-cols-1 sm:grid-cols-3 gap-2 text-xs animate-in fade-in\">\n                    <label className=\"flex items-center gap-2 text-slate-700 dark:text-slate-300 cursor-pointer\">\n                      <input \n                        type=\"checkbox\" \n                        checked={s1Param1} \n                        onChange={(e) => setS1Param1(e.target.checked)}\n                        className=\"rounded text-[#0284c7] h-3.5 w-3.5\" \n                      />\n                      Differential Pressure\n                    </label>\n                    <label className=\"flex items-center gap-2 text-slate-700 dark:text-slate-300 cursor-pointer\">\n                      <input \n                        type=\"checkbox\" \n                        checked={s1Param2} \n                        onChange={(e) => setS1Param2(e.target.checked)}\n                        className=\"rounded text-[#0284c7] h-3.5 w-3.5\" \n                      />\n                      Opacity Percentage\n                    </label>\n                    <label className=\"flex items-center gap-2 text-slate-700 dark:text-slate-300 cursor-pointer\">\n                      <input \n                        type=\"checkbox\" \n                        checked={s1Param3} \n                        onChange={(e) => setS1Param3(e.target.checked)}\n                        className=\"rounded text-[#0284c7] h-3.5 w-3.5\" \n                      />\n                      Exhaust Flow Rate\n                    </label>\n                  </div>\n                )}\n              </div>\n\n              {/* Sensor 2 (Cement_Mill_Monitoring) */}\n              <div className={`p-3.5 space-y-2.5 ${sensor2Active ? \'bg-slate-50/70 dark:bg-slate-700/30\' : \'\'}`}>\n                <div className=\"flex items-center justify-between\">\n                  <label className=\"flex items-center gap-2.5 cursor-pointer font-medium text-slate-800 dark:text-slate-200 text-sm\">\n                    <input \n                      type=\"checkbox\" \n                      checked={sensor2Active} \n                      onChange={(e) => setSensor2Active(e.target.checked)}\n                      className=\"rounded text-[#0284c7] focus:ring-sky-500 h-4 w-4\" \n                    />\n                    <span>Cement_Mill_Monitoring (Vibration & Acoustic)</span>\n                  </label>\n                  <span className=\"text-xs text-slate-500 dark:text-slate-400 bg-white dark:bg-slate-700 px-2 py-0.5 rounded border border-slate-200 dark:border-slate-600\">\n                    ID: SN-CBM-004\n                  </span>\n                </div>\n\n                {sensor2Active && (\n                  <div className=\"pl-6 grid grid-cols-1 sm:grid-cols-3 gap-2 text-xs animate-in fade-in\">\n                    <label className=\"flex items-center gap-2 text-slate-700 dark:text-slate-300 cursor-pointer\">\n                      <input \n                        type=\"checkbox\" \n                        checked={s2Param1} \n                        onChange={(e) => setS2Param1(e.target.checked)}\n                        className=\"rounded text-[#0284c7] h-3.5 w-3.5\" \n                      />\n                      Peak Velocity (mm/s)\n                    </label>\n                    <label className=\"flex items-center gap-2 text-slate-700 dark:text-slate-300 cursor-pointer\">\n                      <input \n                        type=\"checkbox\" \n                        checked={s2Param2} \n                        onChange={(e) => setS2Param2(e.target.checked)}\n                        className=\"rounded text-[#0284c7] h-3.5 w-3.5\" \n                      />\n                      RMS Acceleration (g)\n                    </label>\n                    <label className=\"flex items-center gap-2 text-slate-700 dark:text-slate-300 cursor-pointer\">\n                      <input \n                        type=\"checkbox\" \n                        checked={s2Param3} \n                        onChange={(e) => setS2Param3(e.target.checked)}\n                        className=\"rounded text-[#0284c7] h-3.5 w-3.5\" \n                      />\n                      Bearing Surface Temp\n                    </label>\n                  </div>\n                )}\n              </div>\n\n              {/* Sensor 3 (Conveyor_Belt_Speed & Tension) */}\n              <div className={`p-3.5 space-y-2.5 ${sensor3Active ? \'bg-slate-50/70 dark:bg-slate-700/30\' : \'\'}`}>\n                <div className=\"flex items-center justify-between\">\n                  <label className=\"flex items-center gap-2.5 cursor-pointer font-medium text-slate-800 dark:text-slate-200 text-sm\">\n                    <input \n                      type=\"checkbox\" \n                      checked={sensor3Active} \n                      onChange={(e) => setSensor3Active(e.target.checked)}\n                      className=\"rounded text-[#0284c7] focus:ring-sky-500 h-4 w-4\" \n                    />\n                    <span>Conveyor_Belt_Speed & Tension Transducer</span>\n                  </label>\n                  <span className=\"text-xs text-slate-400 bg-white dark:bg-slate-700 px-2 py-0.5 rounded border border-slate-200 dark:border-slate-600\">\n                    ID: SN-CBM-002\n                  </span>\n                </div>\n\n                {sensor3Active && (\n                  <div className=\"pl-6 grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs animate-in fade-in\">\n                    <label className=\"flex items-center gap-2 text-slate-700 dark:text-slate-300 cursor-pointer\">\n                      <input \n                        type=\"checkbox\" \n                        checked={s3Param1} \n                        onChange={(e) => setS3Param1(e.target.checked)}\n                        className=\"rounded text-[#0284c7] h-3.5 w-3.5\" \n                      />\n                      Belt Speed (m/s)\n                    </label>\n                    <label className=\"flex items-center gap-2 text-slate-700 dark:text-slate-300 cursor-pointer\">\n                      <input \n                        type=\"checkbox\" \n                        checked={s3Param2} \n                        onChange={(e) => setS3Param2(e.target.checked)}\n                        className=\"rounded text-[#0284c7] h-3.5 w-3.5\" \n                      />\n                      Tension Transducer (kN)\n                    </label>\n                  </div>\n                )}\n              </div>\n\n            </div>\n          </div>\n\n        </div>\n\n        {/* Modal Footer Action Bar */}\n        <div className=\"px-6 py-3.5 border-t border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/80 flex items-center justify-end gap-2.5\">\n          <button \n            id=\"cancelModalBtn\"\n            onClick={onClose}\n            className=\"px-4 py-2 text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-200/80 dark:hover:bg-slate-700 rounded-lg transition-colors\"\n          >\n            Cancel\n          </button>\n          <button \n            id=\"saveMappingBtn\"\n            onClick={handleSave}\n            className=\"px-5 py-2 text-sm font-medium text-white bg-[#0284c7] hover:bg-[#0369a1] rounded-lg shadow-sm transition-colors flex items-center gap-1.5\"\n          >\n            <Check className=\"w-4 h-4\" />\n            Save Mapping Profile\n          </button>\n        </div>\n\n      </div>\n    </div>\n  );\n};\n"
