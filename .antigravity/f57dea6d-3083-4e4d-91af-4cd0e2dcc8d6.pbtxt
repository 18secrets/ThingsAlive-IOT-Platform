      original_name: "install_applet_dependencies"
    }
    tools {
      name: "install_applet_package"
      description: "Install npm packages to the applet. This adds the packages to package.json and installs them.\n\nIMPORTANT: You MUST call this tool BEFORE writing any import statements for the packages.\nYou MAY parallelize this with code edits (\'write_to_file\', \'replace_file_content\'), but you MUST NOT run \'compile_applet\' or \'restart_dev_server\' until installation completes.\n\nUse this tool when you need to add new dependencies that aren\'t already in package.json.\n\nNOTE: providing the \'IsDevDependency: true\' argument will install the packages as dev dependencies (using the -D flag in npm install).\n\nExample: To install lodash, call this tool with PackageNames: [\"lodash\"]\nExample: To install multiple packages, call this tool with PackageNames: [\"lodash\", \"axios\"]\nExample: To install typescript as a dev dependency, call this tool with PackageNames: [\"typescript\"], IsDevDependency: true\n\nIf the installation fails, you will receive an error message explaining what went wrong."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"PackageNames\":{\"items\":{\"type\":\"string\"},\"type\":\"array\",\"description\":\"The names of the npm packages to install (e.g., [\'lodash\', \'react-router\'])\"},\"IsDevDependency\":{\"type\":\"boolean\",\"description\":\"Whether to install as dev dependencies using -D flag. Set to true for build tools like typescript, eslint, or @types/* packages. Defaults to false.\"},\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing what this tool call is about. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'File edit\', \'Command execution\', \'Semantic search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word summary of what this tool is doing. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Editing file\', \'Viewing file\', \'Running command\', \'Semantic searching\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"PackageNames\",\"toolSummary\",\"toolAction\"]}"
      original_name: "install_applet_package"
    }
    tools {
      name: "restart_dev_server"
      description: "Restarts the Node.js development server. Use this tool when:\n- The dev server appears stale, unresponsive, or stuck\n- After updating the \"dev\" script in package.json\n- After changing server configuration or environment setup\n- When error messages suggest the server is in a bad state\nThis tool stops the current dev server process and starts a fresh one."
      json_schema_string: "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"toolSummary\":{\"type\":\"string\",\"description\":\"Brief 2-5 word noun phrase describing what this tool call is about. Capitalize like a sentence. Some examples: \'Directory analysis\', \'Web search\', \'File edit\', \'Command execution\', \'Semantic search\'.\"},\"toolAction\":{\"type\":\"string\",\"description\":\"Brief 2-5 word summary of what this tool is doing. Capitalize like a sentence. Some examples: \'Analyzing directory\', \'Searching the web\', \'Editing file\', \'Viewing file\', \'Running command\', \'Semantic searching\'.\"}},\"additionalProperties\":false,\"type\":\"object\",\"required\":[\"toolSummary\",\"toolAction\"]}"
