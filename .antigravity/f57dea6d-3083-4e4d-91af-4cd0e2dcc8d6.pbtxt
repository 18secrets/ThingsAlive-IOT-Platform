        lines {
          text: "              {availableSensors.map((sensor) => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                const isSensorActive = !!activeSensorMap[sensor.sensorName];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                const activeParams = activeParamsMap[sensor.sensorName] || [];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                const sensorParams = sensor.parameters && sensor.parameters.length > 0 "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  ? sensor.parameters "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
