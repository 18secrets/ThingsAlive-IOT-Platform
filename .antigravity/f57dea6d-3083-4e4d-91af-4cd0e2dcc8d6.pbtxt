        target_content: "@import \"tailwindcss\";\n\n@layer base {\n  body {\n    font-family: \'Inter\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n    background-color: #FDFCF5;\n    color: #121212;\n  }\n}\n\n.font-serif {\n  font-family: \'Playfair Display\', Georgia, serif;\n}\n\n.font-sans {\n  font-family: \'Inter\', sans-serif;\n}\n\n.border-ink {\n  border-color: #121212;\n}\n\n.dark .border-ink {\n  border-color: rgba(253, 252, 245, 0.25);\n}\n\n.border-ink-subtle {\n  border-color: rgba(18, 18, 18, 0.12);\n}\n\n.dark .border-ink-subtle {\n  border-color: rgba(253, 252, 245, 0.12);\n}\n\n.bg-accent {\n  background-color: #FF4D00;\n}\n\n.text-accent {\n  color: #FF4D00;\n}\n\n.border-accent {\n  border-color: #FF4D00;\n}\n\n/* Crisp architectural scrollbars */\n::-webkit-scrollbar {\n  width: 5px;\n  height: 5px;\n}\n\n::-webkit-scrollbar-track {\n  background: #F4F2EA;\n}\n\n.dark ::-webkit-scrollbar-track {\n  background: #1A1918;\n}\n\n::-webkit-scrollbar-thumb {\n  background: #121212;\n}\n\n.dark ::-webkit-scrollbar-thumb {\n  background: #FDFCF5;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: #FF4D00;\n}\n\n.dark ::-webkit-scrollbar-thumb:hover {\n  background: #FF4D00;\n}\n\n.custom-shadow-panel {\n  box-shadow: 0 2px 0 0 #121212;\n}\n\n.dark .custom-shadow-panel {\n  box-shadow: 0 2px 0 0 rgba(253, 252, 245, 0.2);\n}"
        replacement_content: "@import \"tailwindcss\";\n\n@layer base {\n  body {\n    font-family: -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, Helvetica, Arial, sans-serif;\n    background-color: #F4F7FB;\n    color: #1E293B;\n  }\n}\n\n.font-sans {\n  font-family: -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, Helvetica, Arial, sans-serif;\n}\n\n.font-serif {\n  font-family: -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, Helvetica, Arial, sans-serif;\n}\n\n.border-ink {\n  border-color: #E2E8F0;\n}\n\n.dark .border-ink {\n  border-color: #334155;\n}\n\n.border-ink-subtle {\n  border-color: #F1F5F9;\n}\n\n.dark .border-ink-subtle {\n  border-color: #1E293B;\n}\n\n.bg-accent {\n  background-color: #0B7285;\n}\n\n.text-accent {\n  color: #0284C7;\n}\n\n.border-accent {\n  border-color: #0284C7;\n}\n\n/* Scrollbars */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n\n::-webkit-scrollbar-track {\n  background: #F1F5F9;\n}\n\n.dark ::-webkit-scrollbar-track {\n  background: #1E293B;\n}\n\n::-webkit-scrollbar-thumb {\n  background: #CBD5E1;\n  border-radius: 4px;\n}\n\n.dark ::-webkit-scrollbar-thumb {\n  background: #475569;\n  border-radius: 4px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: #94A3B8;\n}\n\n.dark ::-webkit-scrollbar-thumb:hover {\n  background: #64748B;\n}\n"
