</div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n\ninterface ProtocolViewProps {\n  items: ProtocolItem[];\n}\n\nexport const ProtocolView: React.FC<ProtocolViewProps> = ({ items }) => {\n  return (\n    <div className=\"space-y-4\">\n      <div className=\"bg-white dark:bg-slate-800 rounded-xl p-5 border border-slate-200 dark:border-slate-700 shadow-xs\">\n        <div className=\"flex items-center justify-between mb-4\">\n          <div>\n            <h3 className=\"font-bold text-slate-800 dark:text-white text-base\">Industrial Telematics Protocols</h3>\n            <p className=\"text-xs text-slate-500 dark:text-slate-400\">Fieldbus standards, port specifications, and device network layers</p>\n          </div>\n          <span className=\"text-xs font-semibold px-3 py-1 rounded-full bg-teal-50 dark:bg-teal-950 text-teal-700 dark:text-teal-300\">\n            {items.length} Protocols Standardized\n          </span>\n        </div>\n\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs\">\n            <thead className=\"bg-slate-50 dark:bg-slate-700/50 border-b border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 uppercase tracking-wider font-semibold\">\n              <tr>\n                <th className=\"py-3 px-4\">Protocol Standard</th>\n                <th className=\"py-3 px-4\">Bus Type</th>\n                <th className=\"py-3 px-4\">Default Port / Baud Rate</th>\n                <th className=\"py-3 px-4\">Active Devices</th>\n                <th className=\"py-3 px-4\">Network Status</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100 dark:divide-slate-700 font-medium\">\n              {items.map((p) => (\n                <tr key={p.id} className=\"hover:bg-slate-50 dark:hover:bg-slate-700/40\">\n                  <td className=\"py-3.5 px-4 font-bold text-slate-800 dark:text-white flex 