     <div>\n            <div className=\"text-[10px] font-sans uppercase tracking-[0.2em] font-bold text-[#121212]/60 dark:text-[#FDFCF5]/60\">\n              Inactive Equipment\n            </div>\n            <div className=\"font-serif text-3xl font-bold text-[#121212] dark:text-[#FDFCF5] mt-1\">\n              {inactiveEquipmentCount}\n            </div>\n          </div>\n          <div className=\"w-11 h-11 border border-[#121212]/15 dark:border-white/15 bg-[#F4F2EA] dark:bg-stone-800 text-[#121212]/50 dark:text-[#FDFCF5]/50 flex items-center justify-center\">\n            <AlertCircle className=\"w-5 h-5\" />\n          </div>\n        </div>\n      </div>\n\n      {/* Search & Add Action Bar */}\n      <div className=\"bg-[#FFFFFF] dark:bg-[#1A1918] p-4 border border-[#121212]/15 dark:border-white/15 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-3\">\n        <div className=\"relative flex-1 w-full sm:max-w-md\">\n          <Search className=\"w-4 h-4 text-[#121212]/40 dark:text-[#FDFCF5]/40 absolute left-3 top-1/2 -translate-y-1/2\" />\n          <input \n            type=\"text\" \n            value={searchTerm}\n            onChange={(e) => setSearchTerm(e.target.value)}\n            placeholder=\"Search Category Names, Codes, or Specs...\" \n            className=\"w-full pl-9 pr-4 py-2 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-xs text-[#121212] dark:text-[#FDFCF5] placeholder-[#121212]/40 dark:placeholder-[#FDFCF5]/40 focus:outline-none focus:border-[#FF4D00] focus:ring-1 focus:ring-[#FF4D00] transition-colors\"\n          />\n        </div>\n\n        <button \n          id=\"add-category-btn\"\n          onClick={() => {\n            setEditingCategory(null);\n            setIsModalOpen(true);\n          }}\n          className=\"w-full sm:w-auto px-5 py-2.5 bg-[#121212] text-[#FDFCF5] hover:bg-[#FF4D00] hover:text-white dark:bg-[#FDFCF5] dark:text-[#121212] dark:hover:bg-[#FF4D00] dark:hover:text-white border border-[#121212] dark:border-white text-xs font-sans uppercase tracking-[0.14em] font-bold shadow-xs flex items-center justify-center gap-2 transition-colors shrink-0 cursor-pointer\"\n        >\n          <Plus className=\"w-4 h-4\" />\n          <span>Add Category</span>\n        </button>\n      </div>\n\n      {/* Category Cards Grid matching Image 7 */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n        {filteredCategories.map((cat) => (\n          <div \n            key={cat.id}\n            className=\"bg-[#FFFFFF] dark:bg-[#1A1918] border border-[#121212]/15 dark:border-white/15 p-5 shadow-xs flex flex-col justify-between hover:border-[#121212] dark:hover:border-white transition-all space-y-4\"\n          >\n            {/* Card Header */}\n            <div>\n              <div className=\"flex items-center justify-between mb-2\">\n                <span className=\"font-mono text-xs font-bold text-[#FF4D00] bg-[#FF4D00]/10 px-2 py-0.5 border border-[#FF4D00]/30\">\n                  #{cat.code}\n                </span>\n\n                <div className=\"flex items-center gap-1.5\">\n                  {/* Status Toggle Switch */}\n                  <button\n                    onClick={() => handleToggleActive(cat)}\n                    className={`relative inline-flex h-5 w-9 items-center rounded-full transition-colors focus:outline-none ${\n                      cat.active ? \'bg-[#121212] dark:bg-white\' : \'bg-slate-300 dark:bg-slate-600\'\n                    }`}\n                    title={cat.active ? \'Active\' : \'Inactive\'}\n                  >\n                    <span\n                      className={`inline-block h-3.5 w-3.5 transform rounded-full bg-white dark:bg-[#121212] transition-transform ${\n                        cat.active ? \'translate-x-4.5\' : \'translate-x-1\'\n                      }`}\n                    />\n                  </button>\n\n                  {/* Edit Button */}\n                  <button\n                    onClick={() => {\n                      setEditingCategory(cat);\n                      setIsModalOpen(true);\n                    }}\n                    className=\"p-1.5 border border-[#121212]/15 dark:border-white/15 text-[#121212]/70 dark:text-[#FDFCF5]/70 hover:border-[#FF4D00] hover:text-[#FF4D00] transition-colors\"\n                    title=\"Edit Category\"\n                  >\n                    <Edit2 className=\"w-3.5 h-3.5\" />\n                  </button>\n\n                  {/* Delete Button */}\n                  <button\n                    onClick={() => onDeleteCategory(cat.id)}\n                    className=\"p-1.5 border border-[#121212]/15 dark:border-white/15 text-[#121212]/70 dark:text-[#FDFCF5]/70 hover:border-red-600 hover:text-red-600 transition-colors\"\n                    title=\"Delete Category\"\n                  >\n                    <Trash2 className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n              </div>\n\n              <h4 className=\"font-serif font-bold text-[#121212] dark:text-[#FDFCF5] text-lg leading-snug\">\n                {cat.name}\n              </h4>\n              <p className=\"text-[10px] text-[#121212]/50 dark:text-[#FDFCF5]/50 mt-0.5 font-mono\">\n                Created: {cat.createdAt}\n              </p>\n            </div>\n\n            {/* Spec tags */}\n            <div className=\"space-y-2 text-xs\">\n              <p className=\"text-[#121212]/70 dark:text-[#FDFCF5]/70 line-clamp-2 text-xs leading-relaxed\">\n                {cat.description}\n              </p>\n\n              <div className=\"flex flex-wrap gap-2 pt-1\">\n                {/* Equipment count */}\n                <div className=\"flex items-center gap-1.5 px-2.5 py-1 bg-[#F4F2EA] dark:bg-stone-800 text-[#121212] dark:text-[#FDFCF5] font-mono font-semibold text-[11px] border border-[#121212]/15 dark:border-white/15\">\n                  <Wrench className=\"w-3 h-3 text-[#FF4D00]\" />\n                  <span>{cat.equipmentCount} Units</span>\n                </div>\n\n                {/* Maintenance Interval */}\n                <div className=\"flex items-center gap-1.5 px-2.5 py-1 bg-[#F4F2EA] dark:bg-stone-800 text-[#121212] dark:text-[#FDFCF5] text-[11px] font-mono border border-[#121212]/15 dark:border-white/15\">\n                  <Clock className=\"w-3 h-3 text-[#121212]/50 dark:text-[#FDFCF5]/50\" />\n                  <span>{cat.maintenanceIntervalHrs}h Service</span>\n                </div>\n\n                {/* Powertrain spec */}\n                {cat.fuelTankCapacityLiters > 0 && (\n                  <div className=\"flex items-center gap-1.5 px-2.5 py-1 bg-[#F4F2EA] dark:bg-stone-800 text-[#121212] dark:text-[#FDFCF5] text-[11px] font-mono border border-[#121212]/15 dark:border-white/15\">\n                    <Fuel className=\"w-3 h-3 text-[#FF4D00]\" />\n                    <span>{cat.fuelTankCapacityLiters}L Tank</span>\n                  </div>\n                )}\n              </div>\n            </div>\n\n            {/* Plant info footer */}\n            <div className=\"pt-3 border-t border-[#121212]/10 dark:border-white/10 flex items-center justify-between text-[11px] text-[#121212]/60 dark:text-[#FDFCF5]/60 font-sans\">\n              <span className=\"flex items-center gap-1.5 font-medium\">\n                <Building2 className=\"w-3.5 h-3.5 text-[#121212]/40 dark:text-[#FDFCF5]/40\" />\n                {cat.plant}\n              </span>\n              <span className={`font-mono font-bold text-[10px] uppercase tracking-wider ${cat.active ? \'text-[#FF4D00]\' : \'text-slate-400\'}`}>\n                {cat.active ? \'\342\200\242 Active\' : \'\342\200\242 Disabled\'}\n              </span>\n            </div>\n\n          </div>\n        ))}\n      </div>"
    }
