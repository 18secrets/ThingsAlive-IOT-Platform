    end_line: 240
    content: "import React, { useState, useMemo } from \'react\';\nimport { Search, Plus, Eye, Edit2, ChevronLeft, ChevronRight, Filter } from \'lucide-react\';\nimport { SensorItem } from \'../../types\';\nimport { AddSensorModal } from \'./AddSensorModal\';\nimport { SensorDetailModal } from \'./SensorDetailModal\';\n\ninterface SensorTableProps {\n  sensors: SensorItem[];\n  onAddSensor: (sensor: SensorItem) => void;\n  onUpdateSensor?: (sensor: SensorItem) => void;\n}\n\nexport const SensorTable: React.FC<SensorTableProps> = ({\n  sensors,\n  onAddSensor,\n  onUpdateSensor,\n}) => {\n  const [searchTerm, setSearchTerm] = useState(\'\');\n  const [selectedIndustry, setSelectedIndustry] = useState(\'All\');\n  const [currentPage, setCurrentPage] = useState(1);\n  const [rowsPerPage, setRowsPerPage] = useState(10);\n  const [isAddModalOpen, setIsAddModalOpen] = useState(false);\n  const [viewingSensor, setViewingSensor] = useState<SensorItem | null>(null);\n\n  // Industry options for filter\n  const industryOptions = useMemo(() => {\n    const list = Array.from(new Set(sensors.map((s) => s.industryType)));\n    return [\'All\', ...list];\n  }, [sensors]);\n\n  // Filtered sensors\n  const filteredSensors = useMemo(() => {\n    return sensors.filter((s) => {\n      const matchesSearch = \n        s.sensorName.toLowerCase().includes(searchTerm.toLowerCase()) ||\n        s.industryType.toLowerCase().includes(searchTerm.toLowerCase());\n      const matchesIndustry = selectedIndustry === \'All\' || s.industryType === selectedIndustry;\n      return matchesSearch && matchesIndustry;\n    });\n  }, [sensors, searchTerm, selectedIndustry]);\n\n  // Pagination calculation\n  const totalRows = filteredSensors.length;\n  const totalPages = Math.ceil(totalRows / rowsPerPage) || 1;\n  const startIndex = (currentPage - 1) * rowsPerPage;\n  const paginatedSensors = filteredSensors.slice(startIndex, startIndex + rowsPerPage);\n\n  return (\n    <div id=\"sensor-management-view\" className=\"space-y-4\">\n      {/* Top Filter & Action Bar */}\n      <div className=\"bg-[#FFFFFF] dark:bg-[#1A1918] p-4 border border-[#121212]/15 dark:border-white/15 flex flex-col md:flex-row md:items-center justify-between gap-3 shadow-xs\">\n        \n        <div className=\"flex flex-1 items-center gap-3\">\n          {/* Search Input */}\n          <div className=\"relative flex-1 max-w-md\">\n            <Search className=\"w-4 h-4 text-[#121212]/40 dark:text-[#FDFCF5]/40 absolute left-3 top-1/2 -translate-y-1/2\" />\n            <input \n              type=\"text\" \n              value={searchTerm}\n              onChange={(e) => {\n                setSearchTerm(e.target.value);\n                setCurrentPage(1);\n              }}\n              placeholder=\"Search Sensor Names...\" \n              className=\"w-full pl-9 pr-4 py-2 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-xs text-[#121212] dark:text-[#FDFCF5] placeholder-[#121212]/40 dark:placeholder-[#FDFCF5]/40 focus:outline-none focus:border-[#FF4D00] focus:ring-1 focus:ring-[#FF4D00] transition-colors\"\n            />\n          </div>\n\n          {/* Industry Type Filter */}\n          <div className=\"relative min-w-[200px]\">\n            <select\n              value={selectedIndustry}\n              onChange={(e) => {\n                setSelectedIndustry(e.target.value);\n                setCurrentPage(1);\n              }}\n              className=\"w-full py-2 px-3 text-xs bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] focus:outline-none focus:border-[#FF4D00] focus:ring-1 focus:ring-[#FF4D00] cursor-pointer\"\n            >\n              <option value=\"All\">Filter by Industry Type (All)</option>\n              {industryOptions.filter(i => i !== \'All\').map((ind) => (\n                <option key={ind} value={ind}>{ind}</option>\n              ))}\n            </select>\n          </div>\n        </div>\n\n        {/* Add Sensor Button */}\n        <button \n          id=\"add-sensor-btn\"\n          onClick={() => setIsAddModalOpen(true)}\n          className=\"px-4 py-2 bg-[#121212] text-[#FDFCF5] hover:bg-[#FF4D00] hover:text-white dark:bg-[#FDFCF5] dark:text-[#121212] dark:hover:bg-[#FF4D00] dark:hover:text-white border border-[#121212] dark:border-white text-xs font-sans uppercase tracking-[0.14em] font-bold shadow-xs flex items-center justify-center gap-2 transition-colors shrink-0 cursor-pointer\"\n        >\n          <Plus className=\"w-4 h-4\" />\n          <span>Add Sensor</span>\n        </button>\n      </div>\n\n      {/* Main Data Table */}\n      <div className=\"bg-[#FFFFFF] dark:bg-[#1A1918] border border-[#121212]/15 dark:border-white/15 overflow-hidden shadow-xs\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs\">\n            <thead className=\"bg-[#F4F2EA] dark:bg-[#151514] border-b border-[#121212]/15 dark:border-white/15 text-[#121212] dark:text-[#FDFCF5] font-sans font-bold uppercase tracking-[0.14em] text-[11px]\">\n              <tr>\n                <th className=\"py-3 px-4\">Industry Type</th>\n                <th className=\"py-3 px-4\">Sensor Name</th>\n                <th className=\"py-3 px-4\">Created At</th>\n                <th className=\"py-3 px-4\">Updated At</th>\n                <th className=\"py-3 px-4 text-center\">Action</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-[#121212]/10 dark:divide-white/10 font-medium\">\n              {paginatedSensors.length > 0 ? (\n                paginatedSensors.map((sensor) => (\n                  <tr \n                    key={sensor.id} \n                    className=\"hover:bg-[#FDFCF5] dark:hover:bg-stone-800/50 transition-colors\"\n                  >\n                    <td className=\"py-3.5 px-4 text-[#121212] dark:text-[#FDFCF5] font-serif font-bold text-sm\">\n                      {sensor.industryType}\n                    </td>\n                    <td className=\"py-3.5 px-4\">\n                      <div className=\"flex items-center gap-2\">\n                        <span className=\"font-mono text-[#121212] dark:text-[#FDFCF5] bg-[#F4F2EA] dark:bg-stone-800 px-2 py-0.5 border border-[#121212]/15 dark:border-white/15 font-semibold\">\n                          {sensor.sensorName}\n                        </span>\n                      </div>\n                    </td>\n                    <td className=\"py-3.5 px-4 text-[#121212]/60 dark:text-[#FDFCF5]/60 font-mono text-[11px]\">\n                      {sensor.createdAt}\n                    </td>\n                    <td className=\"py-3.5 px-4 text-[#121212]/60 dark:text-[#FDFCF5]/60 font-mono text-[11px]\">\n                      {sensor.updatedAt}\n                    </td>\n                    <td className=\"py-3.5 px-4\">\n                      <div className=\"flex items-center justify-center gap-2\">\n                        {/* View Eye */}\n                        <button\n                          onClick={() => setViewingSensor(sensor)}\n                          className=\"p-1.5 border border-[#121212]/15 dark:border-white/15 text-[#121212] dark:text-[#FDFCF5] hover:bg-[#121212] hover:text-white dark:hover:bg-white dark:hover:text-[#121212] transition-colors\"\n                          title=\"View Sensor Details\"\n                        >\n                          <Eye className=\"w-3.5 h-3.5\" />\n                        </button>\n                        {/* Edit Pencil */}\n                        <button\n                          onClick={() => setViewingSensor(sensor)}\n                          className=\"p-1.5 border border-[#121212]/15 dark:border-white/15 text-[#121212] dark:text-[#FDFCF5] hover:border-[#FF4D00] hover:text-[#FF4D00] transition-colors\"\n                          title=\"Edit Sensor Configuration\"\n                        >\n                          <Edit2 className=\"w-3.5 h-3.5\" />\n                        </button>\n                      </div>\n                    </td>\n                  </tr>\n                ))\n              ) : (\n                <tr>\n                  <td colSpan={5} className=\"py-8 text-center text-[#121212]/40 dark:text-[#FDFCF5]/40 font-serif italic text-sm\">\n                    No sensors match your search filter.\n                  </td>\n                </tr>\n              )}\n            </tbody>\n          </table>\n        </div>\n\n        {/* Table Pagination Footer matching Image 1 */}\n        <div className=\"px-6 py-3.5 border-t border-[#121212]/15 dark:border-white/15 bg-[#F4F2EA]/60 dark:bg-[#151514] flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[#121212]/70 dark:text-[#FDFCF5]/70 font-sans\">\n          <div>\n            Total Rows: <span className=\"font-bold text-[#121212] dark:text-[#FDFCF5] font-mono\">{totalRows}</span>\n          </div>\n\n          <div className=\"flex items-center gap-4\">\n            <div className=\"flex items-center gap-2\">\n              <span>Rows per page:</span>\n              <select\n                value={rowsPerPage}\n                onChange={(e) => {\n                  setRowsPerPage(Number(e.target.value));\n                  setCurrentPage(1);\n                }}\n                className=\"bg-[#FFFFFF] dark:bg-[#1c1c1a] border border-[#121212]/20 dark:border-white/20 px-2 py-1 text-[#121212] dark:text-[#FDFCF5] text-xs focus:outline-none\"\n              >\n                <option value={10}>10</option>\n                <option value={20}>20</option>\n                <option value={50}>50</option>\n              </select>\n            </div>\n\n            <div className=\"flex items-center gap-1\">\n              <button\n                disabled={currentPage <= 1}\n                onClick={() => setCurrentPage((p) => Math.max(1, p - 1))}\n                className=\"p-1 border border-[#121212]/15 dark:border-white/15 hover:bg-[#121212] hover:text-white dark:hover:bg-white dark:hover:text-[#121212] disabled:opacity-30 disabled:cursor-not-allowed transition-colors\"\n              >\n                <ChevronLeft className=\"w-4 h-4\" />\n              </button>\n\n              {Array.from({ length: totalPages }).map((_, i) => (\n                <button\n                  key={i}\n                  onClick={() => setCurrentPage(i + 1)}\n                  className={`w-6 h-6 border font-mono text-xs flex items-center justify-center transition-colors ${\n                    currentPage === i + 1\n                      ? \'bg-[#121212] text-white border-[#121212] dark:bg-white dark:text-[#121212]\'\n                      : \'border-[#121212]/15 dark:border-white/15 hover:bg-[#EAE7E0] dark:hover:bg-stone-800 text-[#121212] dark:text-[#FDFCF5]\'\n                  }`}\n                >\n                  {i + 1}\n                </button>\n              ))}\n\n              <button\n                disabled={currentPage >= totalPages}\n                onClick={() => setCurrentPage((p) => Math.min(totalPages, p + 1))}\n                className=\"p-1 border border-[#121212]/15 dark:border-white/15 hover:bg-[#121212] hover:text-white dark:hover:bg-white dark:hover:text-[#121212] disabled:opacity-30 disabled:cursor-not-allowed transition-colors\"\n              >\n                <ChevronRight className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Add Sensor Modal */}\n      <AddSensorModal \n        isOpen={isAddModalOpen}\n        onClose={() => setIsAddModalOpen(false)}\n        onSave={onAddSensor}\n        industryTypes={industryOptions.filter(i => i !== \'All\')}\n      />\n\n      {/* Sensor Detail Modal */}\n      <SensorDetailModal \n        sensor={viewingSensor}\n        onClose={() => setViewingSensor(null)}\n      />\n    </div>\n  );\n};\n"
    raw_content: "import React, { useState, useMemo } from \'react\';\nimport { Search, Plus, Eye, Edit2, ChevronLeft, ChevronRight, Filter } from \'lucide-react\';\nimport { SensorItem } from \'../../types\';\nimport { AddSensorModal } from \'./AddSensorModal\';\nimport { SensorDetailModal } from \'./SensorDetailModal\';\n\ninterface SensorTableProps {\n  sensors: SensorItem[];\n  onAddSensor: (sensor: SensorItem) => void;\n  onUpdateSensor?: (sensor: SensorItem) => void;\n}\n\nexport const SensorTable: React.FC<SensorTableProps> = ({\n  sensors,\n  onAddSensor,\n  onUpdateSensor,\n}) => {\n  const [searchTerm, setSearchTerm] = useState(\'\');\n  const [selectedIndustry, setSelectedIndustry] = useState(\'All\');\n  const [currentPage, setCurrentPage] = useState(1);\n  const [rowsPerPage, setRowsPerPage] = useState(10);\n  const [isAddModalOpen, setIsAddModalOpen] = useState(false);\n  const [viewingSensor, setViewingSensor] = useState<SensorItem | null>(null);\n\n  // Industry options for filter\n  const industryOptions = useMemo(() => {\n    const list = Array.from(new Set(sensors.map((s) => s.industryType)));\n    return [\'All\', ...list];\n  }, [sensors]);\n\n  // Filtered sensors\n  const filteredSensors = useMemo(() => {\n    return sensors.filter((s) => {\n      const matchesSearch = \n        s.sensorName.toLowerCase().includes(searchTerm.toLowerCase()) ||\n        s.industryType.toLowerCase().includes(searchTerm.toLowerCase());\n      const matchesIndustry = selectedIndustry === \'All\' || s.industryType === selectedIndustry;\n      return matchesSearch && matchesIndustry;\n    });\n  }, [sensors, searchTerm, selectedIndustry]);\n\n  // Pagination calculation\n  const totalRows = filteredSensors.length;\n  const totalPages = Math.ceil(totalRows / rowsPerPage) || 1;\n  const startIndex = (currentPage - 1) * rowsPerPage;\n  const paginatedSensors = filteredSensors.slice(startIndex, startIndex + rowsPerPage);\n\n  return (\n    <div id=\"sensor-management-view\" className=\"space-y-4\">\n      {/* Top Filter & Action Bar */}\n      <div className=\"bg-[#FFFFFF] dark:bg-[#1A1918] p-4 border border-[#121212]/15 dark:border-white/15 flex flex-col md:flex-row md:items-center justify-between gap-3 shadow-xs\">\n        \n        <div className=\"flex flex-1 items-center gap-3\">\n          {/* Search Input */}\n          <div className=\"relative flex-1 max-w-md\">\n            <Search className=\"w-4 h-4 text-[#121212]/40 dark:text-[#FDFCF5]/40 absolute left-3 top-1/2 -translate-y-1/2\" />\n            <input \n              type=\"text\" \n              value={searchTerm}\n              onChange={(e) => {\n                setSearchTerm(e.target.value);\n                setCurrentPage(1);\n              }}\n              placeholder=\"Search Sensor Names...\" \n              className=\"w-full pl-9 pr-4 py-2 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-xs text-[#121212] dark:text-[#FDFCF5] placeholder-[#121212]/40 dark:placeholder-[#FDFCF5]/40 focus:outline-none focus:border-[#FF4D00] focus:ring-1 focus:ring-[#FF4D00] transition-colors\"\n            />\n          </div>\n\n          {/* Industry Type Filter */}\n          <div className=\"relative min-w-[200px]\">\n            <select\n              value={selectedIndustry}\n              onChange={(e) => {\n                setSelectedIndustry(e.target.value);\n                setCurrentPage(1);\n              }}\n              className=\"w-full py-2 px-3 text-xs bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] focus:outline-none focus:border-[#FF4D00] focus:ring-1 focus:ring-[#FF4D00] cursor-pointer\"\n            >\n              <option value=\"All\">Filter by Industry Type (All)</option>\n              {industryOptions.filter(i => i !== \'All\').map((ind) => (\n                <option key={ind} value={ind}>{ind}</option>\n              ))}\n            </select>\n          </div>\n        </div>\n\n        {/* Add Sensor Button */}\n        <button \n          id=\"add-sensor-btn\"\n          onClick={() => setIsAddModalOpen(true)}\n          className=\"px-4 py-2 bg-[#121212] text-[#FDFCF5] hover:bg-[#FF4D00] hover:text-white dark:bg-[#FDFCF5] dark:text-[#121212] dark:hover:bg-[#FF4D00] dark:hover:text-white border border-[#121212] dark:border-white text-xs font-sans uppercase tracking-[0.14em] font-bold shadow-xs flex items-center justify-center gap-2 transition-colors shrink-0 cursor-pointer\"\n        >\n          <Plus className=\"w-4 h-4\" />\n          <span>Add Sensor</span>\n        </button>\n      </div>\n\n      {/* Main Data Table */}\n      <div className=\"bg-[#FFFFFF] dark:bg-[#1A1918] border border-[#121212]/15 dark:border-white/15 overflow-hidden shadow-xs\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs\">\n            <thead className=\"bg-[#F4F2EA] dark:bg-[#151514] border-b border-[#121212]/15 dark:border-white/15 text-[#121212] dark:text-[#FDFCF5] font-sans font-bold uppercase tracking-[0.14em] text-[11px]\">\n              <tr>\n                <th className=\"py-3 px-4\">Industry Type</th>\n                <th className=\"py-3 px-4\">Sensor Name</th>\n                <th className=\"py-3 px-4\">Created At</th>\n                <th className=\"py-3 px-4\">Updated At</th>\n                <th className=\"py-3 px-4 text-center\">Action</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-[#121212]/10 dark:divide-white/10 font-medium\">\n              {paginatedSensors.length > 0 ? (\n                paginatedSensors.map((sensor) => (\n                  <tr \n                    key={sensor.id} \n                    className=\"hover:bg-[#FDFCF5] dark:hover:bg-stone-800/50 transition-colors\"\n                  >\n                    <td className=\"py-3.5 px-4 text-[#121212] dark:text-[#FDFCF5] font-serif font-bold text-sm\">\n                      {sensor.industryType}\n                    </td>\n                    <td className=\"py-3.5 px-4\">\n                      <div className=\"flex items-center gap-2\">\n                        <span className=\"font-mono text-[#121212] dark:text-[#FDFCF5] bg-[#F4F2EA] dark:bg-stone-800 px-2 py-0.5 border border-[#121212]/15 dark:border-white/15 font-semibold\">\n                          {sensor.sensorName}\n                        </span>\n                      </div>\n                    </td>\n                    <td className=\"py-3.5 px-4 text-[#121212]/60 dark:text-[#FDFCF5]/60 font-mono text-[11px]\">\n                      {sensor.createdAt}\n                    </td>\n                    <td className=\"py-3.5 px-4 text-[#121212]/60 dark:text-[#FDFCF5]/60 font-mono text-[11px]\">\n                      {sensor.updatedAt}\n                    </td>\n                    <td className=\"py-3.5 px-4\">\n                      <div className=\"flex items-center justify-center gap-2\">\n                        {/* View Eye */}\n                        <button\n                          onClick={() => setViewingSensor(sensor)}\n                          className=\"p-1.5 border border-[#121212]/15 dark:border-white/15 text-[#121212] dark:text-[#FDFCF5] hover:bg-[#121212] hover:text-white dark:hover:bg-white dark:hover:text-[#121212] transition-colors\"\n                          title=\"View Sensor Details\"\n                        >\n                          <Eye className=\"w-3.5 h-3.5\" />\n                        </button>\n                        {/* Edit Pencil */}\n                        <button\n                          onClick={() => setViewingSensor(sensor)}\n                          className=\"p-1.5 border border-[#121212]/15 dark:border-white/15 text-[#121212] dark:text-[#FDFCF5] hover:border-[#FF4D00] hover:text-[#FF4D00] transition-colors\"\n                          title=\"Edit Sensor Configuration\"\n                        >\n                          <Edit2 className=\"w-3.5 h-3.5\" />\n                        </button>\n                      </div>\n                    </td>\n                  </tr>\n                ))\n              ) : (\n                <tr>\n                  <td colSpan={5} className=\"py-8 text-center text-[#121212]/40 dark:text-[#FDFCF5]/40 font-serif italic text-sm\">\n                    No sensors match your search filter.\n                  </td>\n                </tr>\n              )}\n            </tbody>\n          </table>\n        </div>\n\n        {/* Table Pagination Footer matching Image 1 */}\n        <div className=\"px-6 py-3.5 border-t border-[#121212]/15 dark:border-white/15 bg-[#F4F2EA]/60 dark:bg-[#151514] flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[#121212]/70 dark:text-[#FDFCF5]/70 font-sans\">\n          <div>\n            Total Rows: <span className=\"font-bold text-[#121212] dark:text-[#FDFCF5] font-mono\">{totalRows}</span>\n          </div>\n\n          <div className=\"flex items-center gap-4\">\n            <div className=\"flex items-center gap-2\">\n              <span>Rows per page:</span>\n              <select\n                value={rowsPerPage}\n                onChange={(e) => {\n                  setRowsPerPage(Number(e.target.value));\n                  setCurrentPage(1);\n                }}\n                className=\"bg-[#FFFFFF] dark:bg-[#1c1c1a] border border-[#121212]/20 dark:border-white/20 px-2 py-1 text-[#121212] dark:text-[#FDFCF5] text-xs focus:outline-none\"\n              >\n                <option value={10}>10</option>\n                <option value={20}>20</option>\n                <option value={50}>50</option>\n              </select>\n            </div>\n\n            <div className=\"flex items-center gap-1\">\n              <button\n                disabled={currentPage <= 1}\n                onClick={() => setCurrentPage((p) => Math.max(1, p - 1))}\n                className=\"p-1 border border-[#121212]/15 dark:border-white/15 hover:bg-[#121212] hover:text-white dark:hover:bg-white dark:hover:text-[#121212] disabled:opacity-30 disabled:cursor-not-allowed transition-colors\"\n              >\n                <ChevronLeft className=\"w-4 h-4\" />\n              </button>\n\n              {Array.from({ length: totalPages }).map((_, i) => (\n                <button\n                  key={i}\n                  onClick={() => setCurrentPage(i + 1)}\n                  className={`w-6 h-6 border font-mono text-xs flex items-center justify-center transition-colors ${\n                    currentPage === i + 1\n                      ? \'bg-[#121212] text-white border-[#121212] dark:bg-white dark:text-[#121212]\'\n                      : \'border-[#121212]/15 dark:border-white/15 hover:bg-[#EAE7E0] dark:hover:bg-stone-800 text-[#121212] dark:text-[#FDFCF5]\'\n                  }`}\n                >\n                  {i + 1}\n                </button>\n              ))}\n\n              <button\n                disabled={currentPage >= totalPages}\n                onClick={() => setCurrentPage((p) => Math.min(totalPages, p + 1))}\n                className=\"p-1 border border-[#121212]/15 dark:border-white/15 hover:bg-[#121212] hover:text-white dark:hover:bg-white dark:hover:text-[#121212] disabled:opacity-30 disabled:cursor-not-allowed transition-colors\"\n              >\n                <ChevronRight className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Add Sensor Modal */}\n      <AddSensorModal \n        isOpen={isAddModalOpen}\n        onClose={() => setIsAddModalOpen(false)}\n        onSave={onAddSensor}\n        industryTypes={industryOptions.filter(i => i !== \'All\')}\n      />\n\n      {/* Sensor Detail Modal */}\n      <SensorDetailModal \n        sensor={viewingSensor}\n        onClose={() => setViewingSensor(null)}\n      />\n    </div>\n  );\n};\n"
