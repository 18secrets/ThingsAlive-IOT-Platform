    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useState, useMemo } from \'react\';\nimport { Search, Plus, Edit3 } from \'lucide-react\';\nimport { ToolMappingItem, SensorItem } from \'../../types\';\nimport { MapSensorsModal } from \'./MapSensorsModal\';\n\ninterface ToolMappingTableProps {\n  mappings: ToolMappingItem[];\n  onAddMapping: (mapping: ToolMappingItem) => void;\n  availableSensors?: SensorItem[];\n}\n\nexport const ToolMappingTable: React.FC<ToolMappingTableProps> = ({\n  mappings,\n  onAddMapping,\n  availableSensors = [],\n}) => {\n  const [searchTerm, setSearchTerm] = useState(\'\');\n  const [selectedIndustry, setSelectedIndustry] = useState(\'All\');\n  const [selectedProtocol, setSelectedProtocol] = useState(\'All\');\n  const [isModalOpen, setIsModalOpen] = useState(false);\n  const [editingMapping, setEditingMapping] = useState<ToolMappingItem | null>(null);\n\n  const filteredMappings = useMemo(() => {\n    return mappings.filter((item) => {\n      const matchSearch = \n        item.toolName.toLowerCase().includes(searchTerm.toLowerCase()) ||\n        item.identifier.toLowerCase().includes(searchTerm.toLowerCase()) ||\n        item.industryType.toLowerCase().includes(searchTerm.toLowerCase());\n      const matchIndustry = selectedIndustry === \'All\' || item.industryType === selectedIndustry;\n      const matchProtocol = selectedProtocol === \'All\' || item.protocol.toLowerCase().includes(selectedProtocol.toLowerCase());\n      return matchSearch && matchIndustry && matchProtocol;\n    });\n  }, [mappings, searchTerm, selectedIndustry, selectedProtocol]);\n\n  const getBadgeStyle = (color: string) => {\n    switch (color) {\n      case \'teal\':\n        return \'bg-[#F4F2EA] text-[#121212] border-[#121212]/30 dark:bg-stone-800 dark:text-[#FDFCF5] dark:border-white/20\';\n      case \'purple\':\n        return \'bg-[#F4F2EA] text-[#121212] border-[#121212]/30 dark:bg-stone-800 dark:text-[#FDFCF5] dark:border-white/20\';\n      case \'amber\':\n        return \'bg-[#F4F2EA] text-[#FF4D00] border-[#FF4D00]/40 dark:bg-stone-800 dark:text-[#FF4D00] dark:border-[#FF4D00]/40\';\n      case \'emerald\':\n        return \'bg-[#F4F2EA] text-[#121212] border-[#121212]/30 dark:bg-stone-800 dark:text-[#FDFCF5] dark:border-white/20\';\n      case \'rose\':\n        return \'bg-[#FF4D00]/10 text-[#FF4D00] border-[#FF4D00]/30\';\n      case \'blue\':\n      default:\n        return \'bg-[#F4F2EA] text-[#121212] border-[#121212]/20 dark:bg-stone-800 dark:text-[#FDFCF5] dark:border-white/20\';\n    }\n  };\n\n  return (\n    <div id=\"tool-mapping-view\" className=\"space-y-4\">\n      {/* Top Filter Bar */}\n      <div className=\"bg-[#FFFFFF] dark:bg-[#1A1918] p-4 border border-[#121212]/15 dark:border-white/15 flex flex-col md:flex-row md:items-center justify-between gap-3 shadow-xs\">\n        <div className=\"flex flex-1 items-center gap-3 flex-wrap\">\n          {/* Search */}\n          <div className=\"relative flex-1 min-w-[240px]\">\n            <Search className=\"w-4 h-4 text-[#121212]/40 dark:text-[#FDFCF5]/40 absolute left-3 top-1/2 -translate-y-1/2\" />\n            <input \n              type=\"text\" \n              value={searchTerm}\n              onChange={(e) => setSearchTerm(e.target.value)}\n              placeholder=\"Search Tool or Mapping Profile...\" \n              className=\"w-full pl-9 pr-4 py-2 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-xs text-[#121212] dark:text-[#FDFCF5] placeholder-[#121212]/40 dark:placeholder-[#FDFCF5]/40 focus:outline-none focus:border-[#FF4D00] focus:ring-1 focus:ring-[#FF4D00] transition-colors\"\n            />\n          </div>\n\n          {/* Filter Industry */}\n          <select\n            value={selectedIndustry}\n            onChange={(e) => setSelectedIndustry(e.target.value)}\n            className=\"py-2 px-3 text-xs bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] focus:outline-none focus:border-[#FF4D00] cursor-pointer\"\n          >\n            <option value=\"All\">All Industry Types</option>\n            <option value=\"Cement & Building Materials\">Cement & Building Materials</option>\n            <option value=\"Transport\">Transport</option>\n            <option value=\"Automotive\">Automotive</option>\n            <option value=\"Power & Energy\">Power & Energy</option>\n          </select>\n\n          {/* Filter Protocol */}\n          <select\n            value={selectedProtocol}\n            onChange={(e) => setSelectedProtocol(e.target.value)}\n            className=\"py-2 px-3 text-xs bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] focus:outline-none focus:border-[#FF4D00] cursor-pointer\"\n          >\n            <option value=\"All\">All Protocols</option>\n            <option value=\"MODBUS\">MODBUS TCP / RTU</option>\n            <option value=\"CAN\">CAN-bus / J1939</option>\n            <option value=\"EtherNet\">EtherNet / IP</option>\n            <option value=\"PROFINET\">PROFINET</option>\n          </select>\n        </div>\n\n        {/* Create Mapping Button */}\n        <button \n          id=\"create-mapping-btn\"\n          onClick={() => {\n            setEditingMapping(null);\n            setIsModalOpen(true);\n          }}\n          className=\"px-4 py-2 bg-[#121212] text-[#FDFCF5] hover:bg-[#FF4D00] hover:text-white dark:bg-[#FDFCF5] dark:text-[#121212] dark:hover:bg-[#FF4D00] dark:hover:text-white border border-[#121212] dark:border-white text-xs font-sans uppercase tracking-[0.14em] font-bold shadow-xs flex items-center justify-center gap-2 transition-colors shrink-0 cursor-pointer\"\n        >\n          <Plus className=\"w-4 h-4\" />\n          <span>Create Tool Mapping</span>\n        </button>\n      </div>\n\n      {/* Table */}\n      <div className=\"bg-[#FFFFFF] dark:bg-[#1A1918] border border-[#121212]/15 dark:border-white/15 shadow-xs overflow-hidden\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs\">\n            <thead className=\"bg-[#F4F2EA] dark:bg-[#151514] border-b border-[#121212]/15 dark:border-white/15 text-[#121212] dark:text-[#FDFCF5] font-sans font-bold uppercase tracking-[0.14em] text-[11px]\">\n              <tr>\n                <th className=\"py-3 px-4\">Tool Profile / ID</th>\n                <th className=\"py-3 px-4\">Industry Type</th>\n                <th className=\"py-3 px-4\">Mapped Sensors & Channels</th>\n                <th className=\"py-3 px-4\">Parameters</th>\n                <th className=\"py-3 px-4\">Protocol</th>\n                <th className=\"py-3 px-4\">Updated At</th>\n                <th className=\"py-3 px-4 text-center\">Action</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-[#121212]/10 dark:divide-white/10 font-medium\">\n              {filteredMappings.map((item) => (\n                <tr \n                  key={item.id} \n                  className=\"hover:bg-[#FDFCF5] dark:hover:bg-stone-800/50 transition-colors\"\n                >\n                  <td className=\"py-3.5 px-4\">\n                    <div className=\"font-serif font-bold text-sm text-[#121212] dark:text-[#FDFCF5]\">\n                      {item.toolName}\n                    </div>\n                    <span className=\"font-mono text-[10px] text-[#121212]/50 dark:text-[#FDFCF5]/50\">\n                      {item.identifier}\n                    </span>\n                  </td>\n                  <td className=\"py-3.5 px-4 text-[#121212] dark:text-[#FDFCF5]\">\n                    {item.industryType}\n                  </td>\n                  <td className=\"py-3.5 px-4\">\n                    <div className=\"flex flex-wrap gap-1.5 max-w-sm\">\n                      {item.mappedSensors.map((sensor) => (\n                        <span \n                          key={sensor.id} \n                          className={`px-2 py-0.5 text-[11px] font-mono border ${getBadgeStyle(sensor.tagColor)}`}\n                          title={`Parameters: ${sensor.parameters.join(\', \')}`}\n                        >\n                          {sensor.name}\n                        </span>\n                      ))}\n                    </div>\n                  </td>\n                  <td className=\"py-3.5 px-4\">\n                    <span className=\"px-2 py-0.5 border border-[#121212]/20 dark:border-white/20 bg-[#F4F2EA] dark:bg-stone-800 text-[#121212] dark:text-[#FDFCF5] font-mono font-bold text-[11px]\">\n                      {item.activeParametersCount} Ch\n                    </span>\n                  </td>\n                  <td className=\"py-3.5 px-4\">\n                    <span className=\"font-mono text-[#121212]/70 dark:text-[#FDFCF5]/70 text-[11px]\">\n                      {item.protocol}\n                    </span>\n                  </td>\n                  <td className=\"py-3.5 px-4 text-[#121212]/60 dark:text-[#FDFCF5]/60 font-mono text-[11px]\">\n                    {item.updatedAt}\n                  </td>\n                  <td className=\"py-3.5 px-4\">\n                    <div className=\"flex items-center justify-center gap-2\">\n                      <button\n                        onClick={() => {\n                          setEditingMapping(item);\n                          setIsModalOpen(true);\n                        }}\n                        className=\"p-1.5 border border-[#121212]/15 dark:border-white/15 text-[#121212] dark:text-[#FDFCF5] hover:border-[#FF4D00] hover:text-[#FF4D00] transition-colors\"\n                        title=\"Edit Mapping Configuration\"\n                      >\n                        <Edit3 className=\"w-3.5 h-3.5\" />\n                      </button>\n                    </div>\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n\n        {/* Footer */}\n        <div className=\"px-6 py-3.5 border-t border-[#121212]/15 dark:border-white/15 bg-[#F4F2EA]/60 dark:bg-[#151514] flex items-center justify-between text-xs text-[#121212]/70 dark:text-[#FDFCF5]/70 font-sans\">\n          <div>Showing <span className=\"font-mono font-bold text-[#121212] dark:text-[#FDFCF5]\">{filteredMappings.length}</span> Tool Mapping Profiles</div>\n          <div className=\"text-[11px] text-[#121212]/50 dark:text-[#FDFCF5]/50 font-mono\">\n            Telemetry channels auto-bind upon device IMEI registration\n          </div>\n        </div>\n      </div>\n\n      {/* Map Sensors Modal */}\n      <MapSensorsModal \n        isOpen={isModalOpen}\n        onClose={() => {\n          setIsModalOpen(false);\n          setEditingMapping(null);\n        }}\n        onSave={onAddMapping}\n        existingMapping={editingMapping}\n        availableSensors={availableSensors}\n      />\n    </div>\n  );\n};"
      replacement_content: "import React, { useState, useMemo } from \'react\';\nimport { Search, Plus, Edit3 } from \'lucide-react\';\nimport { ToolMappingItem, SensorItem } from \'../../types\';\nimport { MapSensorsModal } from \'./MapSensorsModal\';\n\ninterface ToolMappingTableProps {\n  mappings: ToolMappingItem[];\n  onAddMapping: (mapping: ToolMappingItem) => void;\n  availableSensors?: SensorItem[];\n}\n\nexport const ToolMappingTable: React.FC<ToolMappingTableProps> = ({\n  mappings,\n  onAddMapping,\n  availableSensors = [],\n}) => {\n  const [searchTerm, setSearchTerm] = useState(\'\');\n  const [selectedIndustry, setSelectedIndustry] = useState(\'All\');\n  const [isModalOpen, setIsModalOpen] = useState(false);\n  const [editingMapping, setEditingMapping] = useState<ToolMappingItem | null>(null);\n\n  const filteredMappings = useMemo(() => {\n    return mappings.filter((item) => {\n      const matchSearch = \n        item.toolName.toLowerCase().includes(searchTerm.toLowerCase()) ||\n        item.identifier.toLowerCase().includes(searchTerm.toLowerCase()) ||\n        item.industryType.toLowerCase().includes(searchTerm.toLowerCase());\n      const matchIndustry = selectedIndustry === \'All\' || item.industryType === selectedIndustry;\n      return matchSearch && matchIndustry;\n    });\n  }, [mappings, searchTerm, selectedIndustry]);\n\n  return (\n    <div id=\"tool-mapping-view\" className=\"space-y-4\">\n      {/* Top Filter Bar */}\n      <div className=\"bg-white dark:bg-slate-900 p-4 border border-slate-200 dark:border-slate-800 rounded-xl flex flex-col md:flex-row md:items-center justify-between gap-3 shadow-xs\">\n        <div className=\"flex flex-1 items-center gap-3 flex-wrap\">\n          {/* Search */}\n          <div className=\"relative flex-1 min-w-[240px]\">\n            <Search className=\"w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2\" />\n            <input \n              type=\"text\" \n              value={searchTerm}\n              onChange={(e) => setSearchTerm(e.target.value)}\n              placeholder=\"Search Tool or Mapping Profile...\" \n              className=\"w-full pl-9 pr-4 py-2 bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 rounded-lg text-xs text-slate-800 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-colors\"\n            />\n          </div>\n\n          {/* Filter Industry */}\n          <select\n            value={selectedIndustry}\n            onChange={(e) => setSelectedIndustry(e.target.value)}\n            className=\"py-2 px-3 text-xs bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 rounded-lg text-slate-700 dark:text-slate-200 focus:outline-none focus:border-sky-500 cursor-pointer\"\n          >\n            <option value=\"All\">All Industry Types</option>\n            <option value=\"Cement & Building Materials\">Cement & Building Materials</option>\n            <option value=\"Transport\">Transport</option>\n            <option value=\"Automotive\">Automotive</option>\n            <option value=\"Power & Energy\">Power & Energy</option>\n          </select>\n        </div>\n\n        {/* Create Mapping Button */}\n        <button \n          id=\"create-mapping-btn\"\n          onClick={() => {\n            setEditingMapping(null);\n            setIsModalOpen(true);\n          }}\n          className=\"px-4 py-2 bg-[#0B7285] hover:bg-[#095C6B] text-white rounded-lg text-xs font-semibold shadow-xs flex items-center justify-center gap-2 transition-colors shrink-0 cursor-pointer\"\n        >\n          <Plus className=\"w-4 h-4\" />\n          <span>Create Tool Mapping</span>\n        </button>\n      </div>\n\n      {/* Table */}\n      <div className=\"bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-xs overflow-hidden\">\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left text-xs\">\n            <thead className=\"bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 font-semibold text-xs\">\n              <tr>\n                <th className=\"py-3 px-4\">Tool Profile / ID</th>\n                <th className=\"py-3 px-4\">Industry Type</th>\n                <th className=\"py-3 px-4\">Mapped Sensors & Channels</th>\n                <th className=\"py-3 px-4\">Parameters</th>\n                <th className=\"py-3 px-4\">Updated At</th>\n                <th className=\"py-3 px-4 text-center\">Action</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100 dark:divide-slate-800 font-medium text-slate-800 dark:text-slate-200\">\n              {filteredMappings.map((item) => (\n                <tr \n                  key={item.id} \n                  className=\"hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition-colors\"\n                >\n                  <td className=\"py-3.5 px-4\">\n                    <div className=\"font-semibold text-sm text-slate-900 dark:text-white\">\n                      {item.toolName}\n                    </div>\n                    <span className=\"font-mono text-[11px] text-slate-400\">\n                      {item.identifier}\n                    </span>\n                  </td>\n                  <td className=\"py-3.5 px-4 text-slate-600 dark:text-slate-400\">\n                    {item.industryType}\n                  </td>\n                  <td className=\"py-3.5 px-4\">\n                    <div className=\"flex flex-wrap gap-1.5 max-w-sm\">\n                      {item.mappedSensors.map((sensor) => (\n                        <span \n                          key={sensor.id} \n                          className=\"px-2 py-0.5 text-[11px] font-mono rounded bg-sky-50 dark:bg-sky-950/50 text-sky-700 dark:text-sky-300 border border-sky-200 dark:border-sky-800\"\n                          title={`Parameters: ${sensor.parameters.join(\', \')}`}\n                        >\n                          {sensor.name}\n                        </span>\n                      ))}\n                    </div>\n                  </td>\n                  <td className=\"py-3.5 px-4\">\n                    <span className=\"px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-mono font-semibold text-[11px] border border-slate-200 dark:border-slate-700\">\n                      {item.activeParametersCount} Ch\n                    </span>\n                  </td>\n                  <td className=\"py-3.5 px-4 text-slate-500 dark:text-slate-400 font-mono text-[11px]\">\n                    {item.updatedAt}\n                  </td>\n                  <td className=\"py-3.5 px-4\">\n                    <div className=\"flex items-center justify-center gap-2\">\n                      <button\n                        onClick={() => {\n                          setEditingMapping(item);\n                          setIsModalOpen(true);\n                        }}\n                        className=\"p-1.5 rounded-lg border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-400 hover:text-sky-600 hover:border-sky-300 transition-colors\"\n                        title=\"Edit Mapping Configuration\"\n                      >\n                        <Edit3 className=\"w-3.5 h-3.5\" />\n                      </button>\n                    </div>\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n\n        {/* Footer */}\n        <div className=\"px-6 py-3.5 border-t border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/30 flex items-center justify-between text-xs text-slate-600 dark:text-slate-400 font-sans\">\n          <div>Showing <span className=\"font-semibold text-slate-800 dark:text-slate-200\">{filteredMappings.length}</span> Tool Mapping Profiles</div>\n          <div className=\"text-[11px] text-slate-400 font-sans\">\n            Telemetry channels auto-bind upon device registration\n          </div>\n        </div>\n      </div>\n\n      {/* Map Sensors Modal */}\n      <MapSensorsModal \n        isOpen={isModalOpen}\n        onClose={() => {\n          setIsModalOpen(false);\n          setEditingMapping(null);\n        }}\n        onSave={onAddMapping}\n        existingMapping={editingMapping}\n        availableSensors={availableSensors}\n      />\n    </div>\n  );\n};"
    }
    instruction: "Remove protocol filter and column from ToolMappingTable and apply theme styling"
  }
}
