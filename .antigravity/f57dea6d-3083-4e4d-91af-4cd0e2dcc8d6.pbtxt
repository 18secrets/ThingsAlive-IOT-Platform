    instruction: "Apply Artistic Flair styling to DeviceSetup component"
    replacement_infos {
      original_chunk {
        target_content: "      {/* Top Breadcrumb & Action */}\n      <div className=\"flex items-center justify-between\">\n        <button\n          onClick={onBack}\n          className=\"flex items-center gap-2 text-xs font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition-colors\"\n        >\n          <ArrowLeft className=\"w-4 h-4\" />\n          <span>Back to Device Management</span>\n        </button>\n\n        <span className=\"text-xs text-slate-400\">Step 1 of 1 \342\200\242 Device Onboarding</span>\n      </div>\n\n      {/* Main Setup Card matching Image 9 */}\n      <div className=\"bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden\">\n        \n        {/* Card Header with Simplified Setup Badge */}\n        <div className=\"px-8 py-6 border-b border-slate-100 dark:border-slate-700 bg-white dark:bg-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div>\n            <div className=\"flex items-center gap-3\">\n              <h2 className=\"text-lg font-bold text-slate-900 dark:text-white\">\n                Device Information & Tool Mapping\n              </h2>\n              <span className=\"px-3 py-1 rounded-full bg-sky-50 dark:bg-sky-950/80 text-[#0077b6] dark:text-sky-300 font-semibold text-xs border border-sky-200 dark:border-sky-800\">\n                Simplified Setup\n              </span>\n            </div>\n            <p className=\"text-xs text-slate-500 dark:text-slate-400 mt-1\">\n              Register a new telemetry device and automatically bind its sensor configurations via Tool Profile selection.\n            </p>\n          </div>\n\n          <div className=\"w-10 h-10 rounded-xl bg-sky-50 dark:bg-sky-950/60 text-[#0077b6] dark:text-sky-400 flex items-center justify-center shrink-0\">\n            <Cpu className=\"w-5 h-5\" />\n          </div>\n        </div>\n\n        {/* Form Body */}\n        <form onSubmit={handleSubmit} className=\"p-8 space-y-6\">\n          \n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-5 text-xs\">\n            {/* Device Name */}\n            <div>\n              <label className=\"block font-semibold text-slate-700 dark:text-slate-300 mb-1.5\">\n                Device Name <span className=\"text-rose-500\">*</span>\n              </label>\n              <input \n                type=\"text\" \n                required\n                value={deviceName}\n                onChange={(e) => setDeviceName(e.target.value)}\n                placeholder=\"e.g. PowerCommand Cloud Edge 2\" \n                className=\"w-full px-3.5 py-2.5 bg-white dark:bg-slate-700 border border-slate-300 dark:border-slate-600 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600\"\n              />\n            </div>\n\n            {/* IMEI / Hardware Serial */}\n            <div>\n              <label className=\"block font-semibold text-slate-700 dark:text-slate-300 mb-1.5\">\n                IMEI / Hardware Serial Number <span className=\"text-rose-500\">*</span>\n              </label>\n              <input \n                type=\"text\" \n                required\n                value={imei}\n                onChange={(e) => setImei(e.target.value)}\n                placeholder=\"15-digit unique cellular hardware IMEI\" \n                className=\"w-full px-3.5 py-2.5 bg-white dark:bg-slate-700 border border-slate-300 dark:border-slate-600 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 font-mono\"\n              />\n            </div>\n\n            {/* Equipment Association */}\n            <div>\n              <label className=\"block font-semibold text-slate-700 dark:text-slate-300 mb-1.5\">\n                Equipment Assignment\n              </label>\n              <input \n                type=\"text\" \n                value={equipmentName}\n                onChange={(e) => setEquipmentName(e.target.value)}\n                placeholder=\"e.g. Generator 4, Liebherr Crane\" \n                className=\"w-full px-3.5 py-2.5 bg-white dark:bg-slate-700 border border-slate-300 dark:border-slate-600 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600\"\n              />\n            </div>\n\n            {/* Vendor */}\n            <div>\n              <label className=\"block font-semibold text-slate-700 dark:text-slate-300 mb-1.5\">\n                Hardware Vendor Gateway\n              </label>\n              <select\n                value={vendor}\n                onChange={(e) => setVendor(e.target.value)}\n                className=\"w-full px-3.5 py-2.5 bg-white dark:bg-slate-700 border border-slate-300 dark:border-slate-600 rounded-xl text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 cursor-pointer\"\n              >\n                <option value=\"Eicher Motors\">Eicher Motors</option>\n                <option value=\"JCB India\">JCB India</option>\n                <option value=\"Larsen Engineering\">Larsen Engineering</option>\n                <option value=\"Tata Hitachi\">Tata Hitachi</option>\n                <option value=\"Durr pvt lts\">Durr pvt lts</option>\n                <option value=\"BEML\">BEML</option>\n              </select>\n            </div>\n          </div>\n\n          {/* Mapping Sensor Tool Selection Dropdown */}\n          <div className=\"pt-2 text-xs\">\n            <label className=\"block font-semibold text-slate-700 dark:text-slate-300 mb-1.5\">\n              Mapping Sensor Tool Selection <span className=\"text-rose-500\">*</span>\n            </label>\n            <select\n              value={selectedToolId}\n              onChange={(e) => setSelectedToolId(e.target.value)}\n              className=\"w-full px-4 py-3 bg-white dark:bg-slate-700 border border-slate-300 dark:border-slate-600 rounded-xl text-slate-900 dark:text-white font-medium focus:outline-none focus:ring-2 focus:ring-sky-500/20 focus:border-sky-600 cursor-pointer\"\n            >\n              {toolMappings.map((tool) => (\n                <option key={tool.id} value={tool.id}>\n                  {tool.toolName} ({tool.identifier}) \342\200\224 {tool.industryType} [{tool.protocol}]\n                </option>\n              ))}\n            </select>\n            <p className=\"text-[11px] text-slate-400 mt-1\">\n              Selecting this profile automatically generates sensor telemetry routes and parameter scaling.\n            </p>\n          </div>\n\n          {/* Auto-Mapped Sensors & Parameters Interactive Card matching Image 9 */}\n          {selectedTool && (\n            <div className=\"p-5 rounded-2xl bg-slate-50 dark:bg-slate-700/40 border border-slate-200 dark:border-slate-600 space-y-4\">\n              <div className=\"flex items-center justify-between\">\n                <div className=\"flex items-center gap-2 text-slate-800 dark:text-white font-bold text-xs\">\n                  <Activity className=\"w-4 h-4 text-sky-600 dark:text-sky-400\" />\n                  <span>Auto-Mapped Sensors & Parameters</span>\n                </div>\n                <span className=\"px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-300 text-[11px] font-bold border border-emerald-200 dark:border-emerald-800\">\n                  {selectedTool.mappedSensors.length} Sensors & {selectedTool.activeParametersCount} Parameters Mapped\n                </span>\n              </div>\n\n              {/* Grid of Mapped Sensor Cards */}\n              <div className=\"grid grid-cols-1 md:grid-cols-3 gap-3\">\n                {selectedTool.mappedSensors.map((sensor, idx) => (\n                  <div \n                    key={idx} \n                    className=\"p-3.5 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 space-y-2 text-xs\"\n                  >\n                    <div className=\"flex items-center justify-between\">\n                      <span className=\"font-semibold text-slate-800 dark:text-white truncate\" title={sensor.name}>\n                        {sensor.name}\n                      </span>\n                      <span className=\"font-mono text-[10px] text-sky-600 dark:text-sky-400 bg-sky-50 dark:bg-sky-950 px-1.5 py-0.5 rounded\">\n                        CH-0{idx + 1}\n                      </span>\n                    </div>\n\n                    <div className=\"space-y-1\">\n                      {sensor.parameters.map((param, pIdx) => (\n                        <div key={pIdx} className=\"flex items-center gap-1.5 text-[11px] text-slate-600 dark:text-slate-300\">\n                          <Check className=\"w-3 h-3 text-emerald-500 shrink-0\" />\n                          <span className=\"truncate\">{param}</span>\n                        </div>\n                      ))}\n                    </div>\n                  </div>\n                ))}\n              </div>\n\n              {/* Protocol Banner */}\n              <div className=\"p-3 rounded-xl bg-sky-50 dark:bg-sky-950/50 border border-sky-100 dark:border-sky-900/60 flex items-center justify-between text-xs text-sky-800 dark:text-sky-300\">\n                <span className=\"flex items-center gap-1.5\">\n                  <Radio className=\"w-3.5 h-3.5\" />\n                  Protocol: <strong className=\"font-mono\">{selectedTool.protocol}</strong>\n                </span>\n                <span>Sampling: 1 Hz Real-time</span>\n              </div>\n            </div>\n          )}\n\n          {/* Action Buttons */}\n          <div className=\"pt-4 border-t border-slate-100 dark:border-slate-700 flex items-center justify-end gap-3\">\n            <button\n              type=\"button\"\n              onClick={onBack}\n              className=\"px-5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-700 dark:text-slate-200 text-xs font-semibold hover:bg-slate-50 dark:hover:bg-slate-600 transition-colors\"\n            >\n              Cancel\n            </button>\n            <button\n              type=\"submit\"\n              className=\"px-6 py-2.5 rounded-xl bg-[#0077b6] hover:bg-[#023e8a] active:bg-[#03045e] text-white text-xs font-semibold shadow-xs flex items-center gap-2 transition-colors\"\n            >\n              <span>Create Device</span>\n              <ArrowRight className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n\n        </form>\n\n      </div>"
        replacement_content: "      {/* Top Breadcrumb & Action */}\n      <div className=\"flex items-center justify-between\">\n        <button\n          onClick={onBack}\n          className=\"flex items-center gap-2 text-xs font-sans uppercase tracking-[0.14em] font-bold text-[#121212] hover:text-[#FF4D00] dark:text-[#FDFCF5] dark:hover:text-[#FF4D00] transition-colors cursor-pointer\"\n        >\n          <ArrowLeft className=\"w-4 h-4\" />\n          <span>Back to Device Management</span>\n        </button>\n\n        <span className=\"text-[11px] font-mono text-[#121212]/50 dark:text-[#FDFCF5]/50 uppercase\">Step 1 of 1 \342\200\242 Onboarding</span>\n      </div>\n\n      {/* Main Setup Card matching Image 9 */}\n      <div className=\"bg-[#FFFFFF] dark:bg-[#1A1918] border border-[#121212]/15 dark:border-white/15 shadow-xs overflow-hidden\">\n        \n        {/* Card Header with Simplified Setup Badge */}\n        <div className=\"px-8 py-6 border-b border-[#121212]/10 dark:border-white/10 bg-[#FAF9F2] dark:bg-[#151514] flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n          <div>\n            <div className=\"flex items-center gap-3\">\n              <h2 className=\"text-xl font-serif font-bold text-[#121212] dark:text-[#FDFCF5]\">\n                Device Information & Tool Mapping\n              </h2>\n              <span className=\"px-2.5 py-0.5 bg-[#FF4D00]/10 text-[#FF4D00] font-mono font-bold text-[10px] uppercase border border-[#FF4D00]/30\">\n                Simplified Setup\n              </span>\n            </div>\n            <p className=\"text-xs text-[#121212]/60 dark:text-[#FDFCF5]/60 mt-1 font-sans\">\n              Register a new telemetry device and automatically bind its sensor configurations via Tool Profile selection.\n            </p>\n          </div>\n\n          <div className=\"w-10 h-10 border border-[#121212]/15 dark:border-white/15 bg-[#F4F2EA] dark:bg-stone-800 text-[#121212] dark:text-[#FDFCF5] flex items-center justify-center shrink-0\">\n            <Cpu className=\"w-5 h-5\" />\n          </div>\n        </div>\n\n        {/* Form Body */}\n        <form onSubmit={handleSubmit} className=\"p-8 space-y-6\">\n          \n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-5 text-xs\">\n            {/* Device Name */}\n            <div>\n              <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70 mb-1.5\">\n                Device Name <span className=\"text-[#FF4D00]\">*</span>\n              </label>\n              <input \n                type=\"text\" \n                required\n                value={deviceName}\n                onChange={(e) => setDeviceName(e.target.value)}\n                placeholder=\"e.g. PowerCommand Cloud Edge 2\" \n                className=\"w-full px-3.5 py-2.5 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] placeholder-[#121212]/40 dark:placeholder-[#FDFCF5]/40 focus:outline-none focus:border-[#FF4D00] focus:ring-1 focus:ring-[#FF4D00] transition-colors\"\n              />\n            </div>\n\n            {/* IMEI / Hardware Serial */}\n            <div>\n              <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70 mb-1.5\">\n                IMEI / Hardware Serial Number <span className=\"text-[#FF4D00]\">*</span>\n              </label>\n              <input \n                type=\"text\" \n                required\n                value={imei}\n                onChange={(e) => setImei(e.target.value)}\n                placeholder=\"15-digit unique cellular hardware IMEI\" \n                className=\"w-full px-3.5 py-2.5 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] placeholder-[#121212]/40 dark:placeholder-[#FDFCF5]/40 focus:outline-none focus:border-[#FF4D00] focus:ring-1 focus:ring-[#FF4D00] transition-colors font-mono\"\n              />\n            </div>\n\n            {/* Equipment Association */}\n            <div>\n              <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70 mb-1.5\">\n                Equipment Assignment\n              </label>\n              <input \n                type=\"text\" \n                value={equipmentName}\n                onChange={(e) => setEquipmentName(e.target.value)}\n                placeholder=\"e.g. Generator 4, Liebherr Crane\" \n                className=\"w-full px-3.5 py-2.5 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] placeholder-[#121212]/40 dark:placeholder-[#FDFCF5]/40 focus:outline-none focus:border-[#FF4D00] focus:ring-1 focus:ring-[#FF4D00] transition-colors\"\n              />\n            </div>\n\n            {/* Vendor */}\n            <div>\n              <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70 mb-1.5\">\n                Hardware Vendor Gateway\n              </label>\n              <select\n                value={vendor}\n                onChange={(e) => setVendor(e.target.value)}\n                className=\"w-full px-3.5 py-2.5 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] focus:outline-none focus:border-[#FF4D00] cursor-pointer\"\n              >\n                <option value=\"Eicher Motors\">Eicher Motors</option>\n                <option value=\"JCB India\">JCB India</option>\n                <option value=\"Larsen Engineering\">Larsen Engineering</option>\n                <option value=\"Tata Hitachi\">Tata Hitachi</option>\n                <option value=\"Durr pvt lts\">Durr pvt lts</option>\n                <option value=\"BEML\">BEML</option>\n              </select>\n            </div>\n          </div>\n\n          {/* Mapping Sensor Tool Selection Dropdown */}\n          <div className=\"pt-2 text-xs\">\n            <label className=\"block text-[10px] font-sans uppercase tracking-[0.14em] font-bold text-[#121212]/70 dark:text-[#FDFCF5]/70 mb-1.5\">\n              Mapping Sensor Tool Selection <span className=\"text-[#FF4D00]\">*</span>\n            </label>\n            <select\n              value={selectedToolId}\n              onChange={(e) => setSelectedToolId(e.target.value)}\n              className=\"w-full px-4 py-3 bg-[#FDFCF5] dark:bg-[#121212] border border-[#121212]/20 dark:border-white/20 text-[#121212] dark:text-[#FDFCF5] font-serif text-sm focus:outline-none focus:border-[#FF4D00] cursor-pointer\"\n            >\n              {toolMappings.map((tool) => (\n                <option key={tool.id} value={tool.id}>\n                  {tool.toolName} ({tool.identifier}) \342\200\224 {tool.industryType} [{tool.protocol}]\n                </option>\n              ))}\n            </select>\n            <p className=\"text-[11px] text-[#121212]/50 dark:text-[#FDFCF5]/50 mt-1 font-mono\">\n              Selecting this profile automatically generates sensor telemetry routes and parameter scaling.\n            </p>\n          </div>\n\n          {/* Auto-Mapped Sensors & Parameters Interactive Card matching Image 9 */}\n          {selectedTool && (\n            <div className=\"p-5 bg-[#FAF9F2] dark:bg-[#151514] border border-[#121212]/15 dark:border-white/15 space-y-4\">\n              <div className=\"flex items-center justify-between\">\n                <div className=\"flex items-center gap-2 text-[#121212] dark:text-[#FDFCF5] font-serif font-bold text-sm\">\n                  <Activity className=\"w-4 h-4 text-[#FF4D00]\" />\n                  <span>Auto-Mapped Sensors & Parameters</span>\n                </div>\n                <span className=\"px-2.5 py-0.5 bg-[#F4F2EA] dark:bg-stone-800 text-[#121212] dark:text-[#FDFCF5] text-[10px] font-mono uppercase font-bold border border-[#121212]/20 dark:border-white/20\">\n                  {selectedTool.mappedSensors.length} Sensors & {selectedTool.activeParametersCount} Parameters Mapped\n                </span>\n              </div>\n\n              {/* Grid of Mapped Sensor Cards */}\n              <div className=\"grid grid-cols-1 md:grid-cols-3 gap-3\">\n                {selectedTool.mappedSensors.map((sensor, idx) => (\n                  <div \n                    key={idx} \n                    className=\"p-3.5 bg-[#FFFFFF] dark:bg-[#1A1918] border border-[#121212]/15 dark:border-white/15 space-y-2 text-xs\"\n                  >\n                    <div className=\"flex items-center justify-between\">\n                      <span className=\"font-serif font-bold text-[#121212] dark:text-[#FDFCF5] truncate\" title={sensor.name}>\n                        {sensor.name}\n                      </span>\n                      <span className=\"font-mono text-[10px] text-[#FF4D00] bg-[#FF4D00]/10 px-1.5 py-0.5 border border-[#FF4D00]/20\">\n                        CH-0{idx + 1}\n                      </span>\n                    </div>\n\n                    <div className=\"space-y-1\">\n                      {sensor.parameters.map((param, pIdx) => (\n                        <div key={pIdx} className=\"flex items-center gap-1.5 text-[11px] text-[#121212]/70 dark:text-[#FDFCF5]/70 font-mono\">\n                          <Check className=\"w-3 h-3 text-[#FF4D00] shrink-0\" />\n                          <span className=\"truncate\">{param}</span>\n                        </div>\n                      ))}\n                    </div>\n                  </div>\n                ))}\n              </div>\n\n              {/* Protocol Banner */}\n              <div className=\"p-3 bg-[#F4F2EA] dark:bg-stone-800 border border-[#121212]/15 dark:border-white/15 flex items-center justify-between text-xs text-[#121212] dark:text-[#FDFCF5] font-mono text-[11px]\">\n                <span className=\"flex items-center gap-1.5\">\n                  <Radio className=\"w-3.5 h-3.5 text-[#FF4D00]\" />\n                  Protocol: <strong className=\"font-bold\">{selectedTool.protocol}</strong>\n                </span>\n                <span>Sampling: 1 Hz Real-time</span>\n              </div>\n            </div>\n          )}\n\n          {/* Action Buttons */}\n          <div className=\"pt-4 border-t border-[#121212]/10 dark:border-white/10 flex items-center justify-end gap-3\">\n            <button\n              type=\"button\"\n              onClick={onBack}\n              className=\"px-5 py-2.5 border border-[#121212]/20 dark:border-white/20 bg-transparent text-[#121212] dark:text-[#FDFCF5] text-xs font-sans uppercase tracking-[0.14em] font-bold hover:bg-[#F4F2EA] dark:hover:bg-stone-800 transition-colors cursor-pointer\"\n            >\n              Cancel\n            </button>\n            <button\n              type=\"submit\"\n              className=\"px-6 py-2.5 bg-[#121212] text-[#FDFCF5] hover:bg-[#FF4D00] hover:text-white dark:bg-[#FDFCF5] dark:text-[#121212] dark:hover:bg-[#FF4D00] dark:hover:text-white border border-[#121212] dark:border-white text-xs font-sans uppercase tracking-[0.14em] font-bold shadow-xs flex items-center gap-2 transition-colors cursor-pointer\"\n            >\n              <span>Create Device</span>\n              <ArrowRight className=\"w-3.5 h-3.5\" />\n            </button>\n          </div>\n\n        </form>\n\n      </div>"
      }
      num_matches: 1
    }
  }
}
