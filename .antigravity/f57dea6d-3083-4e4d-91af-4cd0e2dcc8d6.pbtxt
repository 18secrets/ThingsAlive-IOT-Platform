  file_change {
    absolute_path_uri: "file:///src/components/Sidebar.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { \n  Home, \n  AlertTriangle, \n  Bell, \n  UserCheck, \n  Cpu, \n  Globe, \n  Users, \n  Wrench, \n  ShieldCheck, \n  ClipboardList, \n  Settings \n} from \'lucide-react\';\nimport { NavigationTab } from \'../types\';\n\ninterface SidebarProps {\n  currentTab: NavigationTab;\n  onSelectTab: (tab: NavigationTab) => void;\n}\n\nexport const Sidebar: React.FC<SidebarProps> = ({ currentTab, onSelectTab }) => {\n  const navItems: { id: NavigationTab; label: string; icon: React.FC<{ className?: string }> }[] = [\n    { id: \'dashboard\', label: \'Dashboard\', icon: Home },\n    { id: \'alert-rules\', label: \'Alert Rules\', icon: AlertTriangle },\n    { id: \'alert-agent\', label: \'Alert Agent\', icon: Bell },\n    { id: \'admin\', label: \'Admin\', icon: UserCheck },\n    { id: \'devices\', label: \'Devices\', icon: Cpu },\n    { id: \'vendors\', label: \'Vendors\', icon: Globe },\n    { id: \'users\', label: \'Users\', icon: Users },\n    { id: \'equipment\', label: \'Equipment\', icon: Wrench },\n    { id: \'administrator\', label: \'Administrator\', icon: ShieldCheck },\n    { id: \'diagnostics\', label: \'Diagnostics\', icon: ClipboardList },\n    { id: \'settings\', label: \'Settings\', icon: Settings },\n  ];\n\n  return (\n    <aside \n      id=\"main-navigation-sidebar\"\n      className=\"w-64 bg-white dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 flex flex-col justify-between shrink-0 select-none z-20 transition-colors\"\n      data-purpose=\"main-navigation-sidebar\"\n    >\n      <div>\n        {/* Brand Logo Header */}\n        <div className=\"h-16 flex items-center px-6 gap-2.5 border-b border-slate-100 dark:border-slate-800\">\n          {/* ThingsAlive Atom / Node Flower Logo Icon */}\n          <div className=\"relative flex items-center justify-center\">\n            <svg \n              className=\"w-7 h-7 text-[#0096c7]\" \n              viewBox=\"0 0 32 32\" \n              fill=\"none\" \n              xmlns=\"http://www.w3.org/2000/svg\"\n            >\n              <circle cx=\"16\" cy=\"16\" r=\"3.5\" fill=\"#0077b6\" />\n              <circle cx=\"16\" cy=\"6\" r=\"2.8\" fill=\"#00b4d8\" />\n              <circle cx=\"16\" cy=\"26\" r=\"2.8\" fill=\"#00b4d8\" />\n              <circle cx=\"6\" cy=\"16\" r=\"2.8\" fill=\"#00b4d8\" />\n              <circle cx=\"26\" cy=\"16\" r=\"2.8\" fill=\"#00b4d8\" />\n              <circle cx=\"8.9\" cy=\"8.9\" r=\"2.2\" fill=\"#48cae4\" />\n              <circle cx=\"23.1\" cy=\"23.1\" r=\"2.2\" fill=\"#48cae4\" />\n              <circle cx=\"8.9\" cy=\"23.1\" r=\"2.2\" fill=\"#48cae4\" />\n              <circle cx=\"23.1\" cy=\"8.9\" r=\"2.2\" fill=\"#48cae4\" />\n              <path \n                d=\"M16 8.8V13.2M16 18.8V23.2M8.8 16H13.2M18.8 16H23.2M10.8 10.8L13.8 13.8M18.2 18.2L21.2 21.2M10.8 21.2L13.8 18.2M18.2 13.8L21.2 10.8\" \n                stroke=\"#0096c7\" \n                strokeWidth=\"1.2\" \n                strokeLinecap=\"round\" \n              />\n            </svg>\n          </div>\n          <div className=\"flex flex-col\">\n            <span className=\"text-xl font-bold tracking-tight text-[#1a2d42] dark:text-white leading-tight\">\n              Things<span className=\"text-[#0077b6] dark:text-sky-400\">Alive</span>\n            </span>\n            <span className=\"text-[9px] text-slate-400 dark:text-slate-500 font-semibold tracking-wider uppercase -mt-0.5\">\n              TELEMATICS IOT OS\n            </span>\n          </div>\n        </div>\n\n        {/* Navigation Links */}\n        <nav className=\"p-3 space-y-1 text-sm font-medium\">\n          {navItems.map((item) => {\n            const Icon = item.icon;\n            const isActive = currentTab === item.id;\n            return (\n              <button\n                key={item.id}\n                id={`nav-${item.id}`}\n                onClick={() => onSelectTab(item.id)}\n                className={`w-full flex items-center gap-3 px-3.5 py-2.5 rounded-lg text-sm transition-all text-left ${\n                  isActive\n                    ? \'bg-[#e0f2fe] dark:bg-sky-950/60 text-[#0284c7] dark:text-sky-300 font-semibold border-l-4 border-[#0284c7] -ml-1 pl-4.5 shadow-xs\'\n                    : \'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-slate-100\'\n                }`}\n              >\n                <Icon \n                  className={`w-4.5 h-4.5 shrink-0 ${\n                    isActive ? \'text-[#0284c7] dark:text-sky-400\' : \'text-slate-400 dark:text-slate-500\'\n                  }`} \n                />\n                <span>{item.label}</span>\n              </button>\n            );\n          })}\n        </nav>\n      </div>\n\n      {/* Version Footer */}\n      <div className=\"px-6 py-4 border-t border-slate-100 dark:border-slate-800 text-xs text-slate-400 dark:text-slate-500 font-medium flex items-center justify-between\">\n        <span>Version: 1.0.5</span>\n        <span className=\"inline-block w-2 h-2 rounded-full bg-emerald-500 ring-4 ring-emerald-100 dark:ring-emerald-950/60\" title=\"System Normal\"></span>\n      </div>\n    </aside>\n  );\n};\n"
    }
