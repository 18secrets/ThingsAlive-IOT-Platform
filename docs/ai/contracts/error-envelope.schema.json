{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://things-alive.io/schemas/error-envelope.json",
  "title": "Error envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message", "request_id", "retryable"],
  "properties": {
    "code": { "type": "string" },
    "message": { "type": "string" },
    "field_path": { "type": ["string", "null"] },
    "request_id": { "type": "string", "format": "uuid" },
    "retryable": { "type": "boolean" },
    "details": {
      "type": "object",
      "description": "Never reveals another tenant's data."
    }
  }
}
