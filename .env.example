# Things Alive IoT Platform 2.0 — configuration template.
# Copy to .env locally. Never commit a filled-in copy: every value here is a secret.

NODE_ENV=development
PORT=8080

# Comma-separated. No wildcard fallback exists — an unlisted origin is refused.
CORS_ORIGINS=http://localhost:3000

# Verification of the token issued by the existing platform. 2.0 stores no passwords.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=things-alive-platform
# Claim carrying the tenant. A token without it is rejected.
AUTH_TENANT_CLAIM=client_id

# Database. TLS is required anywhere the database is not on the same private network.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=Test@123
DB_DATABASE=ta2
DB_SSL=false

# The unprivileged role every request-scoped session runs as. Created by the RLS
# migration; migrations themselves run as DB_USERNAME, which must own the schema.
# Leave this alone unless the role was renamed: the service refuses to connect if it
# does not exist, which is deliberate — falling back to the login user would disable
# row-level security silently, and a managed Postgres hands out a superuser.
DB_APP_ROLE=ta_app

# ---------------------------------------------------------------------------
# The existing platform, read-only.
#
# 2.0 never writes here. The connection is opened with
# `default_transaction_read_only=on`, so Postgres refuses a write whatever the code
# asks for — the guarantee is a property of the connection rather than of anybody's
# care. Leave these unset and telemetry is simply not pulled: the shift runner says so
# loudly every pass and nothing is lost, because every window stays owed.
LEGACY_DB_HOST=
LEGACY_DB_PORT=5432
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
LEGACY_DB_DATABASE=
LEGACY_DB_SCHEMA=public
LEGACY_DB_SSL=true

# Mirror 1.0's machines, loggers and sensor map into the projections (QSYNC1). A full
# reconcile each pass, through the same read-only connection. True on the scheduler
# service only; daily is enough for things that change on the scale of days.
LEGACY_FLEET_SYNC_ENABLED=false
LEGACY_FLEET_SYNC_TICK_SECONDS=86400

# ---------------------------------------------------------------------------
# The scheduled scoring pass.
#
# True on exactly one service. The pass takes an advisory lock so a second instance is
# harmless, but it would double the work and halve the sense the logs make at the
# moment somebody is reading them to find out why a machine was not scored. On Railway
# that means the `scheduler` service sets this and the `api` service does not.
SHIFT_RUNNER_ENABLED=false
SHIFT_RUNNER_TICK_SECONDS=300

# Outgoing email (forgot-password links). Unset MAIL_PROVIDER sends nothing and logs
# which variables are missing. resend / sendgrid take MAIL_API_KEY; smtp takes the
# mailbox below. For smtp, MAIL_FROM defaults to SMTP_USERNAME — Microsoft 365 refuses
# any other sender unless the mailbox has send-as on it.
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Where links in emails point. Defaults to the first CORS_ORIGINS entry.
APP_PUBLIC_URL=

# Object storage for class visuals and the 3-D twin: any S3 API. Today this is IoT
# Platform 1.0's Utho bucket, shared under ASSET_S3_KEY_PREFIX so 2.0 never writes
# beside 1.0's database backups (D44). Unset, visuals read assets_unavailable and
# nothing else is affected. Leave ASSET_S3_PUBLIC_BASE_URL unset to serve short-lived
# signed URLs from a private bucket.
ASSET_S3_ENDPOINT=
ASSET_S3_BUCKET=
ASSET_S3_ACCESS_KEY_ID=
ASSET_S3_SECRET_ACCESS_KEY=
ASSET_S3_REGION=auto
ASSET_S3_KEY_PREFIX=
ASSET_S3_PUBLIC_BASE_URL=

# The assistant (Ask AI, onboarding chat): Gemini, by API key or on Vertex AI. With
# ASSISTANT_MODEL unset, or neither route configured, the chat answers 503
# assistant_not_configured and nothing else is affected. Vertex wins when both are set.
ASSISTANT_MODEL=
ASSISTANT_GEMINI_API_KEY=
ASSISTANT_VERTEX_PROJECT=
ASSISTANT_VERTEX_LOCATION=
# A service-account key as one line of JSON. Unset uses application default credentials.
ASSISTANT_VERTEX_CREDENTIALS_JSON=
# Tokens per account per UTC day.
ASSISTANT_DAILY_TOKEN_LIMIT=200000

# Library search (QEMB1, D47): where the bge-small files are. The api image bakes them
# at /app/models, the default; nothing needs setting there. Without them, search and
# reindex answer 503 embedding_not_configured. A developer fills a directory with
# `node scripts/embedding/fetch-model.js <dir>`.
EMBEDDING_MODEL_DIR=

# Escalation emails (QNOTIFY1): drains the outbox's incident.escalated.v1 events and
# emails the owner / whoever can assign work. True on the scheduler service only,
# beside INCIDENT_ESCALATION_ENABLED; needs MAIL_PROVIDER and APP_PUBLIC_URL to send.
INCIDENT_NOTIFY_ENABLED=false
INCIDENT_NOTIFY_TICK_SECONDS=30

# Forecasting (QML1, D46). Off unless FORECAST_ENABLED=true, and only on the scheduler
# service, whose image (Dockerfile.scheduler) carries Python, torch and the TTM weights.
# Each tick runs `node dist/forecast-main.js --once` as a child process.
FORECAST_ENABLED=false
FORECAST_TICK_SECONDS=300
# Set by Dockerfile.scheduler; override only to point at another worker.
FORECAST_PYTHON=
FORECAST_WORKER_SCRIPT=
