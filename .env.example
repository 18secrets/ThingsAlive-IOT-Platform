# Things Alive IoT Platform 2.0 — configuration template.
# Copy to .env locally. Never commit a filled-in copy: every value here is a secret.

NODE_ENV=development
PORT=8080

# Comma-separated. No wildcard fallback exists — an unlisted origin is refused.
CORS_ORIGINS=http://localhost:3000

# Verification of the token issued by the existing platform. 2.0 stores no passwords.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=things-alive-platform
# Claim carrying the tenant. A token without it is rejected.
AUTH_TENANT_CLAIM=client_id
